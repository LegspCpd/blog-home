---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { commentConfig } from "@/config/commentConfig";
import Key from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { removeFileExtension } from "@/utils/url-utils";
import Artalk from "./Artalk.astro";
import Disqus from "./Disqus.astro";
import Giscus from "./Giscus.astro";
import Twikoo from "./Twikoo.astro";
import Waline from "./Waline.astro";

interface Props {
	post?: CollectionEntry<"posts"> | CollectionEntry<"spec">;
	customPath?: string;
	title?: string;
}

const { post, customPath, title: customTitle } = Astro.props as Props;

// 根据页面类型确定路径
const slugFromPath = (customPath || "/").replace(/^\/+|\/+$/g, "") || "index";
const slug = post ? removeFileExtension(post.id) : slugFromPath;
const path = customPath
	? customPath
	: post
		? post.collection === "posts"
			? `/posts/${slug}`
			: `/${slug}`
		: `/${slug}`;
const url = `${Astro.site?.href}${path}`;
const postTitle = post && "title" in post.data ? post.data.title : undefined;

// 强制 commentService 类型为 string，避免类型不兼容警告
const commentService: string = commentConfig?.type || "none";
---

{
	commentService !== "none" ? (
		<section class="cmt" aria-label={i18n(Key.commentSection)}>
			<header class="cmt-head">
				<h2 class="su-heading-lg cmt-title">{i18n(Key.commentSection)}</h2>
				<p class="su-caption su-text-mute">{i18n(Key.commentSubtitle)}</p>
			</header>

			<div class="cmt-body">
				{commentService === "twikoo" && <Twikoo path={path} />}
				{commentService === "waline" && <Waline path={path} />}
				{commentService === "giscus" && <Giscus />}
				{commentService === "disqus" && (
					<Disqus
						identifier={slug}
						url={url}
						title={customTitle || postTitle || slug}
					/>
				)}
				{commentService === "artalk" && <Artalk path={path} />}
			</div>
		</section>
	) : (
		<section class="cmt cmt--empty">
			<span class="cmt-empty-icon" aria-hidden="true">
				<Icon name="material-symbols:chat-bubble-outline" />
			</span>
			<h2 class="su-heading-md">{i18n(Key.commentNotConfigured)}</h2>
			<p class="su-caption su-text-mute">{i18n(Key.guestbookCommentHint)}</p>
		</section>
	)
}

<style>
	.cmt {
		max-width: var(--su-content-max);
		margin-inline: auto;
		padding-top: 40px;
		margin-top: 8px;
		border-top: 1px solid var(--su-border);
	}

	.cmt-head {
		margin-bottom: 24px;
	}

	.cmt-title {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	/* 用一小段翠绿竖条做视觉锚点，比图标更克制 */
	.cmt-title::before {
		content: "";
		display: inline-block;
		width: 3px;
		height: 1em;
		border-radius: var(--su-radius-full);
		background-color: var(--su-primary);
	}

	.cmt-body {
		/* 第三方评论组件自带主题，这里只保证不撑破容器 */
		min-width: 0;
		overflow-x: clip;
	}

	/* ---- 未配置评论 ---- */
	.cmt--empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		text-align: center;
	}

	.cmt-empty-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		border: 1px solid var(--su-border);
		border-radius: var(--su-radius-full);
		background-color: var(--su-muted);
		font-size: 22px;
		color: var(--su-muted-foreground);
	}

	@media (max-width: 640px) {
		.cmt {
			padding-top: 32px;
		}
		/* 窄屏下收紧内边距，给评论内容更多宽度 */
		.cmt-body {
			margin-inline: -4px;
		}
	}
</style>