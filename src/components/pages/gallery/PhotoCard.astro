---
interface Props {
	src: string;
	albumId: string;
	alt?: string;
}

const { src, albumId, alt = "" } = Astro.props;
---

<div class="gallery-photo-card">
	<div
		data-fancybox={`gallery-${albumId}`}
		data-src={src}
		data-type="image"
		class="photo-frame"
	>
		<img
			src={src}
			alt={alt}
			loading="lazy"
			decoding="async"
		/>
	</div>
</div>

<style>
	.gallery-photo-card {
		break-inside: avoid;
		margin-bottom: 12px;
	}

	/* 1px hairline + 12px 圆角，与相册卡片保持一致 */
	.photo-frame {
		display: block;
		border: 1px solid var(--su-border);
		border-radius: var(--su-radius-lg);
		overflow: hidden;
		background-color: var(--su-muted);
		cursor: zoom-in;
		transition: border-color 0.15s ease;
	}

	.photo-frame:hover {
		border-color: var(--su-hairline-strong, var(--su-border));
	}

	.photo-frame img {
		display: block;
		width: 100%;
		height: auto;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.photo-frame:hover img {
		transform: scale(1.03);
	}
</style>