---
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	id: string;
	name: string;
	cover: string;
	description?: string;
	date?: string;
	location?: string;
	tags?: string[];
	photoCount: number;
}

const { id, name, cover, description, date, location, tags, photoCount } =
	Astro.props;
---

<a
	href={`/gallery/${id}/`}
	data-tags={tags?.join(",") || ""}
	class="album-card su-card su-card--hover"
>
	<!-- 封面 -->
	<div class="album-cover">
		{
			cover ? (
				<img
					src={cover}
					alt={name}
					loading="lazy"
					decoding="async"
				/>
			) : (
				<span class="album-fallback" aria-hidden="true">
					&#x1f4f7;
				</span>
			)
		}

		<!-- 照片数徽标 -->
		<span class="album-count">
			{photoCount} {i18n(I18nKey.galleryPhotos)}
		</span>

		<!-- 渐变遮罩 + 信息 -->
		<span class="album-info">
			<span class="album-name">{name}</span>

			{description ? (
				<span class="album-desc" title={description}>
					{description}
				</span>
			) : null}

			{date || location ? (
				<span class="album-meta">
					{date ? <span>{date}</span> : null}
					{location ? <span>{location}</span> : null}
				</span>
			) : null}
		</span>
	</div>
</a>

<style>
	.album-card {
		display: block;
		height: 100%;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
	}

	.album-cover {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background-color: var(--su-muted);
	}

	.album-cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.4s ease;
	}

	.album-card:hover .album-cover img {
		transform: scale(1.04);
	}

	.album-fallback {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		font-size: 40px;
		color: var(--su-ink-faint);
	}

	/* 照片数：右上角小徽标 */
	.album-count {
		position: absolute;
		top: 8px;
		right: 8px;
		padding: 2px 8px;
		border-radius: var(--su-radius-full);
		background-color: rgba(0, 0, 0, 0.55);
		color: #ffffff;
		font-size: 11px;
		font-variant-numeric: tabular-nums;
		backdrop-filter: blur(4px);
	}

	/* 信息区：底部渐变，保证白字可读 */
	.album-info {
		position: absolute;
		inset: auto 0 0 0;
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 16px;
		background: linear-gradient(
			to top,
			rgba(0, 0, 0, 0.78),
			rgba(0, 0, 0, 0.35) 55%,
			transparent
		);
	}

	.album-name {
		font-size: 16px;
		font-weight: 500;
		line-height: 1.3;
		color: #ffffff;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.album-desc {
		font-size: 12px;
		line-height: 1.4;
		color: rgba(255, 255, 255, 0.78);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.album-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		font-size: 11px;
		color: rgba(255, 255, 255, 0.7);
	}
</style>