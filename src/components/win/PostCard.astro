---
import type { CollectionEntry } from "astro:content";

/**
 * 文章卡片 —— WinUI 3 的 Card 外观
 *
 * 与上一版的区别都在"这是谁的语言"上：
 * · 圆角 8px（OverlayCornerRadius），不是 26px 的 hero 半径
 * · 表面用 LayerFillColorDefault 半透明白叠加，不是自定的近黑色
 * · 描边是 1px 半透明白（CardStrokeColorDefault），hover 只提亮表面与描边
 * · 去掉了情绪色光晕和图片缩放 —— WinUI 的卡片不做这些
 * · 字阶回到 Segoe UI Variable 的 Title 20 / Body 14
 *
 * 保留 hero 开关：首篇仍是横向大卡，但用的是同一套 Fluent 表面，
 * 只是排布不同，不再靠"超大圆角"制造对比。
 */
interface Props {
  post: CollectionEntry<"posts">;
  slug: string;
  hero?: boolean;
}

const { post, slug, hero = false } = Astro.props;
const { data } = post;

const dateFmt = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});

const href = `/posts/${slug}/`;
---

<article class={`card${hero ? " card-hero" : ""}`}>
  <a class="hit" href={href}>
    <span class="sr">{data.title}</span>
  </a>

  {
    data.image && (
      <div class="cover">
        <img src={data.image} alt="" loading="lazy" decoding="async" />
      </div>
    )
  }

  <div class="body">
    <div class="meta">
      <span class="category">{data.category ?? "随笔"}</span>
      <time datetime={data.published.toISOString()}>
        {dateFmt.format(data.published)}
      </time>
      {
        data.updated && data.updated.getTime() !== data.published.getTime() && (
          <span class="edited">改于 {dateFmt.format(data.updated)}</span>
        )
      }
    </div>

    <h2 class="title">{data.title}</h2>
    {data.description && <p class="desc">{data.description}</p>}

    {
      data.tags.length > 0 && (
        <ul class="tags">
          {data.tags.slice(0, hero ? 5 : 3).map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )
    }

    <span class="more" aria-hidden="true">
      阅读全文
      <span class="arrow">&#xE76C;</span>
    </span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line-base);
    border-radius: var(--r-md);
    background: var(--c-s1);
    transition:
      background var(--m-quick),
      border-color var(--m-quick);
  }

  /* WinUI 的 hover 是"叠一层 SubtleFill"，不是位移或发光 */
  .card:hover {
    background: var(--c-s2);
    border-color: var(--line-strong);
  }

  /* 整卡可点：铺一层覆盖而不是把内容包进 <a>，
     这样 h2 / time / 标签在语义上仍然各自独立，SEO 与读屏都更干净 */
  .hit {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }

  /* 键盘焦点环：WinUI 用双色描边，这里用 outline 近似 */
  .hit:focus-visible {
    outline: 2px solid var(--c-ink);
    outline-offset: -2px;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /* ── hero：首篇横向排布，表面与其它卡片完全相同 ────────────── */
  .card-hero {
    grid-column: span 2;
    flex-direction: row;
  }

  .card-hero .cover {
    width: 44%;
    flex-shrink: 0;
    border-right: 1px solid var(--line-base);
  }

  .card-hero .cover img {
    height: 100%;
    min-height: 220px;
  }

  .card-hero .title {
    font-size: var(--t-display-size);
    line-height: var(--t-display-lh);
  }

  /* ── 封面 ──────────────────────────────────────────────── */
  .cover {
    overflow: hidden;
    background: var(--c-inset);
  }

  .cover img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 124px;
    object-fit: cover;
  }

  /* ── 内容 ──────────────────────────────────────────────── */
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--s-sm);
    padding: var(--s-lg);
    min-width: 0;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--s-sm);
    flex-wrap: wrap;
    color: var(--c-faint);
    font-size: var(--t-small-size);
  }

  /* 分类做成 WinUI 的强调色徽标（AccentFillColor 的浅色变体） */
  .category {
    padding: 1px 8px;
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--c-neon-volt) 18%, transparent);
    color: var(--c-neon-volt);
    font-weight: 600;
    font-size: 11.5px;
  }

  .title {
    margin: 0;
    font-size: var(--t-heading-size);
    font-weight: var(--t-heading-weight);
    line-height: var(--t-heading-lh);
    letter-spacing: var(--t-heading-ls);
    color: var(--c-ink);
  }

  .desc {
    margin: 0;
    color: var(--c-muted);
    font-size: var(--t-body-size);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 2px 0 0;
    padding: 0;
    list-style: none;
  }

  /* WinUI 的 Tag/Chip：4px 圆角 + 描边，不用胶囊 */
  .tag {
    padding: 2px 8px;
    border: 1px solid var(--line-base);
    border-radius: var(--r-sm);
    color: var(--c-muted);
    font-size: 11.5px;
    background: var(--c-s3);
  }

  /* 「阅读全文」：常显，用 WinUI 的强调色；箭头用 Segoe Fluent Icons */
  .more {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 2px;
    color: var(--c-neon-volt);
    font-size: var(--t-small-size);
    font-weight: 600;
  }

  .arrow {
    font-family: "Segoe Fluent Icons", "Segoe MDL2 Assets", sans-serif;
    font-size: 11px;
    transition: transform var(--m-quick);
  }

  .card:hover .arrow {
    transform: translateX(3px);
  }

  /* ── 移动端 ────────────────────────────────────────────── */
  @media (max-width: 720px) {
    .card-hero {
      grid-column: span 1;
      flex-direction: column;
    }
    .card-hero .cover {
      width: 100%;
      border-right: 0;
      border-bottom: 1px solid var(--line-base);
    }
    .card-hero .title {
      font-size: var(--t-heading-size);
    }
  }
</style>
