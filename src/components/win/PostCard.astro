---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
  slug: string;
}

const { post, slug } = Astro.props;
const { data } = post;

const dateFmt = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});

const updated = data.updated ?? data.published;
const href = `/posts/${slug}/`;
---

<a class="card post-card" href={href}>
  {data.image && (
    <div class="cover">
      <img src={data.image} alt="" loading="lazy" decoding="async" />
    </div>
  )}

  <div class="body">
    <div class="meta">
      <time datetime={data.published.toISOString()}>
        {dateFmt.format(data.published)}
      </time>
      {data.updated && data.updated.getTime() !== data.published.getTime() && (
        <span class="updated">更新于 {dateFmt.format(data.updated)}</span>
      )}
      {data.category && (
        <fluent-badge appearance="tint" size="small">
          {data.category}
        </fluent-badge>
      )}
    </div>

    <h2 class="title">{data.title}</h2>
    {data.description && <p class="desc">{data.description}</p>}

    {data.tags.length > 0 && (
      <div class="tags">
        {data.tags.slice(0, 4).map((tag) => (
          <fluent-badge appearance="outline" size="tiny">
            {tag}
          </fluent-badge>
        ))}
      </div>
    )}
  </div>
</a>

<style>
  .post-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacingHorizontalL);
    color: inherit;
  }

  .post-card:has(.cover) {
    grid-template-columns: 180px 1fr;
  }

  .cover {
    border-radius: var(--borderRadiusLarge);
    overflow: hidden;
    background: var(--colorNeutralBackground4);
  }
  .cover img {
    width: 100%;
    height: 100%;
    min-height: 120px;
    object-fit: cover;
    display: block;
  }

  .body { min-width: 0; }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacingHorizontalM);
    margin-bottom: 6px;
    color: var(--colorNeutralForeground4);
    font-size: var(--fontSizeBase100);
  }

  .title {
    margin: 0 0 6px;
    font-size: var(--fontSizeBase500);
    line-height: var(--lineHeightBase500);
    color: var(--colorNeutralForeground1);
  }
  .post-card:hover .title { color: var(--colorBrandForeground1); }

  .desc {
    margin: 0 0 10px;
    color: var(--colorNeutralForeground3);
    font-size: var(--fontSizeBase200);
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacingHorizontalXS);
    margin: 0;
  }

  @media (max-width: 640px) {
    .post-card:has(.cover) { grid-template-columns: 1fr; }
    .cover img { min-height: 160px; aspect-ratio: 16 / 9; }
  }
</style>