---
import { SITE, NAV } from "../../config/site";
import { DEFAULT_THEME } from "../../lib/theme/tokens";

const current = Astro.url.pathname;
---

<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label={`${SITE.title} 首页`}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">{SITE.title}</span>
    </a>

    <nav class="nav-links" aria-label="主导航">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={["nav-link", { active: current === item.href }]}
            aria-current={current === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!--
      真正的 Fluent Web Component。checked 初始值由 SSR 时的默认主题决定，
      避免升级瞬间出现状态跳变。
    -->
    <fluent-switch
      id="theme-toggle"
      class="theme-switch"
      checked={DEFAULT_THEME === "dark"}
      aria-label="暗色模式"
      title="切换明暗主题"
    >
      <span slot="checked-content" aria-hidden="true">暗</span>
      <span slot="unchecked-content" aria-hidden="true">亮</span>
    </fluent-switch>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--colorNeutralBackground2);
    border-bottom: 1px solid var(--colorNeutralStroke1);
    backdrop-filter: blur(20px) saturate(140%);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: var(--spacingHorizontalXL);
    height: 56px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--colorNeutralForeground1);
    font-weight: var(--fontWeightSemibold);
    text-decoration: none;
  }
  .brand:hover { text-decoration: none; }

  /* Win11 品牌方块 */
  .brand-mark {
    width: 20px;
    height: 20px;
    border-radius: var(--borderRadiusSmall);
    background: linear-gradient(135deg, #0078d4, #00b7c3);
  }

  .nav-links {
    display: flex;
    gap: var(--spacingHorizontalS);
    margin-left: auto;
  }

  .nav-link {
    position: relative;
    padding: 6px 12px;
    border-radius: var(--borderRadiusMedium);
    color: var(--colorNeutralForeground3);
    font-size: var(--fontSizeBase200);
    text-decoration: none;
    transition: background-color var(--durationFast) var(--curveEasyEase);
  }
  .nav-link:hover {
    background: var(--colorSubtleBackgroundHover);
    color: var(--colorNeutralForeground1);
    text-decoration: none;
  }
  .nav-link.active {
    background: var(--colorSubtleBackgroundSelected);
    color: var(--colorNeutralForeground1);
  }

  /* 主题切换：真正的 Fluent Web Component。
     custom element 在升级前是未定义的，行内元素会挤在一起，
     所以先给出 block 布局与最小宽度，避免布局跳动。 */
  .theme-switch {
    display: block;
    flex-shrink: 0;
    min-width: 52px;
  }
  /* 未升级（JS 未执行）时的降级外观：JS 就绪后由 Fluent 接管 */
  .theme-switch:not(:defined) {
    height: 20px;
    border-radius: var(--borderRadiusCircular);
    background: var(--colorNeutralBackground4);
    border: 1px solid var(--colorNeutralStroke1);
    font-size: 11px;
    line-height: 18px;
    text-align: center;
    color: var(--colorNeutralForeground3);
  }

  @media (max-width: 640px) {
    .brand-text { display: none; }
    .nav-inner { gap: var(--spacingHorizontalM); }
  }
</style>

<script>
  // fluent-switch 发 change 事件（不是 click），且 checked 由 SSR 的默认主题写入。
  // 用户实际偏好可能与默认不同，所以挂载时要先对齐一次真实主题。
  const sw = document.getElementById("theme-toggle") as
    | (HTMLElement & { checked: boolean })
    | null;

  const isDark = () =>
    document.documentElement.getAttribute("data-theme") === "dark";

  // 首次对齐
  if (sw) {
    const sync = () => {
      sw.checked = isDark();
    };
    // 等待 custom element 升级完再设，否则升级过程会覆盖
    if (sw.matches(":not(:defined)")) {
      customElements.whenDefined("fluent-switch").then(sync).catch(sync);
    } else {
      sync();
    }

    sw.addEventListener("change", () => {
      const api = (
        window as unknown as {
          __applyTheme?: (t: "dark" | "light") => void;
        }
      ).__applyTheme;
      // 以开关当前状态为准，避免再取一次当前主题导致来回翻转
      api?.(sw.checked ? "dark" : "light");
    });
  }
</script>