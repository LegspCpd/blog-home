---
import { SITE, NAV } from "../../config/site";

const current = Astro.url.pathname;
---

<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label={`${SITE.title} 首页`}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">{SITE.title}</span>
    </a>

    <nav class="nav-links" aria-label="主导航">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={["nav-link", { active: current === item.href }]}
            aria-current={current === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      id="theme-toggle"
      class="theme-btn"
      type="button"
      aria-label="切换明暗主题"
      title="切换明暗主题"
    >
      <span class="theme-icon" aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--colorNeutralBackground2);
    border-bottom: 1px solid var(--colorNeutralStroke1);
    backdrop-filter: blur(20px) saturate(140%);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: var(--spacingHorizontalXL);
    height: 56px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--colorNeutralForeground1);
    font-weight: var(--fontWeightSemibold);
    text-decoration: none;
  }
  .brand:hover { text-decoration: none; }

  /* Win11 品牌方块 */
  .brand-mark {
    width: 20px;
    height: 20px;
    border-radius: var(--borderRadiusSmall);
    background: linear-gradient(135deg, #0078d4, #00b7c3);
  }

  .nav-links {
    display: flex;
    gap: var(--spacingHorizontalS);
    margin-left: auto;
  }

  .nav-link {
    position: relative;
    padding: 6px 12px;
    border-radius: var(--borderRadiusMedium);
    color: var(--colorNeutralForeground3);
    font-size: var(--fontSizeBase200);
    text-decoration: none;
    transition: background-color var(--durationFast) var(--curveEasyEase);
  }
  .nav-link:hover {
    background: var(--colorSubtleBackgroundHover);
    color: var(--colorNeutralForeground1);
    text-decoration: none;
  }
  .nav-link.active {
    background: var(--colorSubtleBackgroundSelected);
    color: var(--colorNeutralForeground1);
  }

  /* 主题切换按钮 */
  .theme-btn {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    border-radius: var(--borderRadiusMedium);
    background: transparent;
    color: var(--colorNeutralForeground2);
    cursor: pointer;
    transition: background-color var(--durationFast) var(--curveEasyEase);
  }
  .theme-btn:hover { background: var(--colorSubtleBackgroundHover); }

  /* 太阳/月亮用纯 CSS 绘制，不引入图标依赖 */
  .theme-icon {
    position: relative;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: currentColor;
    transition: transform var(--durationNormal) var(--curveEasyEase);
  }
  :global(html[data-theme="light"]) .theme-icon {
    background: transparent;
    box-shadow: inset -2px -2px 0 0 currentColor;
  }
  :global(html[data-theme="dark"]) .theme-icon::after {
    content: "";
    position: absolute;
    inset: -3px -3px -3px 2px;
    border-radius: 50%;
    background: var(--colorNeutralBackground2);
  }

  @media (max-width: 640px) {
    .brand-text { display: none; }
    .nav-inner { gap: var(--spacingHorizontalM); }
  }
</style>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    (window as unknown as { __toggleTheme?: () => void }).__toggleTheme?.();
  });
</script>