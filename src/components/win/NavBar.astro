---
import { SITE, NAV } from "../../config/site";

/**
 * 导航栏
 *
 * 气质取自三处：
 * · Raycast   —— 极窄的实心 wordmark 块，白色 CTA 是唯一实心元素
 * · VoltAgent —— 上标大写眉标 + 发丝分隔线
 * · MiniMax   —— 药丸形导航项，激活项用表面抬升表示"浮起来一层"
 *
 * 「有点乱」的来源：左侧 wordmark 带一个会呼吸的霓虹指示点，
 * 激活项除了表面抬升还多一条极短的霓虹下划线——
 * 两个信号同时出现，视觉上略微"过载"，但读起来更清楚。
 */
---

<header class="nav" role="banner">
  <div class="nav-inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">{SITE.title}</span>
    </a>

    <nav class="links" aria-label="主导航">
      {
        NAV.map((item) => (
          <a
            class="link"
            href={item.href}
            aria-current={Astro.url.pathname === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="link" href="/rss.xml">
        RSS
      </a>
    </nav>

    <a class="cta" href="/archive/">
      全部文章
      <span class="cta-arrow" aria-hidden="true">→</span>
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    /* 半透明 + 背景模糊：内容滚过去时有玻璃感，但不遮视线 */
    background: color-mix(in srgb, var(--c-base) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid var(--line-soft);
  }

  .nav-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 var(--s-lg);
    height: 60px;
    display: flex;
    align-items: center;
    gap: var(--s-lg);
  }

  /* ── wordmark：带呼吸的霓虹点 ───────────────────────────── */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--c-ink);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.3px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand:hover {
    text-decoration: none;
  }

  .brand-mark {
    width: 9px;
    height: 9px;
    border-radius: 3px;
    background: var(--c-neon-volt);
    box-shadow: 0 0 10px rgba(0, 229, 154, 0.75);
    /* 呼吸：慢到几乎察觉不到，但页面「活着」 */
    animation: pulse 3.6s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.55;
      transform: scale(0.82);
    }
  }

  .brand-name {
    white-space: nowrap;
  }

  /* ── 链接组 ────────────────────────────────────────────── */
  .links {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-right: auto;
    min-width: 0;
  }

  .link {
    position: relative;
    padding: 6px 12px;
    border-radius: var(--r-pill);
    color: var(--c-muted);
    font-size: 13.5px;
    font-weight: 500;
    white-space: nowrap;
    transition:
      color var(--m-snap),
      background var(--m-quick);
  }

  .link:hover {
    color: var(--c-ink);
    background: var(--c-s2);
    text-decoration: none;
  }

  /* 激活态：表面抬升 + 一条短霓虹下划线（双重信号） */
  .link[aria-current="page"] {
    color: var(--c-ink);
    background: var(--c-s3);
  }

  .link[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -1px;
    width: 14px;
    height: 2px;
    border-radius: 2px;
    transform: translateX(-50%);
    background: var(--c-neon-volt);
    box-shadow: 0 0 8px rgba(0, 229, 154, 0.8);
  }

  /* ── 唯一实心元素：白色 CTA（Raycast 的招牌）───────────── */
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 15px;
    border-radius: var(--r-sm);
    background: var(--c-ink);
    color: var(--c-base);
    font-size: 13.5px;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
    /* hover 抬起 = 往观众方向走；active 按下 = 缩回去。
       两者合成「有重量」的触感，这是按钮质感的核心。 */
    transition:
      transform var(--m-quick),
      box-shadow var(--m-quick),
      background var(--m-snap);
  }

  .cta:hover {
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px -6px rgba(255, 255, 255, 0.35);
  }

  .cta:active {
    transform: translateY(0) scale(0.97);
    box-shadow: none;
    transition-duration: var(--m-snap);
  }

  .cta-arrow {
    transition: transform var(--m-quick);
  }
  .cta:hover .cta-arrow {
    transform: translateX(3px);
  }

  /* ── 移动端：链接横向滚动，CTA 保留 ───────────────────── */
  @media (max-width: 760px) {
    .nav-inner {
      gap: var(--s-sm);
      padding: 0 var(--s-md);
    }
    .brand-name {
      display: none;
    }
    .links {
      overflow-x: auto;
      scrollbar-width: none;
    }
    .links::-webkit-scrollbar {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-mark {
      animation: none;
    }
  }
</style>
