---
import { SITE } from "../../config/site";

/**
 * 页脚
 *
 * Superhuman 的系统里每个页面都以一个深青色带收尾——
 * 那是「和弦的解决」。我这里把它换成霓虹绿的极窄光带：
 * 不用整块深色收尾，而是在页脚上方留一条会发光的细线，
 * 既是收尾标记，也让长页面滚到底时有个视觉落点。
 */
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="glow" aria-hidden="true"></div>

  <div class="inner">
    <div class="lead">
      <p class="eyebrow">保持联系</p>
      <p class="pitch">有新文章就写在这儿。</p>
      <a class="rss" href="/rss.xml">
        订阅 RSS
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <nav class="cols" aria-label="页脚导航">
      <div class="col">
        <span class="col-title">站点</span>
        <a href="/">首页</a>
        <a href="/archive/">归档</a>
        <a href="/tags/">标签</a>
      </div>
      <div class="col">
        <span class="col-title">订阅</span>
        <a href="/rss.xml">RSS</a>
        <a href="/sitemap-index.xml">Sitemap</a>
      </div>
    </nav>
  </div>

  <p class="legal">
    <span>© {year} {SITE.title}</span>
    <span class="sep" aria-hidden="true">·</span>
    <span>用 Astro 构建</span>
  </p>
</footer>

<style>
  .site-footer {
    margin-top: var(--s-xxl);
    border-top: 1px solid var(--line-soft);
    background: var(--c-s1);
  }

  /* 霓虹细线：页脚的「解决和弦」 */
  .glow {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--c-neon-volt) 22%,
      var(--c-neon-lilac) 50%,
      var(--c-neon-volt) 78%,
      transparent
    );
    opacity: 0.65;
  }

  .inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: var(--s-xl) var(--s-lg) var(--s-lg);
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--s-xl);
    align-items: start;
  }

  .lead .eyebrow {
    color: var(--c-faint);
    margin-bottom: var(--s-sm);
  }

  .pitch {
    margin: 0 0 var(--s-md);
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.5px;
    color: var(--c-ink);
  }

  /* RSS 是这里唯一的强调动作：描边 + hover 转霓虹实心 */
  .rss {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border: 1px solid var(--line-base);
    border-radius: var(--r-md);
    color: var(--c-body);
    font-size: 14px;
    font-weight: 600;
    transition:
      transform var(--m-quick),
      background var(--m-quick),
      border-color var(--m-quick),
      color var(--m-quick),
      box-shadow var(--m-quick);
  }

  .rss:hover {
    text-decoration: none;
    transform: translateY(-2px);
    color: var(--c-on-neon);
    background: var(--c-neon-volt);
    border-color: var(--c-neon-volt);
    box-shadow: 0 8px 24px -10px rgba(0, 229, 154, 0.65);
  }

  .rss:active {
    transform: translateY(0) scale(0.97);
    transition-duration: var(--m-snap);
  }

  .arrow {
    transition: transform var(--m-quick);
  }
  .rss:hover .arrow {
    transform: translateX(3px);
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-lg);
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .col-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--c-faint);
    margin-bottom: 2px;
  }

  .col a {
    color: var(--c-muted);
    font-size: 14px;
    transition:
      color var(--m-snap),
      transform var(--m-quick);
  }

  .col a:hover {
    text-decoration: none;
    color: var(--c-neon-volt);
    transform: translateX(3px);
  }

  .legal {
    max-width: 1180px;
    margin: 0 auto;
    padding: var(--s-md) var(--s-lg) var(--s-lg);
    display: flex;
    align-items: center;
    gap: 8px;
    border-top: 1px solid var(--line-soft);
    color: var(--c-faint);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.2px;
  }

  .sep {
    opacity: 0.5;
  }

  @media (max-width: 720px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-lg);
    }
  }
</style>
