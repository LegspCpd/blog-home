---
import { SITE } from "../../config/site";

/**
 * 页脚。
 *
 * 上一版是「霓虹绿收尾光带 + 大写宽字距眉标 + 霓虹描边按钮」，
 * 属于 VoltAgent / Superhuman 那套语言。WinUI 里没有这些东西：
 * 页脚就是一条发丝分隔线加若干列普通文字，唯一的动作是一个标准按钮。
 * 这里换成 Fluent 的做法 —— 结构不动，只换表现。
 */
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <div class="lead">
      <p class="lead-title">保持联系</p>
      <p class="pitch">有新文章就写在这儿。</p>
      <a class="rss" href="/rss.xml">
        订阅 RSS
        <span class="arrow" aria-hidden="true">&#xE76C;</span>
      </a>
    </div>

    <nav class="cols" aria-label="页脚导航">
      <div class="col">
        <span class="col-title">站点</span>
        <a href="/">首页</a>
        <a href="/archive/">归档</a>
        <a href="/tags/">标签</a>
      </div>
      <div class="col">
        <span class="col-title">订阅</span>
        <a href="/rss.xml">RSS</a>
        <a href="/sitemap-index.xml">Sitemap</a>
      </div>
    </nav>
  </div>

  <p class="legal">
    <span>© {year} {SITE.title}</span>
    <span class="sep" aria-hidden="true">·</span>
    <span>用 Astro 构建</span>
  </p>
</footer>

<style>
  .site-footer {
    margin-top: var(--s-xxl);
    /* WinUI 用一条发丝分隔线划分区域，不用渐变光带 */
    border-top: 1px solid var(--line-base);
    background: var(--c-s1);
  }

  .inner {
    padding: var(--s-xl) var(--s-lg) var(--s-lg);
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--s-xl);
    align-items: start;
  }

  /* 小节标题：WinUI 的 Caption 是 12px、常规字距，不做大写宽字距 */
  .lead-title,
  .col-title {
    margin: 0 0 var(--s-md);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--c-faint);
  }

  .pitch {
    margin: 0 0 var(--s-md);
    font-size: var(--t-heading-size);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--c-ink);
  }

  /* 标准按钮：WinUI 的 4px 圆角、淡表面、1px 描边，hover 只叠一层填充 */
  .rss {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 16px;
    min-height: 32px;
    border: 1px solid var(--line-base);
    border-radius: var(--r-sm);
    background: var(--c-s3);
    color: var(--c-ink);
    font-size: 14px;
    font-weight: 600;
    transition:
      background var(--m-snap),
      border-color var(--m-snap);
  }

  .rss:hover {
    text-decoration: none;
    background: var(--c-s2);
    border-color: var(--line-strong);
  }

  .arrow {
    font-family: "Segoe Fluent Icons", "Segoe MDL2 Assets", sans-serif;
    font-size: 11px;
    transition: transform var(--m-quick);
  }

  .rss:hover .arrow {
    transform: translateX(3px);
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-lg);
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .col a {
    color: var(--c-muted);
    font-size: 14px;
    transition: color var(--m-snap);
  }

  .col a:hover {
    text-decoration: none;
    color: var(--c-ink);
  }

  .legal {
    margin: 0;
    padding: var(--s-md) var(--s-lg) var(--s-lg);
    display: flex;
    align-items: center;
    gap: 8px;
    border-top: 1px solid var(--line-soft);
    color: var(--c-faint);
    font-size: 12px;
  }

  .sep {
    opacity: 0.5;
  }

  @media (max-width: 720px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-lg);
    }
  }
</style>
