---
/**
 * SbNavbar.astro
 * ---------------------------------------------------------------------------
 * Supabase-style top navigation.
 *   - White canvas, hairline border only on scroll
 *   - Brand wordmark with the signature emerald dot accent
 *   - Flat text links (no icons) — quiet, technical chrome
 *   - Single filled emerald CTA on the right + theme toggle
 */
import { Icon } from "astro-icon/components";
import LightDarkSwitch from "@/components/controls/LightDarkSwitch.svelte";
import Search from "@/components/controls/Search.svelte";
import { navBarConfig, siteConfig } from "@/config";
import { LinkPresets } from "@/constants/link-presets";
import { LinkPreset, type NavBarLink } from "@/types/config";
import { url } from "@/utils/url-utils";

const links: NavBarLink[] = navBarConfig.links
	.map((item: NavBarLink | LinkPreset) =>
		typeof item === "number" ? LinkPresets[item] : item,
	)
	.filter((link): link is NavBarLink => Boolean(link));

const siteTitle = siteConfig.navbar.title || siteConfig.title || "LegspCpd";
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const isActive = (href: string) => {
	if (!href.startsWith("/")) return false;
	const normalized = href.replace(/\/$/, "") || "/";
	if (normalized === "/") return currentPath === "/";
	return currentPath === normalized || currentPath.startsWith(`${normalized}/`);
};

// Logo handling — icon / image / url, mirroring the original config surface
const logo = siteConfig.navbar.logo;
const logoType = logo?.type;
const logoValue = logo?.value || "";
---

<header class="sb-nav" id="sb-navbar" data-navbar>
  <div class="sb-container sb-nav__inner">
    <!-- Brand -->
    <a href={url("/")} class="sb-nav__brand" aria-label={siteTitle}>
      {
        logoType === "image" && logoValue ? (
          <img
            src={logoValue.startsWith("http") ? logoValue : url(logoValue)}
            alt={logo?.alt || siteTitle}
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <Icon
            name={logoType === "icon" && logoValue ? logoValue : "material-symbols:terminal"}
            class="sb-nav__mark"
          />
        )
      }
      <span>{siteTitle}<span class="sb-nav__dot" aria-hidden="true"></span></span>
    </a>

    <!-- Primary links -->
    <nav class="sb-nav__links" aria-label="主导航">
      {
        links.map((link) => (
          <a
            href={link.external ? link.url : url(link.url)}
            class="sb-nav__link"
            aria-current={isActive(link.url) ? "page" : undefined}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            {link.name}
          </a>
        ))
      }
    </nav>

    <!-- Actions -->
    <div class="sb-nav__actions">
      <Search class="sb-nav__search" />
      <LightDarkSwitch client:load />
      <a href={url("/about/")} class="sb-btn sb-btn--primary sb-btn--sm sb-nav__cta">
        关于我
      </a>
    </div>
  </div>
</header>

<style is:global>
  .sb-nav__mark {
    font-size: 24px;
    color: var(--sb-primary);
    flex-shrink: 0;
  }

  .sb-nav__cta {
    margin-left: 4px;
  }

  /* Search control sits quietly in the nav */
  .sb-nav__search {
    color: var(--sb-ink-mute);
  }

  @media (max-width: 767px) {
    .sb-nav__cta {
      display: none;
    }
  }
</style>

<script>
  // Hairline border appears only once the page scrolls.
  const navbar = document.querySelector<HTMLElement>("[data-navbar]");
  if (navbar) {
    const onScroll = () => {
      navbar.classList.toggle("is-scrolled", window.scrollY > 8);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
