---
/**
 * CommandPalette.astro —— 全局命令面板
 *
 * Ctrl/⌘+K 唤起。可做两件事：
 *   1. 跳转到静态页面（首页、文章、归档、标签、项目…）
 *   2. 全文搜索（复用 pagefind 索引，与 /search/ 页同一份数据）
 *
 * 挂载在 #swup-container 之外，由 Layout 常驻，
 * 因此切页不会丢失状态，也只需绑定一次快捷键。
 */
import { defaultNavItems } from "@/config/sidebarNav";
import { siteConfig } from "@/config/siteConfig";
import { url } from "@/utils/url-utils";

// 面板里的静态命令：侧栏导航 + 常用入口
const commands = [
	...defaultNavItems.map((item) => ({
		label: item.title,
		hint: item.href,
		href: url(item.href),
		group: "导航",
	})),
	{
		label: "RSS 订阅",
		hint: "/rss/",
		href: url("/rss/"),
		group: "导航",
	},
	{
		label: "站点统计",
		hint: "/stats/",
		href: url("/stats/"),
		group: "导航",
	},
	{
		label: "留言板",
		hint: "/guestbook/",
		href: url("/guestbook/"),
		group: "互动",
	},
	{
		label: "联系我",
		hint: "/contact/",
		href: url("/contact/"),
		group: "互动",
	},
	{
		label: "友情链接",
		hint: "/friends/",
		href: url("/friends/"),
		group: "互动",
	},
	{
		label: "服务条款与隐私政策",
		hint: "/privacy/",
		href: url("/privacy/"),
		group: "关于",
	},
];

const groups = [...new Set(commands.map((c) => c.group))];
---

<div class="cmd-root" data-cmd-root hidden>
	<!-- 遮罩：点击关闭 -->
	<div class="cmd-backdrop" data-cmd-close></div>

	<div
		class="cmd-panel"
		role="dialog"
		aria-modal="true"
		aria-label="命令面板"
	>
		<div class="cmd-input-row">
			<svg
				class="cmd-input-icon"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				aria-hidden="true"
			>
				<circle cx="11" cy="11" r="7" />
				<path d="m20 20-3.5-3.5" stroke-linecap="round" />
			</svg>
			<input
				type="text"
				class="cmd-input"
				placeholder="搜索文章，或输入页面名…"
				autocomplete="off"
				spellcheck="false"
				aria-label="搜索"
				data-cmd-input
			/>
			<kbd class="cmd-esc">Esc</kbd>
		</div>

		<div class="cmd-results" data-cmd-results>
			<!-- 静态命令（默认展示） -->
			{
				groups.map((group) => (
					<div class="cmd-group" data-cmd-group={group}>
						<div class="cmd-group-label">{group}</div>
						<ul>
							{commands
								.filter((c) => c.group === group)
								.map((c) => (
									<li>
										<a href={c.href} class="cmd-item" data-cmd-static>
											<span class="cmd-item-label">{c.label}</span>
											<span class="cmd-item-hint">{c.hint}</span>
										</a>
									</li>
								))}
						</ul>
					</div>
				))
			}

			<!-- 搜索结果（动态插入） -->
			<div class="cmd-group" data-cmd-search hidden>
				<div class="cmd-group-label">搜索结果</div>
				<ul data-cmd-search-list></ul>
			</div>

			<!-- 状态提示 -->
			<div class="cmd-state" data-cmd-state hidden></div>
		</div>

		<footer class="cmd-foot">
			<span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
			<span><kbd>Enter</kbd> 打开</span>
			<span><kbd>Esc</kbd> 关闭</span>
		</footer>
	</div>
</div>

<!-- 唤起按钮：放进布局的浮动控件栈，与返回顶部等按钮自动错开 -->
<button
	type="button"
	class="su-fab"
	data-fab
	data-fab-order="2"
	data-cmd-open
	aria-label="打开命令面板"
	title="打开命令面板"
>
	<svg
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		aria-hidden="true"
	>
		<circle cx="11" cy="11" r="7" />
		<path d="m20 20-3.5-3.5" stroke-linecap="round" />
	</svg>
	<span class="su-fab-label">搜索</span>
	<kbd class="su-fab-kbd">Ctrl K</kbd>
</button>

<script is:inline define:vars={{ siteTitle: siteConfig.title }}>
	(function () {
		var root = document.querySelector("[data-cmd-root]");
		var input = document.querySelector("[data-cmd-input]");
		var results = document.querySelector("[data-cmd-results]");
		var searchGroup = document.querySelector("[data-cmd-search]");
		var searchList = document.querySelector("[data-cmd-search-list]");
		var stateEl = document.querySelector("[data-cmd-state]");
		if (!root || !input || !results) return;

		var staticGroups = Array.prototype.slice.call(
			document.querySelectorAll("[data-cmd-group]"),
		);
		var activeIndex = -1;
		var currentItems = [];
		var debounceTimer = null;
		var lastFocused = null;

		function getVisibleItems() {
			return Array.prototype.slice
				.call(root.querySelectorAll(".cmd-item"))
				.filter(function (el) {
					return el.offsetParent !== null;
				});
		}

		function setActive(i) {
			var items = getVisibleItems();
			if (items.length === 0) return;
			if (i < 0) i = items.length - 1;
			if (i >= items.length) i = 0;
			activeIndex = i;
			items.forEach(function (el, idx) {
				el.classList.toggle("is-active", idx === i);
			});
			// 让选中项保持在可视区内
			var el = items[i];
			if (el && el.scrollIntoView) {
				el.scrollIntoView({ block: "nearest" });
			}
		}

		function open() {
			lastFocused = document.activeElement;
			root.hidden = false;
			// 触发一次 reflow 让 hidden 移除后的过渡生效
			void root.offsetWidth;
			root.classList.add("is-open");
			document.body.style.overflow = "hidden";
			input.value = "";
			resetResults();
			// 聚焦放在 requestAnimationFrame 里，避免与遮罩动画抢帧
			requestAnimationFrame(function () {
				input.focus();
			});
		}

		function close() {
			root.classList.remove("is-open");
			document.body.style.overflow = "";
			setTimeout(function () {
				root.hidden = true;
			}, 150);
			if (lastFocused && lastFocused.focus) lastFocused.focus();
		}

		function resetResults() {
			if (searchList) searchList.innerHTML = "";
			if (searchGroup) searchGroup.hidden = true;
			if (stateEl) {
				stateEl.hidden = true;
				stateEl.textContent = "";
			}
			staticGroups.forEach(function (g) {
				g.hidden = false;
			});
			activeIndex = -1;
		}

		function doSearch(q) {
			var query = q.trim();
			if (!query) {
				resetResults();
				return;
			}
			// 先做静态命令的本地过滤，快速给出反馈
			staticGroups.forEach(function (g) {
				var items = g.querySelectorAll(".cmd-item");
				var anyVisible = false;
				items.forEach(function (el) {
					var text = (el.textContent || "").toLowerCase();
					var hit = text.indexOf(query.toLowerCase()) !== -1;
					el.hidden = !hit;
					if (hit) anyVisible = true;
				});
				g.hidden = !anyVisible;
			});

			if (!window.pagefind) {
				if (stateEl) {
					stateEl.hidden = false;
					stateEl.textContent = "全文索引加载中，稍后再试…";
				}
				return;
			}

			window.pagefind
				.search(query)
				.then(function (res) {
					return Promise.all(
						res.results.slice(0, 8).map(function (r) {
							return r.data();
						}),
					);
				})
				.then(function (data) {
					if (!searchList) return;
					searchList.innerHTML = "";
					if (data.length === 0) {
						if (stateEl) {
							stateEl.hidden = false;
							stateEl.textContent = "没有匹配的内容";
						}
						if (searchGroup) searchGroup.hidden = true;
						return;
					}
					if (stateEl) stateEl.hidden = true;
					if (searchGroup) searchGroup.hidden = false;

					data.forEach(function (item) {
						var li = document.createElement("li");
						var a = document.createElement("a");
						a.className = "cmd-item";
						a.href = item.url;
						// pagefind 的 title/excerpt 含 <mark> 高亮，保留但过滤掉脚本类标签
						var title = String(item.meta && item.meta.title ? item.meta.title : item.url);
						var excerpt = String(item.excerpt || "");
						a.innerHTML =
							'<span class="cmd-item-label">' +
							title +
							"</span>" +
							'<span class="cmd-item-excerpt">' +
							excerpt +
							"</span>";
						li.appendChild(a);
						searchList.appendChild(li);
					});
					activeIndex = -1;
				})
				.catch(function () {
					if (stateEl) {
						stateEl.hidden = false;
						stateEl.textContent = "搜索失败，请稍后重试";
					}
				});
		}

		// ---- 事件绑定 ----
		document.addEventListener("click", function (e) {
			var t = e.target;
			if (t.closest("[data-cmd-open]")) {
				e.preventDefault();
				open();
			} else if (t.closest("[data-cmd-close]")) {
				close();
			}
		});

		document.addEventListener("keydown", function (e) {
			// Ctrl/⌘+K 唤起
			if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
				e.preventDefault();
				if (root.hidden) open();
				else close();
				return;
			}
			if (root.hidden) return;

			if (e.key === "Escape") {
				e.preventDefault();
				close();
			} else if (e.key === "ArrowDown") {
				e.preventDefault();
				setActive(activeIndex + 1);
			} else if (e.key === "ArrowUp") {
				e.preventDefault();
				setActive(activeIndex - 1);
			} else if (e.key === "Enter") {
				var items = getVisibleItems();
				if (activeIndex >= 0 && items[activeIndex]) {
					e.preventDefault();
					items[activeIndex].click();
				}
			}
		});

		input.addEventListener("input", function () {
			clearTimeout(debounceTimer);
			debounceTimer = setTimeout(function () {
				doSearch(input.value);
			}, 180);
		});

		// 鼠标悬停同步键盘选中项
		results.addEventListener("mousemove", function (e) {
			var item = e.target.closest(".cmd-item");
			if (!item) return;
			var items = getVisibleItems();
			var idx = items.indexOf(item);
			if (idx !== -1 && idx !== activeIndex) {
				activeIndex = idx;
				items.forEach(function (el, i) {
					el.classList.toggle("is-active", i === idx);
				});
			}
		});

		window.cmdOpen = open;
		window.cmdClose = close;
	})();
</script>

<style is:global>
	/* 唤起按钮的样式由布局的浮动控件栈统一定义（.su-fab），
	   这里只补充它特有的两个元素：文字标签与快捷键提示。 */
	.su-fab-label {
		flex: 1;
		text-align: left;
	}

	.su-fab-kbd {
		font-family: var(--font-mono-supabase);
		font-size: 10px;
		color: var(--su-ink-faint);
	}

	/* ---- 面板 ---- */
	.cmd-root {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding-top: min(18vh, 140px);
	}

	.cmd-root[hidden] {
		display: none;
	}

	.cmd-backdrop {
		position: absolute;
		inset: 0;
		background-color: rgba(20, 20, 18, 0.32);
		backdrop-filter: blur(3px);
		-webkit-backdrop-filter: blur(3px);
		opacity: 0;
		transition: opacity 0.15s ease;
	}

	.cmd-root.is-open .cmd-backdrop {
		opacity: 1;
	}

	.cmd-panel {
		position: relative;
		width: min(560px, calc(100vw - 32px));
		max-height: min(60vh, 480px);
		display: flex;
		flex-direction: column;
		border: 1px solid var(--su-border);
		border-radius: var(--su-radius-lg);
		background-color: var(--su-card);
		box-shadow: var(--su-shadow-3);
		overflow: hidden;
		opacity: 0;
		transform: translateY(-8px) scale(0.98);
		transition:
			opacity 0.15s ease,
			transform 0.15s ease;
	}

	.cmd-root.is-open .cmd-panel {
		opacity: 1;
		transform: translateY(0) scale(1);
	}

	/* ---- 输入行 ---- */
	.cmd-input-row {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 0 14px;
		height: 52px;
		flex: none;
		border-bottom: 1px solid var(--su-border);
	}

	.cmd-input-icon {
		width: 18px;
		height: 18px;
		flex: none;
		color: var(--su-ink-faint);
	}

	.cmd-input {
		flex: 1;
		min-width: 0;
		height: 100%;
		border: 0;
		outline: none;
		background: transparent;
		font-family: inherit;
		font-size: 15px;
		color: var(--su-foreground);
	}

	.cmd-input::placeholder {
		color: var(--su-ink-faint);
	}

	.cmd-esc {
		flex: none;
		padding: 2px 6px;
		border: 1px solid var(--su-border);
		border-radius: var(--su-radius-xs);
		background-color: var(--su-canvas-soft);
		font-family: var(--font-mono-supabase);
		font-size: 10px;
		color: var(--su-ink-faint);
	}

	/* ---- 结果区 ---- */
	.cmd-results {
		flex: 1;
		min-height: 0;
		overflow-y: auto;
		padding: 8px;
		overscroll-behavior: contain;
	}

	.cmd-group + .cmd-group {
		margin-top: 12px;
		padding-top: 12px;
		border-top: 1px solid var(--su-border);
	}

	.cmd-group-label {
		padding: 4px 8px 6px;
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.04em;
		color: var(--su-ink-faint);
	}

	.cmd-group ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cmd-item {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 8px 10px;
		border-radius: var(--su-radius-sm);
		color: inherit;
		text-decoration: none;
		cursor: pointer;
	}

	.cmd-item.is-active {
		background-color: var(--su-primary-soft);
	}

	.cmd-item-label {
		font-size: 14px;
		line-height: 1.4;
		color: var(--su-foreground);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.cmd-item-hint {
		font-family: var(--font-mono-supabase);
		font-size: 11px;
		color: var(--su-ink-faint);
	}

	.cmd-item-excerpt {
		font-size: 12px;
		line-height: 1.5;
		color: var(--su-muted-foreground);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* pagefind 高亮 */
	.cmd-item :global(mark) {
		background-color: transparent;
		color: var(--su-primary-deep);
		font-weight: 600;
	}

	.cmd-state {
		padding: 28px 12px;
		text-align: center;
		font-size: 14px;
		color: var(--su-muted-foreground);
	}

	/* ---- 底部提示 ---- */
	.cmd-foot {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		padding: 8px 14px;
		flex: none;
		border-top: 1px solid var(--su-border);
		background-color: var(--su-canvas-soft);
		font-size: 11px;
		color: var(--su-ink-faint);
	}

	.cmd-foot kbd {
		padding: 1px 5px;
		margin-right: 3px;
		border: 1px solid var(--su-border);
		border-radius: 3px;
		background-color: var(--su-card);
		font-family: var(--font-mono-supabase);
		font-size: 10px;
	}

	@media (max-width: 640px) {
		.cmd-root {
			padding-top: 12px;
		}
		.cmd-panel {
			width: calc(100vw - 20px);
			max-height: 72vh;
		}
		.cmd-foot {
			display: none; /* 手机无物理键盘 */
		}
		/* 移动端不显示浮动唤起按钮：顶栏已有导航，抽屉即入口。
		   面板本身仍可通过 Ctrl+K（外接键盘）打开。
		   具体隐藏规则见布局的 .su-fab-dock。 */
	}
</style>