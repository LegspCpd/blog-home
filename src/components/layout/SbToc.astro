---
/**
 * SbToc.astro —— 文章目录
 *
 * 两种形态共用同一份数据：
 *  - 桌面（≥1024px）：右侧 sticky 栏，跟着滚动高亮当前章节
 *  - 窄屏（<1024px）：收进底部抽屉，由左下角的「目录」按钮唤起
 *
 * 之前窄屏是直接 display:none，长文章在手机上完全没法跳转章节，
 * 这是个真实的可用性缺口。
 */
import { Icon } from "astro-icon/components";
import type { MarkdownHeading } from "astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const toc = headings
	.filter((h) => h.depth > 1 && h.depth <= 3)
	// 去掉 rehype-autolink-headings 注入的尾部锚点符号
	.map((h) => ({ ...h, text: h.text.replace(/#+\s*$/, "").trim() }));

const tocId = `toc-${toc.map((h) => h.slug).join("-").slice(0, 24)}`;
---

{
	toc.length > 0 && (
		<>
			<aside class="sb-toc-rail" aria-label="目录">
				<div class="sb-toc">
					<div class="sb-toc__title">本页目录</div>
					<nav class="sb-toc__nav">
						{toc.map((h) => (
							<a
								href={`#${h.slug}`}
								class:list={["sb-toc__item", `sb-toc__item--h${h.depth}`]}
								data-toc-link={h.slug}
							>
								{h.text}
							</a>
						))}
					</nav>
				</div>
			</aside>

			{/* 窄屏抽屉：默认隐藏，由 [data-toc-open] 唤起 */}
			<div class="toc-sheet" data-toc-sheet>
				<button
					type="button"
					class="toc-sheet-backdrop"
					data-toc-close
					aria-label="关闭目录"
				/>
				<div
					class="toc-sheet-panel"
					role="dialog"
					aria-modal="true"
					aria-label="本页目录"
				>
					<div class="toc-sheet-head">
						<span class="toc-sheet-title">本页目录</span>
						<button
							type="button"
							class="toc-sheet-close"
							data-toc-close
							aria-label="关闭目录"
						>
							<Icon name="material-symbols:close" />
						</button>
					</div>
					<nav class="toc-sheet-list">
						{toc.map((h) => (
							<a
								href={`#${h.slug}`}
								class:list={[
									"toc-sheet-item",
									`toc-sheet-item--h${h.depth}`,
								]}
								data-toc-link={h.slug}
							>
								{h.text}
							</a>
						))}
					</nav>
				</div>
			</div>
		</>
	)
}

<style is:global>
	/* ---------- 桌面：右侧 sticky 栏 ---------- */
	.sb-toc-rail {
		position: sticky;
		top: calc(var(--su-header-height, 60px) + 24px);
		align-self: start;
		max-height: calc(100vh - var(--su-header-height, 60px) - 48px);
		overflow-y: auto;
	}

	.sb-toc {
		position: relative;
		border-left: 1px solid var(--su-border);
		padding-left: 16px;
	}

	/*
	  高亮指示条：绝对定位的小竖条，位置由 JS 写入 CSS 变量。
	  用 transform: translateY() 而不是 top —— top 过渡每帧都触发布局计算，
	  translateY 走合成层，滑动更顺。
	*/
	.sb-toc::before {
		content: "";
		position: absolute;
		left: -1px;
		top: 0;
		width: 2px;
		height: var(--toc-indicator-height, 0px);
		border-radius: var(--su-radius-full);
		background: var(--su-primary);
		opacity: var(--toc-indicator-opacity, 0);
		transform: translateY(var(--toc-indicator-y, 0px));
		transition:
			transform 340ms var(--su-ease-out),
			height 260ms var(--su-ease-out),
			opacity 220ms var(--su-ease-out);
		will-change: transform;
	}

	/* 窄屏不需要指示条（抽屉里的高亮用底色表示） */
	@media (max-width: 1023px) {
		.sb-toc::before {
			display: none;
		}
	}

	.sb-toc__title {
		font-size: 12px;
		font-weight: 500;
		color: var(--su-foreground);
		margin-bottom: 10px;
	}

	.sb-toc__nav {
		display: flex;
		flex-direction: column;
		gap: 1px;
	}

	.sb-toc__item {
		display: block;
		padding: 5px 8px;
		font-size: 12.5px;
		line-height: 1.5;
		color: var(--su-muted-foreground);
		text-decoration: none;
		border-radius: var(--su-radius-xs);
		transition:
			color var(--su-dur-fast) var(--su-ease-out),
			background-color var(--su-dur-fast) var(--su-ease-out);
	}

	.sb-toc__item:hover {
		color: var(--su-foreground);
		background-color: var(--su-canvas-soft);
	}

	.sb-toc__item--h3 {
		padding-left: 20px;
		font-size: 12px;
	}

	/* 高亮不再靠自身描边（指示条已接管），用底色 + 字重表示 */
	.sb-toc__item.is-active {
		color: var(--su-foreground);
		font-weight: 600;
		background-color: var(--su-primary-soft);
	}

	/* ---------- 窄屏：底部抽屉 ---------- */
	.toc-sheet {
		display: none;
	}

	@media (max-width: 1023px) {
		/* 桌面栏隐藏 */
		.sb-toc-rail {
			display: none;
		}

		.toc-sheet {
			display: none;
			position: fixed;
			inset: 0;
			z-index: 80;
		}

		/* 未唤起时整体隐藏（脚本加 .is-shown 后才出现） */
		.toc-sheet.is-shown {
			display: block;
		}

		.toc-sheet-backdrop {
			position: absolute;
			inset: 0;
			border: 0;
			padding: 0;
			background-color: rgba(20, 20, 18, 0.35);
			backdrop-filter: blur(2px);
			-webkit-backdrop-filter: blur(2px);
			opacity: 0;
			transition: opacity 0.18s ease;
			cursor: pointer;
		}

		.toc-sheet.is-open .toc-sheet-backdrop {
			opacity: 1;
		}

		/* 面板从底部滑入 */
		.toc-sheet-panel {
			position: absolute;
			inset: auto 0 0 0;
			max-height: 76vh;
			display: flex;
			flex-direction: column;
			border-top: 1px solid var(--su-border);
			border-radius: var(--su-radius-xl) var(--su-radius-xl) 0 0;
			background-color: var(--su-card);
			box-shadow: var(--su-shadow-3);
			transform: translateY(100%);
			transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1);
		}

		.toc-sheet.is-open .toc-sheet-panel {
			transform: translateY(0);
		}

		/* 面板顶部的小横条，暗示可以下拉关闭 */
		.toc-sheet-panel::before {
			content: "";
			position: absolute;
			top: 8px;
			left: 50%;
			transform: translateX(-50%);
			width: 36px;
			height: 4px;
			border-radius: 999px;
			background-color: var(--su-border);
		}

		.toc-sheet-head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 12px;
			padding: 20px var(--su-space-md) 12px;
			border-bottom: 1px solid var(--su-border);
		}

		.toc-sheet-title {
			font-size: 15px;
			font-weight: 600;
			color: var(--su-foreground);
		}

		.toc-sheet-close {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 30px;
			height: 30px;
			border: 0;
			border-radius: var(--su-radius-full);
			background-color: var(--su-muted);
			color: var(--su-muted-foreground);
			cursor: pointer;
		}

		.toc-sheet-list {
			flex: 1;
			min-height: 0;
			overflow-y: auto;
			overscroll-behavior: contain;
			padding: var(--su-space-xs) var(--su-space-sm) var(--su-space-lg);
		}

		.toc-sheet-item {
			display: block;
			/* 触摸目标不小于 44px */
			padding: 11px var(--su-space-sm);
			border-radius: var(--su-radius-sm);
			font-size: 14px;
			line-height: 1.5;
			color: var(--su-foreground);
			text-decoration: none;
		}

		.toc-sheet-item:active {
			background-color: var(--su-accent);
		}

		.toc-sheet-item--h3 {
			padding-left: var(--su-space-lg);
			font-size: 13px;
			color: var(--su-muted-foreground);
		}

		.toc-sheet-item.is-active {
			background-color: var(--su-primary-soft);
			color: var(--su-foreground);
			font-weight: 500;
		}
	}
</style>

<!--
  客户端脚本说明（踩过坑才写下来的）：

  1. 这里必须写纯 JS，不能有 TS 标注。
     Astro 把「带属性的 <script>」（例如 <script lang="ts">）当成 is:inline，
     完全跳过处理，类型标注不会被转译，浏览器执行时直接 SyntaxError。
  2. 但 astro check 仍以 TS 模式解析这个块，于是会报
     「Property 'hidden' does not exist on type 'Element'」这类收窄错误。
     JSDoc 也救不了（它只在 .js 文件里被识别）。
     所以这里用 // @ts-nocheck 明确声明：本块不做类型检查。
-->
<script>
// @ts-nocheck
	/**
	 * 窄屏目录抽屉：打开 / 关闭 / 点条目后自动收起 / Esc 关闭。
	 * 桌面端不受影响（.toc-sheet 在 ≥1024px 时是 display:none）。
	 */
	(function () {
		// 这里写纯 JS 而非 TS 标注，是有原因的（踩过坑才写下来的）：
		//   1. Astro 把「带属性的 <script>」当成 is:inline（例如 <script lang="ts">），
		//      完全跳过处理，类型标注不会被转译，浏览器执行时直接 SyntaxError。
		//   2. astro check 又不认 lang="ts"，会把标注报成
		//      「Type annotations can only be used in TypeScript files」。
		// 两个方向都走不通，所以客户端脚本一律写纯 JS。
		const sheet = document.querySelector("[data-toc-sheet]");
		if (!sheet) return;
		let lastFocused = null;

		function open() {
			lastFocused = document.activeElement;
			sheet.classList.add("is-shown");
			// 触发一次 reflow 让过渡生效
			void sheet.offsetWidth;
			sheet.classList.add("is-open");
			document.body.style.overflow = "hidden";
		}

		function close() {
			sheet.classList.remove("is-open");
			document.body.style.overflow = "";
			setTimeout(() => {
				sheet.classList.remove("is-shown");
			}, 220);
			if (lastFocused) lastFocused.focus();
		}

		// 悬浮按钮（由文章页在窄屏时渲染）
		document.addEventListener("click", function (e) {
			// instanceof Element 让类型收窄，也让非元素目标（文本节点）安全跳过
			const t = e.target;
			if (!(t instanceof Element)) return;
			if (t.closest("[data-toc-open]")) {
				e.preventDefault();
				open();
			} else if (t.closest("[data-toc-close]")) {
				e.preventDefault();
				close();
			} else if (t.closest(".toc-sheet-item")) {
				// 点了某个章节，滚过去后把抽屉收起来
				close();
			}
		});

		document.addEventListener("keydown", function (e) {
			if (e.key === "Escape" && sheet.classList.contains("is-shown")) {
				close();
			}
		});
	})();

	/**
	 * 桌面端目录滚动高亮 + 指示条滑动。
	 *
	 * 两个关键点：
	 * 1. 可重复调用 —— TOC 在 #swup-container 内，swup 切页会替换这段 DOM。
	 *    只在模块顶层绑定一次的话，第二次进文章页就失效了。
	 * 2. 先解绑上一次的监听 —— 否则页面开久了会累积。
	 */
	let cleanupSpy = null;

	function initTocScrollSpy() {
		if (cleanupSpy) {
			cleanupSpy();
			cleanupSpy = null;
		}

		const links = document.querySelectorAll(".sb-toc__item[data-toc-link]");
		const tocBox = document.querySelector(".sb-toc");
		if (links.length === 0 || !tocBox) return;

		const map = new Map();
		links.forEach(function (link) {
			map.set(link.getAttribute("data-toc-link"), link);
		});

		const targets = [];
		map.forEach(function (_v, id) {
			const el = document.getElementById(id);
			if (el) targets.push(el);
		});
		if (targets.length === 0) return;

		let ticking = false;

		const update = function () {
			ticking = false;
			// 判定线：视口上沿往下 140px
			const offset = 140;
			let current = null;
			for (const target of targets) {
				if (target.getBoundingClientRect().top <= offset) {
					current = target;
				} else {
					break;
				}
			}

			// 滚到底部时强制高亮最后一项，否则长尾章节永远点不亮
			const atBottom =
				window.innerHeight + window.scrollY >=
				document.documentElement.scrollHeight - 4;
			if (atBottom) current = targets[targets.length - 1];

			map.forEach(function (link) {
				link.classList.remove("is-active");
			});
			if (!current) {
				tocBox.style.setProperty("--toc-indicator-opacity", "0");
				return;
			}

			const activeLink = map.get(current.id);
			activeLink.classList.add("is-active");

			// 指示条滑到当前项：用 translateY 而非 top，走合成层更顺
			const linkRect = activeLink.getBoundingClientRect();
			const boxRect = tocBox.getBoundingClientRect();
			const h = Math.max(12, linkRect.height - 6);
			tocBox.style.setProperty(
				"--toc-indicator-y",
				linkRect.top - boxRect.top + (linkRect.height - h) / 2 + "px",
			);
			tocBox.style.setProperty("--toc-indicator-height", h + "px");
			tocBox.style.setProperty("--toc-indicator-opacity", "1");
		};

		const onScroll = function () {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		};

		update();
		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", onScroll, { passive: true });

		cleanupSpy = function () {
			window.removeEventListener("scroll", onScroll);
			window.removeEventListener("resize", onScroll);
		};
	}

	initTocScrollSpy();
	document.addEventListener("astro:page-load", initTocScrollSpy);
</script>