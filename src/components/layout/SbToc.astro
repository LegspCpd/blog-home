---
/**
 * SbToc.astro —— 文章目录
 *
 * 两种形态共用同一份数据：
 *  - 桌面（≥1024px）：右侧 sticky 栏，跟着滚动高亮当前章节
 *  - 窄屏（<1024px）：收进底部抽屉，由左下角的「目录」按钮唤起
 *
 * 之前窄屏是直接 display:none，长文章在手机上完全没法跳转章节，
 * 这是个真实的可用性缺口。
 */
import { Icon } from "astro-icon/components";
import type { MarkdownHeading } from "astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const toc = headings
	.filter((h) => h.depth > 1 && h.depth <= 3)
	// 去掉 rehype-autolink-headings 注入的尾部锚点符号
	.map((h) => ({ ...h, text: h.text.replace(/#+\s*$/, "").trim() }));

const tocId = `toc-${toc.map((h) => h.slug).join("-").slice(0, 24)}`;
---

{
	toc.length > 0 && (
		<>
			<aside class="sb-toc-rail" aria-label="目录">
				<div class="sb-toc">
					<div class="sb-toc__title">本页目录</div>
					<nav class="sb-toc__nav">
						{toc.map((h) => (
							<a
								href={`#${h.slug}`}
								class:list={["sb-toc__item", `sb-toc__item--h${h.depth}`]}
								data-toc-link={h.slug}
							>
								{h.text}
							</a>
						))}
					</nav>
				</div>
			</aside>

			{/* 窄屏抽屉：默认隐藏，由 [data-toc-open] 唤起 */}
			<div class="toc-sheet" data-toc-sheet hidden>
				<button
					type="button"
					class="toc-sheet-backdrop"
					data-toc-close
					aria-label="关闭目录"
				/>
				<div
					class="toc-sheet-panel"
					role="dialog"
					aria-modal="true"
					aria-label="本页目录"
				>
					<div class="toc-sheet-head">
						<span class="toc-sheet-title">本页目录</span>
						<button
							type="button"
							class="toc-sheet-close"
							data-toc-close
							aria-label="关闭目录"
						>
							<Icon name="material-symbols:close" />
						</button>
					</div>
					<nav class="toc-sheet-list">
						{toc.map((h) => (
							<a
								href={`#${h.slug}`}
								class:list={[
									"toc-sheet-item",
									`toc-sheet-item--h${h.depth}`,
								]}
								data-toc-link={h.slug}
							>
								{h.text}
							</a>
						))}
					</nav>
				</div>
			</div>
		</>
	)
}

<style is:global>
	/* ---------- 桌面：右侧 sticky 栏 ---------- */
	.sb-toc-rail {
		position: sticky;
		top: calc(var(--su-header-height, 60px) + 24px);
		align-self: start;
		max-height: calc(100vh - var(--su-header-height, 60px) - 48px);
		overflow-y: auto;
	}

	.sb-toc {
		border-left: 1px solid var(--su-border);
		padding-left: 16px;
	}

	.sb-toc__title {
		font-size: 12px;
		font-weight: 500;
		color: var(--su-foreground);
		margin-bottom: 10px;
	}

	.sb-toc__nav {
		display: flex;
		flex-direction: column;
		gap: 1px;
	}

	.sb-toc__item {
		display: block;
		padding: 5px 0;
		font-size: 12.5px;
		line-height: 1.5;
		color: var(--su-muted-foreground);
		text-decoration: none;
		border-left: 2px solid transparent;
		padding-left: 10px;
		margin-left: -11px;
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}

	.sb-toc__item:hover {
		color: var(--su-foreground);
	}

	.sb-toc__item--h3 {
		padding-left: 22px;
		font-size: 12px;
	}

	.sb-toc__item.is-active {
		color: var(--su-foreground);
		font-weight: 500;
		border-left-color: var(--su-accent-text);
	}

	/* ---------- 窄屏：底部抽屉 ---------- */
	.toc-sheet {
		display: none;
	}

	@media (max-width: 1023px) {
		/* 桌面栏隐藏 */
		.sb-toc-rail {
			display: none;
		}

		.toc-sheet {
			display: block;
			position: fixed;
			inset: 0;
			z-index: 80;
		}

		.toc-sheet[hidden] {
			display: none;
		}

		.toc-sheet-backdrop {
			position: absolute;
			inset: 0;
			border: 0;
			padding: 0;
			background-color: rgba(20, 20, 18, 0.35);
			backdrop-filter: blur(2px);
			-webkit-backdrop-filter: blur(2px);
			opacity: 0;
			transition: opacity 0.18s ease;
			cursor: pointer;
		}

		.toc-sheet.is-open .toc-sheet-backdrop {
			opacity: 1;
		}

		/* 面板从底部滑入 */
		.toc-sheet-panel {
			position: absolute;
			inset: auto 0 0 0;
			max-height: 76vh;
			display: flex;
			flex-direction: column;
			border-top: 1px solid var(--su-border);
			border-radius: var(--su-radius-xl) var(--su-radius-xl) 0 0;
			background-color: var(--su-card);
			box-shadow: var(--su-shadow-3);
			transform: translateY(100%);
			transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1);
		}

		.toc-sheet.is-open .toc-sheet-panel {
			transform: translateY(0);
		}

		/* 面板顶部的小横条，暗示可以下拉关闭 */
		.toc-sheet-panel::before {
			content: "";
			position: absolute;
			top: 8px;
			left: 50%;
			transform: translateX(-50%);
			width: 36px;
			height: 4px;
			border-radius: 999px;
			background-color: var(--su-border);
		}

		.toc-sheet-head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 12px;
			padding: 20px var(--su-space-md) 12px;
			border-bottom: 1px solid var(--su-border);
		}

		.toc-sheet-title {
			font-size: 15px;
			font-weight: 600;
			color: var(--su-foreground);
		}

		.toc-sheet-close {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 30px;
			height: 30px;
			border: 0;
			border-radius: var(--su-radius-full);
			background-color: var(--su-muted);
			color: var(--su-muted-foreground);
			cursor: pointer;
		}

		.toc-sheet-list {
			flex: 1;
			min-height: 0;
			overflow-y: auto;
			overscroll-behavior: contain;
			padding: var(--su-space-xs) var(--su-space-sm) var(--su-space-lg);
		}

		.toc-sheet-item {
			display: block;
			/* 触摸目标不小于 44px */
			padding: 11px var(--su-space-sm);
			border-radius: var(--su-radius-sm);
			font-size: 14px;
			line-height: 1.5;
			color: var(--su-foreground);
			text-decoration: none;
		}

		.toc-sheet-item:active {
			background-color: var(--su-accent);
		}

		.toc-sheet-item--h3 {
			padding-left: var(--su-space-lg);
			font-size: 13px;
			color: var(--su-muted-foreground);
		}

		.toc-sheet-item.is-active {
			background-color: var(--su-primary-soft);
			color: var(--su-foreground);
			font-weight: 500;
		}
	}
</style>

<script>
	/**
	 * 窄屏目录抽屉：打开 / 关闭 / 点条目后自动收起 / Esc 关闭。
	 * 桌面端不受影响（.toc-sheet 在 ≥1024px 时是 display:none）。
	 */
	(function () {
		const el = document.querySelector<HTMLElement>("[data-toc-sheet]");
		if (!el) return;
		// 赋给常量后 TS 无法在闭包内保持收窄，用非空断言固定下来
		const sheet = el;
		let lastFocused: HTMLElement | null = null;

		function open() {
			lastFocused = document.activeElement as HTMLElement | null;
			sheet.hidden = false;
			// 触发一次 reflow 让过渡生效
			void sheet.offsetWidth;
			sheet.classList.add("is-open");
			document.body.style.overflow = "hidden";
		}

		function close() {
			sheet.classList.remove("is-open");
			document.body.style.overflow = "";
			setTimeout(() => {
				sheet.hidden = true;
			}, 220);
			lastFocused?.focus();
		}

		// 悬浮按钮（由文章页在窄屏时渲染）
		document.addEventListener("click", function (e) {
			const t = e.target as HTMLElement;
			if (t.closest("[data-toc-open]")) {
				e.preventDefault();
				open();
			} else if (t.closest("[data-toc-close]")) {
				e.preventDefault();
				close();
			} else if (t.closest(".toc-sheet-item")) {
				// 点了某个章节，滚过去后把抽屉收起来
				close();
			}
		});

		document.addEventListener("keydown", function (e) {
			if (e.key === "Escape" && !sheet.hidden) {
				close();
			}
		});
	})();
</script>