---
/**
 * SbPageHeader.astro
 * ---------------------------------------------------------------------------
 * 内页统一页头：标题 + 副标题，底部一条发丝线分区。
 * 已迁移到 su-* 令牌体系，不再依赖 supabase.css（--sb-*），
 * 因此侧栏布局无需再全局加载那份 CSS。
 */
interface Props {
	title: string;
	subtitle?: string;
	eyebrow?: string;
}

const { title, subtitle, eyebrow } = Astro.props;
---

<header class="su-page-header">
	<div class="su-page-header-main">
		{
			eyebrow ? (
				<span class="su-pill su-pill--outline su-page-header-eyebrow">
					{eyebrow}
				</span>
			) : null
		}
		<h1 class="su-display-lg su-page-header-title">{title}</h1>
		{subtitle ? <p class="su-body-md su-text-mute">{subtitle}</p> : null}
	</div>
	<slot />
</header>

<style>
	.su-page-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 16px 24px;
		flex-wrap: wrap;
		padding-bottom: 24px;
		margin-bottom: 32px;
		border-bottom: 1px solid var(--su-border);
	}

	.su-page-header-main {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.su-page-header-eyebrow {
		align-self: flex-start;
	}

	.su-page-header-title {
		margin: 0;
		letter-spacing: -0.6px;
	}

	@media (max-width: 640px) {
		.su-page-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 16px;
			padding-bottom: 20px;
			margin-bottom: 24px;
		}
	}
</style>