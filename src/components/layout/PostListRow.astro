---
/**
 * PostListRow.astro —— 列表页统一的文章行
 *
 * 归档、标签、分类三个页面原本各自定义了一套几乎相同的行样式
 * （.ar-row / .tag-row / .cat-row），改一处忘一处就会出现不一致。
 * 这里抽成共享组件，三处共用。
 */
import { Icon } from "astro-icon/components";

interface Props {
	/** 文章标题 */
	title: string;
	/** 链接 */
	href: string;
	/** 日期（已格式化的字符串） */
	date: string;
	/** ISO 日期，用于 <time datetime> */
	datetime: string;
	/** 分类（可选） */
	category?: string | null;
	/** 摘要（可选） */
	desc?: string;
	/** 标签（可选） */
	tags?: string[];
	/** 排序序号，显示在左侧 */
	rank?: number;
}

const { title, href, date, datetime, category, desc, tags = [], rank } =
	Astro.props;
---

<a class="su-card su-card--hover plr" href={href}>
	{
		rank !== undefined ? (
			<span class="plr-rank su-mono">{String(rank).padStart(2, "0")}</span>
		) : null
	}

	<span class="plr-date su-mono">
		<time datetime={datetime}>{date}</time>
	</span>

	<span class="plr-body">
		<span class="plr-head">
			<span class="plr-title">{title}</span>
			{category ? <span class="plr-cat">{category}</span> : null}
		</span>

		{desc ? <span class="plr-desc">{desc}</span> : null}

		{
			tags.length > 0 ? (
				<span class="plr-tags">
					{tags.slice(0, 4).map((tag) => (
						<span class="su-pill su-pill--outline">#{tag}</span>
					))}
				</span>
			) : null
		}
	</span>

	<Icon name="material-symbols:chevron-right" class="plr-arrow" />
</a>

<style>
	.plr {
		display: grid;
		/* 序号 / 日期 / 内容 / 箭头 */
		grid-template-columns: auto auto minmax(0, 1fr) auto;
		align-items: center;
		gap: var(--su-space-md);
		padding: var(--su-space-md) var(--su-space-lg);
		color: inherit;
		text-decoration: none;
	}

	.plr-rank {
		font-size: 12px;
		color: var(--su-ink-faint);
	}

	.plr-date {
		flex: none;
		width: 84px;
		font-size: 12.5px;
		color: var(--su-muted-foreground);
	}

	.plr-body {
		display: flex;
		flex-direction: column;
		gap: 6px;
		min-width: 0;
	}

	.plr-head {
		display: flex;
		align-items: baseline;
		gap: var(--su-space-sm);
		min-width: 0;
	}

	.plr-title {
		font-size: 16px;
		font-weight: 600;
		line-height: 1.4;
		letter-spacing: -0.2px;
		color: var(--su-foreground);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		transition: color 0.16s ease;
	}

	.plr:hover .plr-title {
		color: var(--su-accent-text);
	}

	/* 分类：品牌色的轻量承载 */
	.plr-cat {
		flex: none;
		font-size: 12px;
		font-weight: 500;
		color: var(--su-accent-text);
	}

	.plr-desc {
		font-size: 13.5px;
		line-height: 1.6;
		color: var(--su-muted-foreground);
		display: -webkit-box;
		-webkit-line-clamp: 1;
		line-clamp: 1;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.plr-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 5px;
		margin-top: 2px;
	}

	.plr-tags .su-pill {
		font-size: 11px;
		padding: 2px 8px;
	}

	/* 箭头：默认隐藏，悬停时从右侧滑入 */
	.plr-arrow {
		flex: none;
		font-size: 18px;
		color: var(--su-ink-faint);
		opacity: 0;
		transform: translateX(-4px);
		transition:
			opacity 0.16s ease,
			transform 0.16s ease,
			color 0.16s ease;
	}

	.plr:hover .plr-arrow {
		opacity: 1;
		transform: translateX(0);
		color: var(--su-accent-text);
	}

	@media (max-width: 640px) {
		.plr {
			/* 窄屏改成两行：序号+标题 / 日期+箭头 */
			grid-template-columns: auto minmax(0, 1fr) auto;
			gap: 4px 10px;
			padding: var(--su-space-sm) var(--su-space-md);
		}

		.plr-date {
			/* 日期移到第二行左侧 */
			order: 3;
			width: auto;
			grid-column: 1 / -1;
			padding-left: calc(1.5em + 10px);
			margin-top: 2px;
		}

		.plr-body {
			order: 1;
			grid-column: 2;
		}

		.plr-rank {
			order: 0;
		}

		.plr-arrow {
			order: 2;
			/* 手机无 hover，常驻显示 */
			opacity: 1;
			transform: none;
		}
	}
</style>
