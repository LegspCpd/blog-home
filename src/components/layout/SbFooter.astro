---
/**
 * SbFooter.astro —— 全站页脚
 *
 * 侧栏布局下作为 <main> 的兄弟节点渲染，因此不走 sb-container，
 * 宽度由 supabase-layout.css 的 .su-main > * 统一约束。
 * 样式全部使用 su-* 令牌。
 */
import { Icon } from "astro-icon/components";
import { profileConfig, siteConfig } from "@/config";
import { url } from "@/utils/url-utils";

const year = new Date().getFullYear();
const siteTitle = siteConfig.title || "LegspCpd Blog";

// 从 profileConfig 取社交链接，避免在两处重复维护
const socials = (profileConfig.links ?? [])
	.filter((l) => /^https?:/.test(l.url))
	.map((l) => ({ name: l.name, href: l.url, icon: l.icon }));

const columns: {
	title: string;
	links: { name: string; href: string; external?: boolean }[];
}[] = [
	{
		title: "内容",
		links: [
			{ name: "最新文章", href: "/" },
			{ name: "全部文章", href: "/posts/" },
			{ name: "归档", href: "/archive/" },
			{ name: "统计", href: "/stats/" },
			{ name: "项目", href: "/projects/" },
		],
	},
	{
		title: "互动",
		links: [
			{ name: "留言板", href: "/guestbook/" },
			{ name: "友链", href: "/friends/" },
			{ name: "联系我", href: "/contact/" },
			{ name: "RSS", href: "/rss.xml" },
		],
	},
	{
		title: "关于",
		links: [
			{ name: "关于我", href: "/about/" },
			{ name: "隐私政策", href: "/privacy/" },
			{ name: "站点源码", href: "https://github.com/LegspCpd/blog-home", external: true },
		],
	},
];
---

<footer class="sf">
	<div class="sf-grid">
		<!-- 品牌列 -->
		<div class="sf-brand">
			<a href={url("/")} class="sf-brand-name">
				{siteTitle}
				<span class="sf-dot" aria-hidden="true"></span>
			</a>
			<p class="sf-desc">{siteConfig.description}</p>

			{
				socials.length > 0 ? (
					<div class="sf-socials">
						{socials.map((s) => (
							<a
								href={s.href}
								target="_blank"
								rel="noopener noreferrer"
								class="su-btn su-btn--ghost su-btn--sm sf-social"
								aria-label={s.name}
								title={s.name}
							>
								<Icon name={s.icon} />
							</a>
						))}
					</div>
				) : null
			}
		</div>

		<!-- 链接列 -->
		{
			columns.map((col) => (
				<nav class="sf-col" aria-label={col.title}>
					<h2 class="sf-col-title">{col.title}</h2>
					<ul class="sf-col-list">
						{col.links.map((link) => (
							<li>
								<a
									href={
										link.external
											? link.href
											: url(link.href)
									}
									target={link.external ? "_blank" : undefined}
									rel={
										link.external
											? "noopener noreferrer"
											: undefined
									}
								>
									{link.name}
								</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}
	</div>

	<div class="sf-legal">
		<span>© {year} {siteTitle}</span>
		<span>
			由{" "}
			<a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
			驱动 · 部署于{" "}
			<a href="https://edgeone.ai/" target="_blank" rel="noopener noreferrer">EdgeOne Pages</a>
		</span>
	</div>
</footer>

<style is:global>
	.sf {
		margin-top: 64px;
		padding-top: 40px;
		padding-bottom: 32px;
		border-top: 1px solid var(--su-border);
		font-size: 13px;
		color: var(--su-muted-foreground);
	}

	/* ---- 栅格 ---- */
	.sf-grid {
		display: grid;
		grid-template-columns: 2fr repeat(3, minmax(0, 1fr));
		gap: 32px;
	}

	/* ---- 品牌列 ---- */
	.sf-brand-name {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 15px;
		font-weight: 600;
		color: var(--su-foreground);
		text-decoration: none;
	}

	/* 品牌名后的翠绿圆点，沿用导航栏的品牌语言 */
	.sf-dot {
		width: 6px;
		height: 6px;
		border-radius: var(--su-radius-full);
		background-color: var(--su-accent-text);
	}

	.sf-desc {
		margin: 10px 0 16px;
		max-width: 34ch;
		line-height: 1.6;
	}

	.sf-socials {
		display: flex;
		gap: 4px;
	}

	.sf-social {
		padding: 6px;
		min-height: 30px;
		font-size: 16px;
	}

	/* ---- 链接列 ---- */
	.sf-col-title {
		margin: 0 0 12px;
		font-size: 13px;
		font-weight: 600;
		color: var(--su-foreground);
	}

	.sf-col-list {
		display: flex;
		flex-direction: column;
		gap: 9px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sf-col-list a {
		color: var(--su-muted-foreground);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.sf-col-list a:hover {
		color: var(--su-accent-text);
	}

	/* ---- 底部法务行 ---- */
	.sf-legal {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 8px 20px;
		margin-top: 40px;
		padding-top: 20px;
		border-top: 1px solid var(--su-border);
		font-size: 12px;
		color: var(--su-ink-faint);
	}

	.sf-legal a {
		color: var(--su-muted-foreground);
		text-decoration: none;
	}

	.sf-legal a:hover {
		color: var(--su-accent-text);
	}

	/* ---- 响应式 ---- */
	@media (max-width: 1023px) {
		.sf-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 28px;
		}
		/* 品牌列在两列布局下占满整行 */
		.sf-brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 640px) {
		.sf-grid {
			grid-template-columns: 1fr;
			gap: 24px;
		}
		.sf-legal {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>