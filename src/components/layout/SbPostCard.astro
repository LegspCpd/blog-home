---
/**
 * SbPostCard.astro —— 文章卡片
 *
 * 用于首页最新文章、相关文章等场景。
 * 相比早期版本：常态带极淡投影，标题字重更高，元信息与摘要的层次更分明。
 */
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";

interface Props {
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	description: string;
	pinned?: boolean;
	password?: boolean;
	style?: string;
}

const {
	entry,
	title,
	url,
	published,
	tags = [],
	category,
	description,
	pinned,
	password,
	style,
} = Astro.props;

const { remarkPluginFrontmatter } = await render(entry);
const descriptionText = description || remarkPluginFrontmatter.excerpt || "";
const visibleTags = (tags || []).slice(0, 3);
const minutes = remarkPluginFrontmatter.minutes ?? 0;
---

<article class="su-card su-card--hover pc" style={style}>
	<a href={url} class="pc-link">
		<!-- 顶栏：置顶/分类 + 日期 -->
		<div class="pc-top">
			<span class="pc-meta">
				<time datetime={published.toISOString()} class="su-mono">
					{formatDateToYYYYMMDD(published)}
				</time>
				{
					category ? (
						<>
							<span class="pc-dot" aria-hidden="true" />
							<span class="pc-cat">{category}</span>
						</>
					) : null
				}
			</span>

			<span class="pc-badges">
				{password ? (
					<Icon
						name="material-symbols:lock-outline"
						class="pc-lock"
						title="需要密码"
					/>
				) : null}
				{pinned ? (
					<span class="su-pill su-pill--green pc-pin">
						<Icon name="material-symbols:push-pin" />
						置顶
					</span>
				) : null}
			</span>
		</div>

		<h2 class="pc-title">{title}</h2>

		{descriptionText ? <p class="pc-desc">{descriptionText}</p> : null}

		<!-- 底栏：标签 + 阅读时长 -->
		<div class="pc-foot">
			{
				visibleTags.length > 0 ? (
					<span class="pc-tags">
						{visibleTags.map((tag) => (
							<span class="su-pill su-pill--outline">#{tag.trim()}</span>
						))}
					</span>
				) : (
					<span />
				)
			}

			<span class="pc-read">
				{minutes > 0 ? `${minutes} 分钟` : "阅读"}
				<Icon name="material-symbols:arrow-right-alt" />
			</span>
		</div>
	</a>
</article>

<style>
	.pc {
		display: flex;
		height: 100%;
	}

	.pc-link {
		display: flex;
		flex-direction: column;
		width: 100%;
		gap: var(--su-space-sm);
		padding: var(--su-space-lg);
		color: inherit;
		text-decoration: none;
	}

	/* ---- 顶栏 ---- */
	.pc-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--su-space-sm);
		min-height: 22px;
	}

	.pc-meta {
		display: flex;
		align-items: center;
		gap: 7px;
		font-size: 12px;
		color: var(--su-muted-foreground);
	}

	.pc-meta .su-mono {
		font-size: 12px;
		color: var(--su-muted-foreground);
	}

	.pc-dot {
		width: 3px;
		height: 3px;
		border-radius: var(--su-radius-full);
		background-color: var(--su-ink-faint);
	}

	/* 分类：品牌色的轻量承载 */
	.pc-cat {
		font-weight: 550;
		color: var(--su-accent-text);
	}

	.pc-badges {
		display: flex;
		align-items: center;
		gap: 6px;
		flex: none;
	}

	.pc-lock {
		font-size: 15px;
		color: var(--su-ink-faint);
	}

	.pc-pin {
		font-family: var(--font-supabase);
	}

	/* ---- 标题 ---- */
	.pc-title {
		margin: 0;
		font-size: 19px;
		font-weight: 650;
		line-height: 1.38;
		letter-spacing: -0.3px;
		color: var(--su-foreground);
		transition: color 0.16s ease;
	}

	.pc:hover .pc-title {
		color: var(--su-accent-text);
	}

	/* ---- 摘要 ---- */
	.pc-desc {
		margin: 0;
		font-size: 14px;
		line-height: 1.65;
		color: var(--su-muted-foreground);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex-grow: 1;
	}

	/* ---- 底栏 ---- */
	.pc-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--su-space-sm);
		padding-top: var(--su-space-xs);
		margin-top: auto;
	}

	.pc-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 5px;
	}

	.pc-tags .su-pill {
		font-size: 11px;
		padding: 2px 8px;
	}

	/* 阅读提示：默认低调，悬停才显形 */
	.pc-read {
		display: inline-flex;
		align-items: center;
		gap: 2px;
		flex: none;
		font-size: 12.5px;
		font-weight: 550;
		color: var(--su-ink-faint);
		transition: color 0.16s ease;
	}

	.pc-read :global(svg) {
		font-size: 16px;
		transition: transform 0.16s ease;
	}

	.pc:hover .pc-read {
		color: var(--su-accent-text);
	}

	.pc:hover .pc-read :global(svg) {
		transform: translateX(2px);
	}
</style>
