---
/**
 * SbPostCard.astro
 * ---------------------------------------------------------------------------
 * 文章卡片：用于相关文章、精选文章等场景。
 * 已迁移到 su-* 令牌体系，不再依赖 supabase.css（--sb-*）。
 */
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";

interface Props {
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	description: string;
	pinned?: boolean;
	password?: boolean;
	style?: string;
}

const {
	entry,
	title,
	url,
	published,
	tags = [],
	category,
	description,
	pinned,
	password,
	style,
} = Astro.props;

const { remarkPluginFrontmatter } = await render(entry);
const descriptionText = description || remarkPluginFrontmatter.excerpt || "";
const visibleTags = (tags || []).slice(0, 3);
---

<article class="su-card su-card--hover su-post-card" style={style}>
	<a href={url} class="su-post-card-link">
		<!-- 元信息行 -->
		<div class="su-post-card-meta">
			<time datetime={published.toISOString()} class="su-mono">
				{formatDateToYYYYMMDD(published)}
			</time>
			{
				category ? (
					<>
						<span class="su-post-card-sep" aria-hidden="true">
							/
						</span>
						<span>{category}</span>
					</>
				) : null
			}
			{
				password ? (
					<span class="su-post-card-lock">
						<Icon name="material-symbols:lock-outline" />
					</span>
				) : null
			}
			{
				pinned ? (
					<span class="su-pill su-pill--green su-post-card-pinned">
						<Icon name="material-symbols:push-pin" />
						置顶
					</span>
				) : null
			}
		</div>

		<h2 class="su-post-card-title">{title}</h2>

		{descriptionText ? <p class="su-post-card-desc">{descriptionText}</p> : null}

		{
			visibleTags.length > 0 ? (
				<div class="su-post-card-tags">
					{visibleTags.map((tag) => (
						<span class="su-pill su-pill--outline">#{tag.trim()}</span>
					))}
				</div>
			) : null
		}

		<span class="su-post-card-more">
			阅读全文
			<Icon name="material-symbols:arrow-right-alt" />
		</span>
	</a>
</article>

<style>
	.su-post-card {
		display: flex;
		height: 100%;
	}

	.su-post-card-link {
		display: flex;
		flex-direction: column;
		width: 100%;
		gap: 12px;
		padding: 22px;
		color: inherit;
		text-decoration: none;
	}

	/* ---- 元信息 ---- */
	.su-post-card-meta {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 12px;
		color: var(--su-ink-faint);
		min-height: 20px;
	}

	.su-post-card-meta .su-mono {
		font-size: 12px;
		color: var(--su-muted-foreground);
	}

	.su-post-card-sep {
		color: var(--su-ink-faint);
	}

	.su-post-card-lock {
		display: inline-flex;
		align-items: center;
		font-size: 14px;
		color: var(--su-ink-faint);
	}

	.su-post-card-pinned {
		margin-left: auto;
		font-family: var(--font-supabase);
	}

	/* ---- 标题 ---- */
	.su-post-card-title {
		margin: 0;
		font-size: 19px;
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: -0.2px;
		color: var(--su-foreground);
		transition: color 0.15s ease;
	}

	.su-post-card:hover .su-post-card-title {
		color: var(--su-primary-deep);
	}

	/* ---- 摘要 ---- */
	.su-post-card-desc {
		margin: 0;
		font-size: 14px;
		line-height: 1.6;
		color: var(--su-muted-foreground);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex-grow: 1;
	}

	/* ---- 标签 ---- */
	.su-post-card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	/* ---- 阅读更多 ---- */
	.su-post-card-more {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		margin-top: auto;
		padding-top: 6px;
		font-size: 13px;
		font-weight: 500;
		color: var(--su-foreground);
		transition: color 0.15s ease;
	}

	.su-post-card:hover .su-post-card-more {
		color: var(--su-primary-deep);
	}
</style>