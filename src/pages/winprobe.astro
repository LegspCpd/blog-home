---
import Base from "../layouts/Base.astro";
import WinProbe from "../components/win/WinProbe.vue";
---

<Base title="Vue 探针" path="/winprobe/">
  <h1>Vue 集成探针</h1>

  <!--
    必须 client:only：WinUI 控件在 setup 里直接读 window 与主题资源
    （UseSystemFocusVisuals 等），SSR 阶段没有 window 会抛
    "window is not defined"，构建直接失败。
  -->
  <WinProbe client:only="vue" />

  <p>上面这段文字由 Astro 静态渲染，说明除 WinUI 组件外其余部分正常。</p>
</Base>