---
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import { commentConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import SupabaseLayout from "@/layouts/SupabaseLayout.astro";
import SbPageHeader from "@/components/layout/SbPageHeader.astro";

// 检查页面是否启用
if (!siteConfig.pages.guestbook) {
	return Astro.redirect("/404/");
}

const guestbookPost = await getEntry("spec", "guestbook");

if (!guestbookPost) {
	throw new Error("guestbook page content not found");
}

const { Content } = await render(guestbookPost);

// 检查评论系统是否启用
const isCommentEnabled = commentConfig?.type && commentConfig.type !== "none";

// 页面标题和描述
const title = i18n(I18nKey.guestbook);
const description = i18n(I18nKey.guestbookDescription);
---

<SupabaseLayout title={title} description={description}>
  <SbPageHeader eyebrow="Guestbook" title={title} subtitle={description} />

  <!-- 站点自定义内容（留言板说明） -->
  <section class="su-prose-page su-guestbook-intro">
    <Markdown class="">
      <Content />
    </Markdown>
  </section>

  <!-- 留言去向说明：避免访客以为留言是私密的 -->
  {
    isCommentEnabled ? (
      <aside class="su-note" aria-label="留言说明">
        <Icon name="material-symbols:info-outline" class="su-note-icon" />
        <div>
          <p class="su-body-sm">
            留言保存在 <strong>GitHub Discussions</strong>，公开可见、可被搜索引擎索引。
          </p>
          <p class="su-caption su-text-mute">
            使用 GitHub 账号登录即可留言，内容会同步显示在上方评论区。
          </p>
        </div>
      </aside>
    ) : null
  }

  <!-- 评论区 -->
  {
    isCommentEnabled ? (
      <Comment post={guestbookPost} customPath="/guestbook/" />
    ) : (
      <div class="su-card su-card--pad su-guestbook-empty">
        <span class="su-guestbook-empty-icon" aria-hidden="true">
          <Icon name="material-symbols:chat-bubble-outline" />
        </span>
        <h2 class="su-heading-md">{i18n(I18nKey.commentNotConfigured)}</h2>
        <p class="su-body-sm su-text-mute">{i18n(I18nKey.guestbookCommentHint)}</p>
      </div>
    )
  }
</SupabaseLayout>

<style>
	.su-guestbook-intro {
		max-width: none;
		margin-bottom: 32px;
	}

	.su-note {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		max-width: none;
		margin-bottom: 28px;
		padding: 16px 18px;
		border: 1px solid var(--su-border);
		border-radius: var(--su-radius-lg);
		background-color: var(--su-canvas-soft);
	}

	.su-note-icon {
		flex: none;
		margin-top: 1px;
		font-size: 18px;
		color: var(--su-accent-text);
	}

	.su-note p {
		margin: 0;
	}

	.su-note p + p {
		margin-top: 4px;
	}

	.su-guestbook-empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		text-align: center;
	}

	.su-guestbook-empty-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		border: 1px solid var(--su-border);
		border-radius: var(--su-radius-full);
		background-color: var(--su-muted);
		font-size: 24px;
		color: var(--su-muted-foreground);
	}
</style>