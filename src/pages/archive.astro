---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

// 按年月分组
const groups = new Map<string, typeof posts>();
for (const post of posts) {
  const d = post.data.published;
  const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(post);
}

const months = [...groups.entries()].sort((a, b) => b[0].localeCompare(a[0]));

const fmt = new Intl.DateTimeFormat("zh-CN", { month: "2-digit", day: "2-digit" });
---

<Base title="归档" path="/archive/">
  <h1 class="page-title">归档</h1>
  <p class="total">共 {posts.length} 篇文章</p>

  {
    months.map(([month, list]) => (
      <section class="month-group">
        <h2 class="month">{month}</h2>
        <ul class="list">
          {list.map((post) => (
            <li>
              <time class="day" datetime={post.data.published.toISOString()}>
                {fmt.format(post.data.published)}
              </time>
              <a href={`/posts/${post.id}/`}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  .page-title { margin-bottom: 4px; }
  .total {
    margin: 0 0 var(--spacingHorizontalXL);
    color: var(--colorNeutralForeground4);
    font-size: var(--fontSizeBase200);
  }

  .month-group { margin-bottom: var(--spacingHorizontalXL); }

  .month {
    margin-bottom: var(--spacingHorizontalM);
    padding-bottom: 6px;
    border-bottom: 1px solid var(--colorNeutralStroke1);
    font-size: var(--fontSizeBase400);
    color: var(--colorNeutralForeground2);
  }

  .list { margin: 0; padding: 0; list-style: none; }

  .list li {
    display: flex;
    gap: var(--spacingHorizontalL);
    padding: 7px 0;
    border-bottom: 1px solid var(--colorNeutralStroke1);
  }
  .list li:last-child { border-bottom: none; }

  .day {
    flex-shrink: 0;
    width: 48px;
    color: var(--colorNeutralForeground4);
    font-family: var(--fontFamilyMonospace);
    font-size: var(--fontSizeBase200);
  }

  .list a {
    color: var(--colorNeutralForeground2);
    text-decoration: none;
  }
  .list a:hover { color: var(--colorBrandForeground1); text-decoration: underline; }
</style>