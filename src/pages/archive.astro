---
import ArchivePanel from "@components/controls/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import SbPageHeader from "@/components/layout/SbPageHeader.astro";
import SupabaseShell from "@layouts/SupabaseShell.astro";
import { getSortedPostsList } from "@/utils/content-utils";

const sortedPostsList = await getSortedPostsList();
---

<SupabaseShell
  title={i18n(I18nKey.archive)}
  description="博客文章归档 - 按时间线浏览所有文章，涵盖技术、生活、学习等内容"
>
  <SbPageHeader
    eyebrow="Archive"
    title={i18n(I18nKey.archive)}
    subtitle={`共 ${sortedPostsList.length} 篇文章，按时间线浏览。`}
  />
  <ArchivePanel sortedPosts={sortedPostsList} client:only="svelte" />
</SupabaseShell>
