---
/**
 * categories/[category].astro —— 单个分类下的文章列表
 *
 * 与标签页同构：构建期枚举分类，生成静态路径，直链即正确内容。
 */
import { Icon } from "astro-icon/components";
import PostListRow from "@/components/layout/PostListRow.astro";
import SbPageHeader from "@/components/layout/SbPageHeader.astro";
import SupabaseLayout from "@/layouts/SupabaseLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getPostUrlBySlug, url } from "@/utils/url-utils";

export async function getStaticPaths() {
	const all = await getSortedPosts();
	const set = new Set<string>();
	for (const post of all) {
		const cat = post.data.category;
		if (cat && cat.trim()) set.add(cat.trim());
	}
	return [...set].map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const allPosts = await getSortedPosts();
const posts = allPosts.filter(
	(p) => (p.data.category ?? "").trim() === (category as string),
);

// 同分类下的其它分类
const siblingCount = new Map<string, number>();
for (const post of allPosts) {
	const cat = post.data.category;
	if (cat && cat.trim() && cat.trim() !== category) {
		siblingCount.set(cat.trim(), (siblingCount.get(cat.trim()) ?? 0) + 1);
	}
}
const siblings = [...siblingCount.entries()].sort((a, b) => b[1] - a[1]);
---

<SupabaseLayout
	title={category as string}
	description={`分类「${category}」下的全部文章，共 ${posts.length} 篇。`}
>
	<SbPageHeader
		eyebrow="Category"
		title={category as string}
		subtitle={`共 ${posts.length} 篇文章`}
	>
		<a href={url("/archive/")} class="su-btn su-btn--outline su-btn--sm">
			<Icon name="material-symbols:arrow-back" />
			返回归档
		</a>
	</SbPageHeader>

	{
		siblings.length > 0 ? (
			<nav class="cat-siblings" aria-label="其它分类">
				{siblings.map(([c, count]) => (
					<a
						href={url(`/categories/${encodeURIComponent(c)}/`)}
						class="su-pill su-pill--outline"
					>
						{c}
						<span class="cat-count">{count}</span>
					</a>
				))}
			</nav>
		) : null
	}

	<ul class="cat-list">
			{posts.map((post, i) => (
				<li class="rv">
					<PostListRow
						rank={i + 1}
						title={post.data.title}
						href={getPostUrlBySlug(post.id)}
						date={formatDateToYYYYMMDD(post.data.published)}
						datetime={post.data.published.toISOString()}
						category={post.data.category}
						desc={post.data.description}
						tags={post.data.tags ?? []}
					/>
				</li>
			))}
		</ul>
</SupabaseLayout>

<style>
	.cat-siblings {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		padding-bottom: 24px;
		margin-bottom: 8px;
		border-bottom: 1px solid var(--su-border);
	}

	.cat-siblings a {
		padding: 5px 11px;
		font-family: var(--font-supabase);
	}

	.cat-count {
		margin-left: 4px;
		font-family: var(--font-mono-supabase);
		font-size: 11px;
		color: var(--su-ink-faint);
	}

	.cat-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* 列表行样式已抽到 <PostListRow> 组件 */
	.cat-list {
		display: flex;
		flex-direction: column;
		gap: var(--su-space-2xs);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (max-width: 640px) {

	}
</style>