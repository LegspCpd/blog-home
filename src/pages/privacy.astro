---
import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import SbPageHeader from "@/components/layout/SbPageHeader.astro";
import SupabaseLayout from "@/layouts/SupabaseLayout.astro";
import { pagesConfig } from "@/config";
import { siteConfig } from "@/config/siteConfig";

const privacyPost = await getEntry("spec", "privacy");

if (!privacyPost) {
	throw new Error("privacy page content not found");
}

const { Content } = await render(privacyPost);

// 标题与描述来自 src/config/pagesConfig.ts 的 privacy 段
const { title: pageTitle, description } = pagesConfig.privacy;
---

<SupabaseLayout title={pageTitle} description={description}>
  <SbPageHeader
    eyebrow="法律条款"
    title={pageTitle}
    subtitle={description}
  >
    <p class="su-page-meta">
      <span class="su-text-mute su-mono">{siteConfig.title}</span>
      <span class="su-text-mute">·</span>
      <a class="su-link" href="/about/">返回关于我</a>
    </p>
  </SbPageHeader>

  <div class="su-prose-page">
    <div class="su-prose-body">
      <Markdown class="markdown-content">
        <Content />
      </Markdown>
    </div>
  </div>
</SupabaseLayout>

<style>
  .su-prose-page {
    max-width: 820px;
    margin-inline: auto;
  }

  .su-prose-body {
    font-size: 16px;
    line-height: 1.8;
    color: var(--su-ink);
  }

  .su-page-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    font-size: 13px;
    color: var(--su-ink-mute);
  }
</style>