---
import { Icon } from "astro-icon/components";
import SupabaseLayout from "@layouts/SupabaseLayout.astro";
import {
	projectStatusLabel,
	projectsConfig,
	getSortedProjects,
} from "@/config/projectsConfig";
import { resolveProjectIcons } from "@/utils/project-assets";

const { title, description, useBuildTimeFaviconProbe } = projectsConfig;

// 构建时解析图标：显式给了 icon 就直接用；只给了网站链接时推导 favicon
const projects = await resolveProjectIcons(getSortedProjects(), {
	probe: useBuildTimeFaviconProbe,
});

const statusCount = projects.reduce<Record<string, number>>((acc, item) => {
	if (item.status) acc[item.status] = (acc[item.status] ?? 0) + 1;
	return acc;
}, {});
---

<SupabaseLayout title={title} description={description}>
  <div class="su-projects">
    <header class="su-page-head">
      <p class="su-kicker">{title}</p>
      <h1 class="su-title">{title}</h1>
      <p class="su-page-desc">{description}</p>
      <p class="su-page-meta">
        <span class="su-num">{projects.length}</span> 个项目
        {
          Object.entries(statusCount).map(([status, count]) => (
            <>
              <span class="su-dot">·</span>
              <span class="su-num">
                {projectStatusLabel[status] ?? status} {count}
              </span>
            </>
          ))
        }
      </p>
    </header>

    {
      projects.length > 0 ? (
        <ul class="su-project-grid">
          {projects.map((project) => (
            <li>
              <a
                class="su-project"
                href={project.url}
                target={/^https?:/.test(project.url) ? "_blank" : undefined}
                rel={/^https?:/.test(project.url) ? "noopener noreferrer" : undefined}
              >
                <span class="su-project-icon">
                  <span class="su-project-initial" aria-hidden="true">
                    {project.name.slice(0, 1).toUpperCase()}
                  </span>
                  {project.iconSrc && (
                    <img
                      src={project.iconSrc}
                      alt=""
                      width="40"
                      height="40"
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                      onerror="this.remove()"
                    />
                  )}
                </span>

                <span class="su-project-body">
                  <span class="su-project-head">
                    <span class="su-project-name">{project.name}</span>
                    {project.status && (
                      <span class="su-project-status">
                        {projectStatusLabel[project.status] ?? project.status}
                      </span>
                    )}
                  </span>

                  <span class="su-project-desc">{project.desc}</span>

                  <span class="su-project-foot">
                    {project.tags && project.tags.length > 0 && (
                      <span class="su-project-tags">
                        {project.tags.map((tag) => (
                          <span class="su-project-tag">{tag}</span>
                        ))}
                      </span>
                    )}
                    <Icon
                      name="material-symbols:arrow-outward"
                      width="14"
                      height="14"
                      class="su-project-arrow"
                    />
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="su-projects-empty">
          还没有项目。编辑 <code>src/config/projectsConfig.ts</code> 的
          <code>items</code> 数组即可添加。
        </p>
      )
    }
  </div>
</SupabaseLayout>

<style>
  .su-projects {
    max-width: 1000px;
    margin-inline: auto;
  }

  .su-page-head {
    margin-bottom: 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--su-border);
  }

  .su-title {
    margin: 8px 0 12px;
  }

  .su-page-desc {
    margin: 0 0 16px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--su-muted-foreground);
  }

  .su-page-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 13px;
    color: var(--su-muted-foreground);
  }

  /* 项目卡片：细边框 + 12px 圆角，无阴影无渐变 */
  .su-project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .su-project {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    height: 100%;
    padding: 18px;
    border: 1px solid var(--su-border);
    border-radius: 12px;
    background-color: var(--su-card);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .su-project:hover {
    background-color: var(--su-accent);
    border-color: var(--su-muted-foreground);
  }

  .su-project-icon {
    position: relative;
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    overflow: hidden;
    border: 1px solid var(--su-border);
    border-radius: 8px;
    background-color: var(--su-background);
  }

  /* 首字母占位：图片加载失败被移除后自动露出 */
  .su-project-initial {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono-supabase);
    font-size: 16px;
    font-weight: 500;
    color: var(--su-muted-foreground);
  }

  .su-project-icon img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: var(--su-background);
  }

  .su-project-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    flex: 1;
  }

  .su-project-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .su-project-name {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--su-foreground);
    transition: color 0.15s ease;
  }

  .su-project:hover .su-project-name {
    color: var(--su-primary);
  }

  .su-project-status {
    flex: none;
    font-family: var(--font-mono-supabase);
    font-size: 11px;
    color: var(--su-muted-foreground);
  }

  .su-project-desc {
    font-size: 14px;
    line-height: 1.65;
    color: var(--su-muted-foreground);
  }

  .su-project-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 4px;
  }

  .su-project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .su-project-tag {
    font-family: var(--font-mono-supabase);
    font-size: 11px;
    color: var(--su-ink-faint);
  }

  .su-project-arrow {
    flex: none;
    margin-left: auto;
    color: var(--su-ink-faint);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .su-project:hover .su-project-arrow {
    opacity: 1;
  }

  .su-projects-empty {
    margin: 0;
    padding: 32px 0;
    font-size: 14px;
    line-height: 1.8;
    color: var(--su-muted-foreground);
  }

  .su-projects-empty code {
    padding: 2px 6px;
    border: 1px solid var(--su-border);
    border-radius: 4px;
    background-color: var(--su-muted);
    font-family: var(--font-mono-supabase);
    font-size: 13px;
    color: var(--su-foreground);
  }
</style>
