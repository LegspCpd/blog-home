---
import { Icon } from "astro-icon/components";
import PhotoCard from "@/components/pages/gallery/PhotoCard.astro";
import { galleryConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import SupabaseLayout from "@/layouts/SupabaseLayout.astro";
import { getAlbumCover, scanAlbumPhotos } from "@/utils/gallery-utils";

// 检查页面是否启用
if (!siteConfig.pages.gallery) {
	return Astro.redirect("/404/");
}

export function getStaticPaths() {
	return galleryConfig.albums.map((album) => ({
		params: { album: album.id },
	}));
}

const { album: albumId } = Astro.params;
const albumMeta = galleryConfig.albums.find((a) => a.id === albumId);

if (!albumMeta) {
	return Astro.redirect("/404/");
}

const photos = scanAlbumPhotos(albumMeta.id);
const cover = getAlbumCover(albumMeta, photos);
const columnWidth = galleryConfig.columnWidth || 240;
---

<SupabaseLayout title={albumMeta.name} description={albumMeta.description || ""}>
  <!-- 返回入口 -->
  <a href="/gallery/" class="su-backlink">
    <Icon name="material-symbols:arrow-back" />
    {i18n(I18nKey.galleryBackToAlbums)}
  </a>

  <!-- 封面横幅 -->
  {
    cover ? (
      <div class="album-hero">
        <img src={cover} alt={albumMeta.name} loading="eager" />
        <div class="album-hero-info">
          <h1 class="album-hero-name">{albumMeta.name}</h1>
          {albumMeta.description ? (
            <p class="album-hero-desc">{albumMeta.description}</p>
          ) : null}
        </div>
      </div>
    ) : (
      <h1 class="su-display-lg su-album-title">{albumMeta.name}</h1>
    )
  }

  <!-- 元信息 -->
  <ul class="album-meta">
    {albumMeta.date ? (
      <li>
        <Icon name="material-symbols:calendar-today" />
        <span>{albumMeta.date}</span>
      </li>
    ) : null}
    {albumMeta.location ? (
      <li>
        <Icon name="material-symbols:location-on" />
        <span>{albumMeta.location}</span>
      </li>
    ) : null}
    <li>
      <Icon name="material-symbols:photo-library" />
      <span>{photos.length} {i18n(I18nKey.galleryPhotos)}</span>
    </li>
  </ul>

  {
    albumMeta.tags && albumMeta.tags.length > 0 ? (
      <div class="su-page-tabs album-tags">
        {albumMeta.tags.map((tag) => (
          <span class="su-pill su-pill--outline">{tag}</span>
        ))}
      </div>
    ) : null
  }

  <!-- 瀑布流 -->
  {
    photos.length > 0 ? (
      <div
        class="gallery-masonry"
        style={`column-count: 2; column-gap: 12px; --col-width: ${columnWidth}px;`}
      >
        {photos.map((photo) => (
          <PhotoCard
            src={photo}
            albumId={albumMeta.id}
            alt={decodeURIComponent(
              photo
                .split("/")
                .pop()
                ?.replace(/\.[^.]+$/, "")
                ?.replace(/[_-]/g, " ") || albumMeta.name,
            )}
          />
        ))}
      </div>
    ) : (
      <div class="su-empty">
        <Icon name="material-symbols:photo-library" />
        <p class="su-body-md">{i18n(I18nKey.galleryNoAlbums)}</p>
      </div>
    )
  }
</SupabaseLayout>

<style>
  .su-backlink {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 20px;
    font-size: 14px;
    color: var(--su-muted-foreground);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .su-backlink:hover {
    color: var(--su-accent-text);
  }

  .su-backlink :global(svg) {
    font-size: 16px;
  }

  /* 封面横幅 */
  .album-hero {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 1;
    min-height: 200px;
    max-height: 360px;
    border: 1px solid var(--su-border);
    border-radius: var(--su-radius-lg);
    overflow: hidden;
  }

  .album-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .album-hero-info {
    position: absolute;
    inset: auto 0 0 0;
    padding: 24px;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.8),
      rgba(0, 0, 0, 0.35) 55%,
      transparent
    );
  }

  .album-hero-name {
    margin: 0;
    font-size: 30px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.42px;
    color: #ffffff;
  }

  .album-hero-desc {
    margin: 6px 0 0;
    max-width: 60ch;
    font-size: 14px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.8);
  }

  .su-album-title {
    margin-bottom: 16px;
  }

  /* 元信息行 */
  .album-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .album-meta li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--su-muted-foreground);
  }

  .album-meta :global(svg) {
    font-size: 15px;
  }

  .album-tags {
    margin-top: 12px;
  }

  /* 瀑布流：移动端两列，桌面按配置列宽 */
  .gallery-masonry {
    margin-top: 24px;
  }

  @media (min-width: 640px) {
    .gallery-masonry {
      column-width: var(--col-width, 240px) !important;
      column-count: auto !important;
    }
  }

  .su-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 64px 0;
    color: var(--su-muted-foreground);
  }

  .su-empty :global(svg) {
    font-size: 48px;
    opacity: 0.5;
  }
</style>
