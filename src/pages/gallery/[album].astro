---
import { Icon } from "astro-icon/components";
import PhotoCard from "@/components/pages/gallery/PhotoCard.astro";
import { galleryConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@i18n/translation";
import SupabaseLayout from "@/layouts/SupabaseLayout.astro";
import SbPageHeader from "@/components/layout/SbPageHeader.astro";
import { getAlbumCover, scanAlbumPhotos } from "@/utils/gallery-utils";

// 检查页面是否启用
if (!siteConfig.pages.gallery) {
	return Astro.redirect("/404/");
}

export function getStaticPaths() {
	return galleryConfig.albums.map((album) => ({
		params: { album: album.id },
	}));
}

const { album: albumId } = Astro.params;
const albumMeta = galleryConfig.albums.find((a) => a.id === albumId);

if (!albumMeta) {
	return Astro.redirect("/404/");
}

const photos = scanAlbumPhotos(albumMeta.id);
const cover = getAlbumCover(albumMeta, photos);
const columnWidth = galleryConfig.columnWidth || 240;
---

<SupabaseLayout title={albumMeta.name} description={albumMeta.description || ""}>
  <SbPageHeader
    title={albumMeta.name}
    subtitle={albumMeta.description}
  >
    <div class="flex flex-wrap gap-4 su-text-mute su-mono">
      {albumMeta.date && (
        <span class="inline-flex items-center gap-1">
          <Icon name="material-symbols:calendar-today" class="text-sm" />
          {albumMeta.date}
        </span>
      )}
      {albumMeta.location && (
        <span class="inline-flex items-center gap-1">
          <Icon name="material-symbols:location-on" class="text-sm" />
          {albumMeta.location}
        </span>
      )}
      <span class="inline-flex items-center gap-1">
        <Icon name="material-symbols:photo-library" class="text-sm" />
        {photos.length} {i18n(I18nKey.galleryPhotos)}
      </span>
    </div>
    <a href="/gallery/" class="su-btn su-btn--outline su-btn--sm">
      <Icon name="material-symbols:arrow-back" />
      {i18n(I18nKey.galleryBackToAlbums)}
    </a>
  </SbPageHeader>

  {cover && (
    <div class="relative aspect-[3/1] min-h-[200px] max-h-[360px] rounded-xl overflow-hidden mb-6">
      <img src={cover} alt={albumMeta.name} class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent" />
    </div>
  )}

  {albumMeta.tags && albumMeta.tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mb-4">
      {albumMeta.tags.map((tag) => (
        <span class="su-pill su-pill--outline">{tag}</span>
      ))}
    </div>
  )}

  <!-- 瀑布流照片网格 -->
  {photos.length > 0 ? (
    <div
      class="gallery-masonry"
      style={`column-count: 2; column-gap: 0.75rem; --col-width: ${columnWidth}px;`}
    >
      {photos.map((photo) => (
        <PhotoCard
          src={photo}
          albumId={albumMeta.id}
          alt={decodeURIComponent(photo.split('/').pop()?.replace(/\.[^.]+$/, '')?.replace(/[_-]/g, ' ') || albumMeta.name)}
        />
      ))}
    </div>
  ) : (
    <div class="su-prose-page text-center py-16 su-text-mute">
      <Icon name="material-symbols:photo-library" class="text-6xl mb-4 opacity-50" />
      <p class="su-body-lg">{i18n(I18nKey.galleryNoAlbums)}</p>
    </div>
  )}
</SupabaseLayout>

<style is:global>
  @media (min-width: 640px) {
    .gallery-masonry {
      column-width: var(--col-width, 240px) !important;
      column-count: auto !important;
    }
  }
</style>