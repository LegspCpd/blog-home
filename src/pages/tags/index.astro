---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/win/PostCard.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);

const tally = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) tally.set(t, (tally.get(t) ?? 0) + 1);

/* 按热度排序，再按词频分三档决定字号。
   看起来「乱」，其实完全由词频决定——规则藏在观感后面。 */
const tags = [...tally.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
);
const max = tags[0]?.[1] ?? 1;

/* 分档：>=0.6max 为大，>=0.3max 为中，其余为小 */
const band = (n: number) => (n / max >= 0.6 ? "lg" : n / max >= 0.3 ? "md" : "sm");
---

<Base title="标签" path="/tags/">
  <header class="head">
    <p class="eyebrow">索引</p>
    <h1 class="title">标签</h1>
    <p class="sub">
      共 <span class="num">{tags.length}</span> 个标签 /
      <span class="num">{posts.length}</span> 篇文章
    </p>
  </header>

  <nav class="cloud" aria-label="全部标签">
    {
      tags.map(([name, n]) => (
        <a class={`chip chip-${band(n)}`} href={`/tags/${encodeURIComponent(name)}/`}>
          {name}
          <sup>{n}</sup>
        </a>
      ))
    }
  </nav>

  <section class="latest">
    <span class="eyebrow">最新一篇</span>
    <PostCard post={posts[0]} slug={posts[0].id} hero />
  </section>
</Base>

<style>
  .head {
    max-width: 720px;
    margin-bottom: var(--s-xl);
  }

  .head .eyebrow {
    color: var(--c-faint);
    margin-bottom: var(--s-sm);
  }

  .title {
    font-size: clamp(30px, 5vw, 42px);
    letter-spacing: -1.6px;
    margin: 0 0 var(--s-sm);
  }

  .sub {
    margin: 0;
    color: var(--c-muted);
    font-size: 15px;
  }

  .num {
    color: var(--c-neon-volt);
    font-family: var(--mono);
    font-weight: 600;
  }

  /* ── 标签云：故意用基线对齐而不是居中，
     造成参差的「随性」——但每个词本身的字号是有规则的 */
  .cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-md) var(--s-lg);
    padding-bottom: var(--s-xl);
    margin-bottom: var(--s-xl);
    border-bottom: 1px solid var(--line-soft);
  }

  .chip {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    color: var(--c-muted);
    line-height: 1.25;
    transition:
      color var(--m-quick),
      transform var(--m-quick),
      text-shadow var(--m-quick);
  }

  .chip:hover {
    text-decoration: none;
    color: var(--c-neon-volt);
    transform: translateY(-3px) rotate(-1.2deg);
    text-shadow: 0 0 18px rgba(0, 229, 154, 0.45);
  }

  .chip:active {
    transform: translateY(0) scale(0.96);
    transition-duration: var(--m-snap);
  }

  /* 三档字号 —— 乱序的来源，但分档本身是规则的 */
  .chip-lg {
    font-size: 27px;
    font-weight: 600;
    letter-spacing: -0.8px;
  }
  .chip-md {
    font-size: 19px;
    font-weight: 550;
    letter-spacing: -0.4px;
  }
  .chip-sm {
    font-size: 14px;
    font-weight: 400;
  }

  .chip sup {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--c-faint);
    transition: color var(--m-quick);
  }

  .chip:hover sup {
    color: var(--c-neon-volt);
  }

  .latest .eyebrow {
    display: block;
    color: var(--c-faint);
    margin-bottom: var(--s-md);
  }

  @media (max-width: 640px) {
    .chip-lg {
      font-size: 22px;
    }
    .chip-md {
      font-size: 16px;
    }
  }
</style>
