---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/win/PostCard.astro";
import PageHeader from "../../components/win/PageHeader.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);

const tally = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) tally.set(t, (tally.get(t) ?? 0) + 1);

/* 按热度排序，再按词频分三档决定字号。
   看起来「乱」，其实完全由词频决定——规则藏在观感后面。 */
const tags = [...tally.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
);
const max = tags[0]?.[1] ?? 1;

---

<Base title="标签" path="/tags/">
  <!-- 页面名由 NavigationView 的 52px 页头承担（WinUI 的做法），
       正文只留统计信息，避免出现两个「标签」大标题。 -->
  <PageHeader title="标签" meta={`共 ${tags.length} 个标签 / ${posts.length} 篇文章`} />

  <nav class="cloud" aria-label="全部标签">
    {
      tags.map(([name, n]) => (
        <a class="chip" href={`/tags/${encodeURIComponent(name)}/`}>
          {name}
          <sup>{n}</sup>
        </a>
      ))
    }
  </nav>

  <section class="latest">
    <span class="eyebrow">最新一篇</span>
    <PostCard post={posts[0]} slug={posts[0].id} hero />
  </section>
</Base>

<style>
  .head {
    max-width: 720px;
    margin-bottom: var(--s-xl);
  }

  .head .eyebrow {
    color: var(--c-faint);
    margin-bottom: var(--s-sm);
  }

  .title {
    font-size: clamp(30px, 5vw, 42px);
    letter-spacing: -1.6px;
    margin: 0 0 var(--s-sm);
  }

  .lede {
    margin: 0;
    color: var(--c-muted);
    font-size: 15px;
  }

  .num {
    color: var(--c-neon-volt);
    font-family: var(--mono);
    font-weight: 600;
  }

  /* ── 标签云：故意用基线对齐而不是居中，
     造成参差的「随性」——但每个词本身的字号是有规则的 */
  /*
    标签云：WinUI 的 chip 组。
    原来是三档字号（27/19/14px）+ hover 旋转 + 发光 text-shadow ——
    那是上一版霓虹风格的做法，WinUI 里没有。现在统一成等大的 chip：
    4px 圆角、淡表面、1px 描边，hover 只叠一层更亮的填充。
    频次信息保留在右上角的小数字里，不再用字号表达。
  */
  .cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding-bottom: var(--s-xl);
    margin-bottom: var(--s-xl);
    border-bottom: 1px solid var(--line-soft);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid var(--line-base);
    border-radius: var(--r-sm);
    background: var(--c-s3);
    color: var(--c-body);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    transition:
      background var(--m-snap),
      border-color var(--m-snap),
      color var(--m-snap);
  }

  .chip:hover {
    text-decoration: none;
    color: var(--c-ink);
    background: var(--c-s2);
    border-color: var(--line-strong);
  }

  /* 频次做成 chip 内的小徽标，不参与字号变化 */
  .chip sup {
    font-family: var(--mono);
    font-size: 10.5px;
    font-variant-numeric: tabular-nums;
    color: var(--c-faint);
    transition: color var(--m-snap);
  }

  .chip:hover sup {
    color: var(--c-neon-volt);
  }

  .latest .eyebrow {
    display: block;
    color: var(--c-faint);
    margin-bottom: var(--s-md);
  }
  /*
    这里原来还有一段 @media (max-width: 640px) 覆写 .chip-lg / .chip-md 的字号。
    chip 改成一档字号之后那两个类已经没有任何元素在用，是死规则，删掉。
  */
</style>
