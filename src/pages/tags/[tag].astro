---
/**
 * tags/[tag].astro —— 单个标签下的文章列表
 *
 * 静态生成：标签集合在构建期即可确定，因此每个标签都是一条真实路径，
 * 直链 / 刷新 / 分享都能正确落到内容上，不依赖客户端读取 query。
 */
import { Icon } from "astro-icon/components";
import SbPageHeader from "@/components/layout/SbPageHeader.astro";
import SupabaseLayout from "@/layouts/SupabaseLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getPostUrlBySlug, url } from "@/utils/url-utils";

export async function getStaticPaths() {
	const all = await getSortedPosts();
	const tagSet = new Set<string>();
	for (const post of all) {
		for (const tag of post.data.tags ?? []) tagSet.add(tag);
	}
	return [...tagSet].map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const allPosts = await getSortedPosts();
const posts = allPosts.filter((p) => (p.data.tags ?? []).includes(tag as string));

// 同标签下的其它标签，方便横向跳转
const relatedTags = new Map<string, number>();
for (const post of posts) {
	for (const t of post.data.tags ?? []) {
		if (t !== tag) relatedTags.set(t, (relatedTags.get(t) ?? 0) + 1);
	}
}
const siblings = [...relatedTags.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12);
---

<SupabaseLayout
	title={`#${tag}`}
	description={`标签「${tag}」下的全部文章，共 ${posts.length} 篇。`}
>
	<SbPageHeader eyebrow="Tag" title={`#${tag}`} subtitle={`共 ${posts.length} 篇文章`}>
		<a href={url("/archive/")} class="su-btn su-btn--outline su-btn--sm">
			<Icon name="material-symbols:arrow-back" />
			返回归档
		</a>
	</SbPageHeader>

	{
		siblings.length > 0 ? (
			<nav class="tag-siblings" aria-label="相关标签">
				{siblings.map(([t, count]) => (
					<a
						href={url(`/tags/${encodeURIComponent(t)}/`)}
						class="su-pill su-pill--outline"
					>
						#{t}
						<span class="tag-count">{count}</span>
					</a>
				))}
			</nav>
		) : null
	}

	<ul class="tag-list">
		{
			posts.map((post) => (
				<li>
					<a class="tag-row rv" href={getPostUrlBySlug(post.id)}>
						<time
							class="tag-row-date su-mono"
							datetime={post.data.published.toISOString()}
						>
							{formatDateToYYYYMMDD(post.data.published)}
						</time>
						<span class="tag-row-body">
							<span class="tag-row-title">{post.data.title}</span>
							{post.data.description ? (
								<span class="tag-row-desc">{post.data.description}</span>
							) : null}
						</span>
						<Icon name="material-symbols:chevron-right" class="tag-row-arrow" />
					</a>
				</li>
			))
		}
	</ul>
</SupabaseLayout>

<style>
	.tag-siblings {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		padding-bottom: 24px;
		margin-bottom: 8px;
		border-bottom: 1px solid var(--su-border);
	}

	.tag-siblings a {
		padding: 5px 11px;
		font-family: var(--font-supabase);
	}

	.tag-count {
		margin-left: 4px;
		font-family: var(--font-mono-supabase);
		font-size: 11px;
		color: var(--su-ink-faint);
	}

	.tag-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tag-row {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 16px 4px;
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid var(--su-border);
		border-radius: var(--su-radius-sm);
		transition: background-color 0.15s ease;
	}

	.tag-row:hover {
		background-color: var(--su-canvas-soft);
	}

	.tag-row-date {
		flex: none;
		width: 92px;
		font-size: 13px;
		color: var(--su-ink-faint);
	}

	.tag-row-body {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.tag-row-title {
		font-size: 16px;
		font-weight: 500;
		line-height: 1.45;
		color: var(--su-foreground);
		transition: color 0.15s ease;
	}

	.tag-row:hover .tag-row-title {
		color: var(--su-primary-deep);
	}

	.tag-row-desc {
		font-size: 13px;
		line-height: 1.5;
		color: var(--su-muted-foreground);
		display: -webkit-box;
		-webkit-line-clamp: 1;
		line-clamp: 1;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.tag-row-arrow {
		flex: none;
		font-size: 18px;
		color: var(--su-ink-faint);
		opacity: 0;
		transform: translateX(-4px);
		transition:
			opacity 0.15s ease,
			transform 0.15s ease;
	}

	.tag-row:hover .tag-row-arrow {
		opacity: 1;
		transform: translateX(0);
	}

	@media (max-width: 640px) {
		.tag-row {
			flex-wrap: wrap;
			gap: 6px 12px;
		}
		.tag-row-date {
			width: auto;
		}
		.tag-row-arrow {
			display: none;
		}
	}
</style>