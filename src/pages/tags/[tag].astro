---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/win/PostCard.astro";
import PageHeader from "../../components/win/PageHeader.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);

  const tags = new Map<string, string[]>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      if (!tags.has(tag)) tags.set(tag, []);
      tags.get(tag)!.push(post.id);
    }
  }

  return [...tags.entries()].map(([tag, slugs]) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((p) => p.id && slugs.includes(p.id)),
    },
  }));
}

const { tag, posts } = Astro.props;
const sorted = [...posts].sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);

---

<Base title={`#${tag}`} path={`/tags/${encodeURIComponent(tag)}/`}>
  <nav class="crumb">
    <a href="/tags/">
      <span aria-hidden="true">←</span> 全部标签
    </a>
  </nav>

  <!--
    标签名由 NavigationView 的页头显示（页面通过 pageTitle 传 `#标签名` 上去），
    正文不再重复画一次大标题，只保留篇数与返回入口。
  -->
  <PageHeader title={tag} meta={`共 ${sorted.length} 篇`} />

  <!--
    这里原来给第一篇传了 hero={i === 0}。hero 会跨两列，
    而标签页通常只有两三篇 —— 结果就是第一张通栏、第二张半宽、
    右边空一大块。hero 是首页的"头版"版式，标签页是列表，不该用。
  -->
  <div class="post-grid">
    {sorted.map((post) => (
      <PostCard post={post} slug={post.id} />
    ))}
  </div>
</Base>

<style>
  .crumb {
    padding-top: var(--s-lg);
    margin-bottom: var(--s-lg);
  }

  .crumb a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 13px;
    border: 1px solid var(--line-base);
    border-radius: var(--r-pill);
    color: var(--c-muted);
    font-size: 13px;
    transition:
      color var(--m-quick),
      border-color var(--m-quick),
      background var(--m-quick),
      transform var(--m-quick);
  }

  .crumb a:hover {
    text-decoration: none;
    color: var(--c-ink);
    border-color: var(--line-strong);
    background: var(--c-s2);
    transform: translateY(-2px);
  }

  /* 这里原来有 .head / .title / .hash 三条规则（标题带情绪色辉光）。
     页面标题已经交给 PageHeader 组件，模板里不再有这些类 —— 是死 CSS，删掉。 */

  .lede {
    margin: 0;
    color: var(--c-muted);
    font-size: 14px;
  }

  .num {
    font-family: var(--mono);
    color: var(--c-ink);
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-md);
  }

  @media (max-width: 720px) {
    .post-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
