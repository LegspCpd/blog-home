---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/win/PostCard.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);

  const tags = new Map<string, string[]>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      if (!tags.has(tag)) tags.set(tag, []);
      tags.get(tag)!.push(post.id);
    }
  }

  return [...tags.entries()].map(([tag, slugs]) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((p) => p.id && slugs.includes(p.id)),
    },
  }));
}

const { tag, posts } = Astro.props;
const sorted = [...posts].sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
---

<Base title={`#${tag}`} path={`/tags/${encodeURIComponent(tag)}/`}>
  <nav class="crumb">
    <a href="/tags/">← 全部标签</a>
  </nav>

  <h1 class="page-title">#{tag}</h1>
  <p class="total">共 {sorted.length} 篇</p>

  <div class="post-list">
    {sorted.map((post) => (
      <PostCard post={post} slug={post.id} />
    ))}
  </div>
</Base>

<style>
  .crumb {
    margin-bottom: var(--spacingHorizontalM);
    font-size: var(--fontSizeBase200);
  }
  .crumb a {
    color: var(--colorNeutralForeground3);
    text-decoration: none;
  }
  .crumb a:hover { color: var(--colorBrandForeground1); }

  .page-title { margin-bottom: 4px; }
  .total {
    margin: 0 0 var(--spacingHorizontalXL);
    color: var(--colorNeutralForeground4);
    font-size: var(--fontSizeBase200);
  }

  .post-list { display: grid; gap: var(--spacingHorizontalL); }
</style>