---
import Base from "../layouts/Base.astro";
---

<Base title="appEntrypoint 探针" path="/appeprobe/">
  <h1>appEntrypoint 探针</h1>
  <pre
    id="err"
    style="background:#000;color:#0f0;font:12px monospace;padding:10px;white-space:pre-wrap"
  ></pre>

  <script>
    const out = document.getElementById("err");
    const log = (m) => (out.textContent += m + "\n");

    window.addEventListener("error", (e) => log("WIN " + e.message));
    window.addEventListener("unhandledrejection", (e) =>
      log("REJ " + (e.reason?.stack || e.reason))
    );

    try {
      // 直接执行 appEntrypoint 的内容，看是哪一行抛错。
      // 不能 import()：页面内联 script 的 import 不会被 Astro 处理。
      const vue = await import("vue");
      log("vue loaded, version=" + (vue.version || "?"));

      const app = vue.createApp({ render: () => vue.h("div") });
      log("app created");

      // 这里模拟 astro client.js 的 `await setup(app)`
      const mod = await import("/src/vue-app.js");
      log("vue-app.js loaded, default export type = " + typeof mod.default);

      await mod.default(app);
      log("setup(app) COMPLETED");

      const names = Object.keys(app._context.components || {});
      log("registered components: " + names.length);
      log("has NavigationView: " + names.includes("NavigationView"));
      log("has Button: " + names.includes("Button"));
      log("sample: " + names.slice(0, 10).join(", "));
    } catch (e) {
      log("THREW: " + (e?.stack || e));
    }
  </script>
</Base>