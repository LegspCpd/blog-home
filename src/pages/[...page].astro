---
/**
 * [...page].astro —— 文章分页列表（第 2 页起）
 *
 * 首页由 src/pages/index.astro 独占渲染，本路由只负责 /2/ /3/ …。
 * getStaticPaths 过滤掉第 1 页，避免两个页面争抢 `/` 路由。
 */
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import SbPageHeader from "@/components/layout/SbPageHeader.astro";
import SupabaseLayout from "@/layouts/SupabaseLayout.astro";
import { pagesConfig, siteConfig } from "@/config";
import { getSortedPosts } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getPostUrlBySlug, url } from "@utils/url-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	const pageSize = siteConfig.pagination.postsPerPage;

	const pages = paginate(allBlogPosts, {
		pageSize,
		props: { totalPosts: allBlogPosts.length },
	});

	// 首页已由 index.astro 渲染，这里剔除第 1 页
	return pages.filter((p) => {
		const key = String(p.params.page ?? "");
		// 首页在此配置下为空字符串，第 1 页为 "1"，两者都要排除
		return key !== "" && key !== "1";
	});
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const totalPosts = (page as { props?: { totalPosts?: number } }).props
	?.totalPosts as number;

const postList = pagesConfig.postList;

// 第 2 页时「上一页」应指向首页，而不是不存在的 /1/
const prevHref = page.url.prev === "/1/" ? url("/") : page.url.prev;
---

<SupabaseLayout title={`${postList.title} · 第 ${page.currentPage} 页`}>
	<SbPageHeader
		eyebrow={postList.kicker}
		title={postList.title}
		subtitle={`第 ${page.currentPage} / ${page.lastPage} 页 · 共 ${totalPosts} 篇文章`}
	>
		<nav class="su-page-tabs" aria-label="文章导航">
			<a class="su-pill su-pill--outline" href={url("/archive/")}>
				<Icon name="material-symbols:archive-outline" />
				按年份归档
			</a>
			<a class="su-pill su-pill--outline" href={url("/rss/")}>
				<Icon name="material-symbols:rss-feed" />
				RSS 订阅
			</a>
		</nav>
	</SbPageHeader>

	<ul class="pl-list">
		{
			page.data.map((entry) => (
				<li>
					<a class="pl-row" href={getPostUrlBySlug(entry.id)}>
						<time
							class="pl-row-date su-mono"
							datetime={entry.data.published.toISOString()}
						>
							{formatDateToYYYYMMDD(entry.data.published)}
						</time>
						<span class="pl-row-body">
							<span class="pl-row-title">{entry.data.title}</span>
							{entry.data.description ? (
								<span class="pl-row-desc">{entry.data.description}</span>
							) : null}
						</span>
						{entry.data.pinned ? (
							<span class="su-pill su-pill--green pl-row-pin">
								<Icon name="material-symbols:push-pin" />
								置顶
							</span>
						) : null}
						{entry.data.password ? (
							<Icon name="material-symbols:lock-outline" class="pl-row-lock" />
						) : null}
					</a>
				</li>
			))
		}
	</ul>

	{
		(page.url.prev || page.url.next) && (
			<nav class="pl-pager" aria-label="分页导航">
				{page.url.prev ? (
					<a class="su-btn su-btn--outline" href={prevHref}>
						<Icon name="material-symbols:chevron-left-rounded" />
						{postList.prevLabel}
					</a>
				) : (
					<span class="su-btn su-btn--outline" aria-disabled="true">
						<Icon name="material-symbols:chevron-left-rounded" />
						{postList.prevLabel}
					</span>
				)}

				<span class="su-num">
					{page.currentPage} / {page.lastPage}
				</span>

				{page.url.next ? (
					<a class="su-btn su-btn--outline" href={page.url.next}>
						{postList.nextLabel}
						<Icon name="material-symbols:chevron-right-rounded" />
					</a>
				) : (
					<span class="su-btn su-btn--outline" aria-disabled="true">
						{postList.nextLabel}
						<Icon name="material-symbols:chevron-right-rounded" />
					</span>
				)}
			</nav>
		)
	}
</SupabaseLayout>

<style>
	.pl-list {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--su-border);
	}

	.pl-list > li {
		border-bottom: 1px solid var(--su-border);
	}

	.pl-row {
		display: flex;
		align-items: baseline;
		gap: 16px;
		padding: 16px 4px;
		color: inherit;
		text-decoration: none;
		transition: background-color 0.15s ease;
	}

	.pl-row:hover {
		background-color: var(--su-canvas-soft);
	}

	.pl-row-date {
		flex: none;
		width: 96px;
		font-size: 13px;
		color: var(--su-ink-faint);
	}

	.pl-row-body {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.pl-row-title {
		font-size: 16px;
		font-weight: 500;
		line-height: 1.45;
		color: var(--su-foreground);
		transition: color 0.15s ease;
	}

	.pl-row:hover .pl-row-title {
		color: var(--su-primary-deep);
	}

	.pl-row-desc {
		font-size: 13px;
		line-height: 1.55;
		color: var(--su-muted-foreground);
		display: -webkit-box;
		-webkit-line-clamp: 1;
		line-clamp: 1;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.pl-row-pin {
		flex: none;
		font-family: var(--font-supabase);
	}

	.pl-row-lock {
		flex: none;
		font-size: 15px;
		color: var(--su-ink-faint);
	}

	.pl-pager {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: 32px;
	}

	@media (max-width: 640px) {
		.pl-row {
			flex-wrap: wrap;
			gap: 6px 12px;
			padding: 14px 0;
		}
		.pl-row-date {
			width: auto;
			order: 2;
		}
		.pl-row-body {
			flex-basis: 100%;
			order: 1;
		}
		.pl-row-pin,
		.pl-row-lock {
			order: 3;
		}
	}
</style>
