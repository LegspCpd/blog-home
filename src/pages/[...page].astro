---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import SbPageHeader from "@/components/layout/SbPageHeader.astro";
import SupabaseShell from "@/layouts/SupabaseShell.astro";
import { pagesConfig, siteConfig } from "@/config";
import { profileConfig } from "@/config/profileConfig";
import { getSortedPosts } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getPostUrlBySlug } from "@utils/url-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	const pageSize = siteConfig.pagination.postsPerPage;
	// Generate all pages, then filter out page 1 (handled by index.astro)
	const allPages = paginate(allBlogPosts, {
		pageSize,
		props: {
			totalPosts: allBlogPosts.length,
		},
	});
	// Skip page 1 (currentPage === 1)
	return allPages.filter((p) => p.params.page !== "1");
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const latestPosts = page.data;

// ===================================================================
// 文章列表的文案 / 卡片 / 阈值全部来自 src/config/pagesConfig.ts
// ===================================================================
const postList = pagesConfig.postList;
---

<SupabaseShell>
  <SbPageHeader
    eyebrow={postList.kicker}
    title={postList.title}
    subtitle={`第 {page.currentPage} / {page.lastPage} 页 · 共 {totalPosts} 篇`}
  >
    <div class="sb-page-tabs">
      <a class="sb-pill sb-pill--outline" href="/archive/">按年份归档</a>
      <a class="sb-pill sb-pill--outline" href="/rss/">RSS 订阅</a>
    </div>
  </SbPageHeader>

  <div class="sb-prose-page">
    <ul class="sb-list">
      {page.data.map((entry) => (
        <li>
          <a class="sb-row" href={getPostUrlBySlug(entry.id)}>
            <time class="sb-row-date sb-mono" datetime={entry.data.published.toISOString()}>
              {formatDateToYYYYMMDD(entry.data.published)}
            </time>
            <span class="sb-row-title">{entry.data.title}</span>
          </a>
        </li>
      ))}
    </ul>

    {(page.url.prev || page.url.next) && (
      <nav class="sb-pager" aria-label="分页导航">
        {page.url.prev ? (
          <a class="sb-btn sb-btn--outline" href={page.url.prev}>
            <Icon name="material-symbols:chevron-left-rounded" width="16" height="16" />
            {postList.prevLabel}
          </a>
        ) : (
          <span class="sb-btn sb-btn--outline" aria-disabled="true">
            <Icon name="material-symbols:chevron-left-rounded" width="16" height="16" />
            {postList.prevLabel}
          </span>
        )}
        <span class="sb-text-mute sb-mono">
          {page.currentPage} / {page.lastPage}
        </span>
        {page.url.next ? (
          <a class="sb-btn sb-btn--outline" href={page.url.next}>
            {postList.nextLabel}
            <Icon name="material-symbols:chevron-right-rounded" width="16" height="16" />
          </a>
        ) : (
          <span class="sb-btn sb-btn--outline" aria-disabled="true">
            {postList.nextLabel}
            <Icon name="material-symbols:chevron-right-rounded" width="16" height="16" />
          </span>
        )}
      </nav>
    )}
  </div>
</SupabaseShell>

<style>
  .sb-prose-page {
    max-width: 800px;
    margin-inline: auto;
  }

  .sb-page-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .sb-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--sb-hairline);
  }

  .sb-list > li {
    border-top: 1px solid var(--sb-hairline);
  }

  .sb-list > li:first-child {
    border-top: 0;
  }

  .sb-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 0;
    text-decoration: none;
    color: inherit;
  }

  .sb-row-date {
    font-size: 13px;
    color: var(--sb-ink-mute);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .sb-row-title {
    flex: 1;
    min-width: 0;
    color: var(--sb-ink);
    transition: color 0.15s ease;
  }

  .sb-row:hover .sb-row-title {
    color: var(--sb-primary);
  }

  .sb-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 48px;
  }
</style>