---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import { profileConfig } from "@/config/profileConfig";
import SupabaseLayout from "@/layouts/SupabaseLayout.astro";
import SiteAvatar from "@components/common/SiteAvatar.astro";
import { getSortedPosts } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getPostUrlBySlug, url } from "@utils/url-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	const pageSize = siteConfig.pagination.postsPerPage;
	// 首页统计所需数据，仅通过 props 传入，不新增/修改任何路由
	return paginate(allBlogPosts, {
		pageSize,
		props: {
			totalPosts: allBlogPosts.length,
		},
	});
}) satisfies GetStaticPaths;

const { page, totalPosts = 0 } = Astro.props;

// 第 1 页 = 个人主页（只有简介 + 入口）；第 2 页起 = 文章列表
const isHomePage = page.currentPage === 1;

const latestPosts = page.data;
const lastUpdated =
	latestPosts[0]?.data.updated ?? latestPosts[0]?.data.published;
const socialLinks = profileConfig.links ?? [];
const isExternal = (href: string) => /^(https?:|mailto:)/.test(href);

// ===================================================================
// 首页三张卡片：按需直接改这里（图标只能取 astro.config 里已注册的图标集）
// ===================================================================
const homeHighlights = [
	{
		icon: "material-symbols:edit-note-outline",
		title: "写作 / 教程",
		text: "把踩过的坑整理成能按步骤复现的教程，而不是只可远观的结论。",
	},
	{
		icon: "material-symbols:dns-outline",
		title: "自部署 / 服务",
		text: "维护自托管服务与 Macro / API 接口，能自己拿在手里的就不交出去。",
	},
	{
		icon: "material-symbols:bolt-outline",
		title: "边缘 / CDN 优选",
		text: "Cloudflare、EdgeOne 优选与边缘部署，让国内访问不再是减速器。",
	},
];
---

{
  isHomePage ? (
    <SupabaseLayout>
      <div class="su-home">
        <!-- ① 主视觉：一句话主张 + 两个清晰入口 -->
        <header class="su-hero">
          <p class="su-kicker">{siteConfig.title}</p>
          <h1 class="su-hero-title">{profileConfig.bio}</h1>
          <p class="su-hero-lead">{siteConfig.description}</p>

          <div class="su-hero-actions">
            <a class="su-btn is-primary" href={url("/posts/")}>
              查看文章
              <Icon name="material-symbols:arrow-forward" width="14" height="14" />
            </a>
            <a class="su-btn" href={url("/about/")}>
              关于我
              <Icon name="material-symbols:arrow-outward" width="14" height="14" />
            </a>
          </div>
        </header>

        <!-- ② 个人名片：头像 + 名字 + 一句签名 -->
        <section class="su-profile su-card" aria-label="个人名片">
          <SiteAvatar size={56} alt={profileConfig.name} />
          <div class="su-profile-text">
            <p class="su-profile-name">{profileConfig.name}</p>
            <p class="su-profile-role">写教程 · 自部署 · 折腾边缘</p>
          </div>
        </section>

        <!-- ③ 三张卡片：写作 / 自部署 / 边缘加速（内容来自本站真实主题） -->
        <section class="su-home-section" aria-labelledby="su-highlights-title">
          <div class="su-section-head">
            <h2 id="su-highlights-title" class="su-section-title">
              小而清晰，先把每一次打开做好
            </h2>
            <p class="su-section-desc">
              统一的版式、克制的配色、能按步骤复现的内容 —— 其余的交给速度。
            </p>
          </div>

          <ul class="su-highlight-grid">
            {homeHighlights.map((item) => (
              <li class="su-card su-highlight">
                <span class="su-highlight-icon" aria-hidden="true">
                  <Icon name={item.icon} width="16" height="16" />
                </span>
                <h3 class="su-highlight-title">{item.title}</h3>
                <p class="su-highlight-text">{item.text}</p>
              </li>
            ))}
          </ul>
        </section>

        <!-- ④ 社交链接 -->
        <section class="su-home-section" aria-labelledby="su-social-title">
          <h2 id="su-social-title" class="su-section-title">社交链接</h2>
          <nav class="su-social" aria-label="社交链接">
            {socialLinks.map((link) => (
              <a
                href={isExternal(link.url) ? link.url : url(link.url)}
                target={/^https?:/.test(link.url) ? "_blank" : undefined}
                rel={/^https?:/.test(link.url) ? "noopener noreferrer" : undefined}
                class="su-social-link"
              >
                <Icon name={link.icon} width="14" height="14" />
                {link.name}
              </a>
            ))}
          </nav>
        </section>

        <footer class="su-home-footer">
          <p class="su-home-stats">
            共 <span class="su-num">{totalPosts}</span> 篇文章
            {lastUpdated && (
              <>
                {" · 最近更新 "}
                <time class="su-num" datetime={lastUpdated.toISOString()}>
                  {formatDateToYYYYMMDD(lastUpdated)}
                </time>
              </>
            )}
          </p>

          <!-- 站点级入口：一眼能看到（含服务条款与隐私政策） -->
          <nav class="su-home-legal" aria-label="站点信息">
            <a href={url("/privacy/")}>服务条款与隐私政策</a>
            <span class="su-dot">·</span>
            <a href={url("/about/")}>关于我</a>
            <span class="su-dot">·</span>
            <a href={url("/rss/")}>RSS 订阅</a>
            <span class="su-dot">·</span>
            <a href={url("/guestbook/")}>留言板</a>
          </nav>
        </footer>
      </div>
    </SupabaseLayout>
  ) : (
    <SupabaseLayout>
      <div class="su-list-page">
        <header class="su-page-head">
          <p class="su-kicker">文章</p>
          <h1 class="su-title">全部文章</h1>
          <p class="su-page-desc">
            第 <span class="su-num">{page.currentPage}</span> /{" "}
            <span class="su-num">{page.lastPage}</span> 页 · 共{" "}
            <span class="su-num">{totalPosts}</span> 篇
          </p>
        </header>

        <ul class="su-list">
          {page.data.map((entry) => (
            <li>
              <a class="su-row" href={getPostUrlBySlug(entry.id)}>
                <time class="su-row-date" datetime={entry.data.published.toISOString()}>
                  {formatDateToYYYYMMDD(entry.data.published)}
                </time>
                <span class="su-row-title">{entry.data.title}</span>
              </a>
            </li>
          ))}
        </ul>

        {(page.url.prev || page.url.next) && (
          <nav class="su-pager" aria-label="分页导航">
            {page.url.prev ? (
              <a class="su-btn" href={page.url.prev}>
                <Icon name="material-symbols:chevron-left-rounded" width="16" height="16" />
                上一页
              </a>
            ) : (
              <span class="su-btn" aria-disabled="true">
                <Icon name="material-symbols:chevron-left-rounded" width="16" height="16" />
                上一页
              </span>
            )}
            <span class="su-num">
              {page.currentPage} / {page.lastPage}
            </span>
            {page.url.next ? (
              <a class="su-btn" href={page.url.next}>
                下一页
                <Icon name="material-symbols:chevron-right-rounded" width="16" height="16" />
              </a>
            ) : (
              <span class="su-btn" aria-disabled="true">
                下一页
                <Icon name="material-symbols:chevron-right-rounded" width="16" height="16" />
              </span>
            )}
          </nav>
        )}
      </div>
    </SupabaseLayout>
  )
}

<style>
  /* ── 首页 ─────────────────────────────────────────────── */
  .su-home {
    position: relative;
    isolation: isolate;
    max-width: 800px;
    margin-inline: auto;
  }

  /*
    Subtle texture: a monochrome dot lattice behind the hero, masked to fade out
    before the cards. Greys only (var(--su-border) on the near-black canvas) — no
    colour, no gradient wash, no glassmorphism. Confined to the content column so
    it can never cause horizontal overflow.
  */
  .su-home::before {
    content: "";
    position: absolute;
    z-index: 0;
    top: -64px;
    right: 0;
    left: 0;
    height: 560px;
    pointer-events: none;
    background-image: radial-gradient(
      circle at 1px 1px,
      var(--su-border) 1px,
      transparent 0
    );
    background-size: 24px 24px;
    opacity: 0.5;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 80%);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 80%);
  }

  /* keep every real block above the texture */
  .su-home > * {
    position: relative;
    z-index: 1;
  }

  /* ── ① 主视觉 ───────────────────────────────────────── */
  .su-hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .su-hero .su-kicker {
    margin: 0 0 20px;
  }

  /* display-xl 48px / 500 / 1.1 / -1.44px（移动端降到 display-lg 36px） */
  .su-hero-title {
    margin: 0;
    max-width: 620px;
    font-size: 48px;
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: -1.44px;
    color: var(--su-foreground);
    text-wrap: balance;
  }

  /* body-lg 18px / 400 / 1.55 */
  .su-hero-lead {
    max-width: 560px;
    margin: 20px 0 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--su-muted-foreground);
  }

  .su-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 36px;
  }

  /* ── ② 个人名片（12px 圆角 + 1px 细边框，无阴影） ─────── */
  .su-profile {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 56px;
    padding: 24px 28px;
  }

  .su-profile-text {
    min-width: 0;
  }

  /* heading-md 18px / 500 / 1.4 */
  .su-profile-name {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--su-foreground);
  }

  /* caption 13px / 400 / 1.45 */
  .su-profile-role {
    margin: 4px 0 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--su-muted-foreground);
  }

  /* ── ③④ 分区：80px 上留白 + 一道 hairline ─────────────── */
  .su-home-section {
    margin-top: 80px;
    padding-top: 40px;
    border-top: 1px solid var(--su-border);
  }

  .su-section-head {
    margin-bottom: 28px;
  }

  /* body-md 16px / 400 / 1.5 */
  .su-section-desc {
    max-width: 560px;
    margin: 8px 0 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--su-muted-foreground);
  }

  .su-highlight-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .su-highlight {
    padding: 24px;
    transition: border-color 0.15s ease;
  }

  .su-highlight:hover {
    border-color: var(--su-muted-foreground);
  }

  .su-highlight-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--su-border);
    border-radius: 6px;
    color: var(--su-muted-foreground);
    transition: color 0.15s ease;
  }

  /* 绿色只在悬停时出现，保持强调色稀缺 */
  .su-highlight:hover .su-highlight-icon {
    color: var(--su-primary);
  }

  .su-highlight-title {
    margin: 16px 0 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--su-foreground);
  }

  .su-highlight-text {
    margin: 8px 0 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--su-muted-foreground);
  }

  /* ── 社交链接 ──────────────────────────────────────── */
  .su-social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 24px;
    margin-top: 24px;
  }

  .su-social-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--su-muted-foreground);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .su-social-link:hover {
    color: var(--su-primary);
  }

  /* 页脚：最后一个分区，hairline 之上 96px、之下 32px */
  .su-home-footer {
    margin-top: 96px;
    padding: 32px 0 8px;
    border-top: 1px solid var(--su-border);
  }

  .su-home-stats {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--su-muted-foreground);
  }

  .su-home-stats a {
    color: var(--su-foreground);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .su-home-stats a:hover {
    color: var(--su-primary);
  }

  /* 底部站点入口：一行常显，克制 */
  .su-home-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    font-size: 13px;
  }

  .su-home-legal a {
    color: var(--su-muted-foreground);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .su-home-legal a:hover {
    color: var(--su-primary);
  }

  /* ── 列表页 ───────────────────────────────────────────── */
  .su-list-page {
    max-width: 800px;
    margin-inline: auto;
  }

  .su-list-page .su-list {
    border-top: 1px solid var(--su-border);
  }

  .su-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 48px;
  }

  /* 移动端：display 从 48px 降到 36px（DESIGN-supabase 响应式约定） */
  @media (max-width: 767px) {
    .su-hero-title {
      font-size: 36px;
      letter-spacing: -0.72px;
    }
  }
</style>
