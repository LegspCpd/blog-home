---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import { profileConfig } from "@/config/profileConfig";
import SupabaseLayout from "@/layouts/SupabaseLayout.astro";
import SiteAvatar from "@components/common/SiteAvatar.astro";
import { getSortedPosts } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getPostUrlBySlug, url } from "@utils/url-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	const pageSize = siteConfig.pagination.postsPerPage;
	// 首页统计所需数据，仅通过 props 传入，不新增/修改任何路由
	return paginate(allBlogPosts, {
		pageSize,
		props: {
			totalPosts: allBlogPosts.length,
		},
	});
}) satisfies GetStaticPaths;

const { page, totalPosts = 0 } = Astro.props;

// 第 1 页 = 个人主页（只有简介 + 入口）；第 2 页起 = 文章列表
const isHomePage = page.currentPage === 1;

const latestPosts = page.data;
const lastUpdated =
	latestPosts[0]?.data.updated ?? latestPosts[0]?.data.published;
const socialLinks = profileConfig.links ?? [];
const isExternal = (href: string) => /^(https?:|mailto:)/.test(href);
---

{
  isHomePage ? (
    <SupabaseLayout>
      <div class="su-home">
        <header class="su-home-intro">
          <!-- 站点头像：块级独占一行，无基线位移 -->
          <div class="su-home-avatar">
            <SiteAvatar size={56} alt={profileConfig.name} />
          </div>
          <p class="su-kicker">{profileConfig.bio}</p>
          <h1 class="su-home-name">{profileConfig.name}</h1>
          <p class="su-home-desc">{siteConfig.description}</p>
          <nav class="su-home-links" aria-label="社交链接">
            {socialLinks.map((link) => (
              <a
                href={isExternal(link.url) ? link.url : url(link.url)}
                target={/^https?:/.test(link.url) ? "_blank" : undefined}
                rel={/^https?:/.test(link.url) ? "noopener noreferrer" : undefined}
                class="su-home-link"
              >
                <Icon name={link.icon} width="14" height="14" />
                {link.name}
              </a>
            ))}
          </nav>

          <!-- 主入口：一个克制的 CTA + 一个文字链接，不做按钮堆砌 -->
          <div class="su-home-actions">
            <a class="su-btn is-primary" href={url("/posts/")}>
              查看文章
              <Icon name="material-symbols:arrow-forward" width="14" height="14" />
            </a>
            <a class="su-home-more" href={url("/about/")}>关于我 →</a>
          </div>
        </header>

        <footer class="su-home-footer">
          <p class="su-home-stats">
            共 <span class="su-num">{totalPosts}</span> 篇文章
            {lastUpdated && (
              <>
                {" · 最近更新 "}
                <time class="su-num" datetime={lastUpdated.toISOString()}>
                  {formatDateToYYYYMMDD(lastUpdated)}
                </time>
              </>
            )}
          </p>

          <!-- 站点级入口：一眼能看到（含服务条款与隐私政策） -->
          <nav class="su-home-legal" aria-label="站点信息">
            <a href={url("/privacy/")}>服务条款与隐私政策</a>
            <span class="su-dot">·</span>
            <a href={url("/about/")}>关于我</a>
            <span class="su-dot">·</span>
            <a href={url("/rss/")}>RSS 订阅</a>
            <span class="su-dot">·</span>
            <a href={url("/guestbook/")}>留言板</a>
          </nav>
        </footer>
      </div>
    </SupabaseLayout>
  ) : (
    <SupabaseLayout>
      <div class="su-list-page">
        <header class="su-page-head">
          <p class="su-kicker">文章</p>
          <h1 class="su-title">全部文章</h1>
          <p class="su-page-desc">
            第 <span class="su-num">{page.currentPage}</span> /{" "}
            <span class="su-num">{page.lastPage}</span> 页 · 共{" "}
            <span class="su-num">{totalPosts}</span> 篇
          </p>
        </header>

        <ul class="su-list">
          {page.data.map((entry) => (
            <li>
              <a class="su-row" href={getPostUrlBySlug(entry.id)}>
                <time class="su-row-date" datetime={entry.data.published.toISOString()}>
                  {formatDateToYYYYMMDD(entry.data.published)}
                </time>
                <span class="su-row-title">{entry.data.title}</span>
              </a>
            </li>
          ))}
        </ul>

        {(page.url.prev || page.url.next) && (
          <nav class="su-pager" aria-label="分页导航">
            {page.url.prev ? (
              <a class="su-btn" href={page.url.prev}>
                <Icon name="material-symbols:chevron-left-rounded" width="16" height="16" />
                上一页
              </a>
            ) : (
              <span class="su-btn" aria-disabled="true">
                <Icon name="material-symbols:chevron-left-rounded" width="16" height="16" />
                上一页
              </span>
            )}
            <span class="su-num">
              {page.currentPage} / {page.lastPage}
            </span>
            {page.url.next ? (
              <a class="su-btn" href={page.url.next}>
                下一页
                <Icon name="material-symbols:chevron-right-rounded" width="16" height="16" />
              </a>
            ) : (
              <span class="su-btn" aria-disabled="true">
                下一页
                <Icon name="material-symbols:chevron-right-rounded" width="16" height="16" />
              </span>
            )}
          </nav>
        )}
      </div>
    </SupabaseLayout>
  )
}

<style>
  /* ── 首页 ─────────────────────────────────────────────── */
  .su-home {
    max-width: 800px;
    margin-inline: auto;
  }

  .su-home-avatar {
    margin-bottom: 20px;
  }

  .su-home-name {
    margin: 20px 0 0;
    font-size: 28px;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.42px;
    color: var(--su-foreground);
  }

  .su-home-desc {
    max-width: 560px;
    margin: 12px 0 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--su-muted-foreground);
  }

  .su-home-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    margin-top: 24px;
  }

  .su-home-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--su-muted-foreground);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .su-home-link:hover {
    color: var(--su-primary);
  }

  /* 首页主入口：单个主按钮 + 一个次级文字链接 */
  .su-home-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 32px;
  }

  /* 次级文字链接（首页「关于我」入口 / 列表页复用） */
  .su-home-more {
    font-size: 13px;
    color: var(--su-muted-foreground);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .su-home-more:hover {
    color: var(--su-primary);
  }

  /* 页脚：intro 之后唯一的分区，hairline 之上 96px、之下 32px */
  .su-home-footer {
    margin-top: 96px;
    padding: 32px 0 8px;
    border-top: 1px solid var(--su-border);
  }

  .su-home-stats {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--su-muted-foreground);
  }

  .su-home-stats a {
    color: var(--su-foreground);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .su-home-stats a:hover {
    color: var(--su-primary);
  }

  /* 底部站点入口：一行常显，克制 */
  .su-home-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    font-size: 13px;
  }

  .su-home-legal a {
    color: var(--su-muted-foreground);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .su-home-legal a:hover {
    color: var(--su-primary);
  }

  /* ── 列表页 ───────────────────────────────────────────── */
  .su-list-page {
    max-width: 800px;
    margin-inline: auto;
  }

  .su-list-page .su-list {
    border-top: 1px solid var(--su-border);
  }

  .su-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 48px;
  }
</style>
