---
import Comment from "@components/comment/index.astro";
import { Icon } from "astro-icon/components";
import { commentConfig, siteConfig, sponsorConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@i18n/translation";
import SupabaseLayout from "@/layouts/SupabaseLayout.astro";
import SbPageHeader from "@/components/layout/SbPageHeader.astro";
import { url } from "@/utils/url-utils";

// 检查页面是否启用
if (!siteConfig.pages.sponsor) {
	return Astro.redirect("/404/");
}

// 检查评论系统是否启用
const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	sponsorConfig.showComment !== false;

const title = sponsorConfig.title || i18n(I18nKey.sponsorTitle);
const description =
	sponsorConfig.description || i18n(I18nKey.sponsorDescription);
const enabledMethods = sponsorConfig.methods.filter((method) => method.enabled);
const sponsors = sponsorConfig.sponsors || [];
const showSponsorsList = sponsorConfig.showSponsorsList !== false;
---

<SupabaseLayout title={title} description={description}>
  <SbPageHeader
    title={title}
    subtitle={description}
  >
    {sponsorConfig.usage ? (
      <div class="su-card su-card--pad su-animate mb-6">
        <div class="flex items-start gap-2">
          <Icon name="material-symbols:info-outline" class="su-text-primary text-lg shrink-0 mt-0.5" />
          <p class="su-body-sm su-text-mute leading-relaxed">
            <span class="font-semibold su-text-primary"></span>
            {sponsorConfig.usage}
          </p>
        </div>
      </div>
    ) : null}
  </SbPageHeader>

  <!-- 赞助方式 -->
  <div class="su-prose-page">
    <section aria-labelledby="methods-title" class="mb-8">
      <h2 id="methods-title" class="su-section-title mb-4">{i18n(I18nKey.sponsorMethods)}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {enabledMethods.map((method) => (
          <div class="su-card su-card--hover su-animate">
            <div class="flex items-center gap-3 mb-3">
              {method.icon ? (
                <Icon name={method.icon} class="text-2xl su-text-foreground" />
              ) : null}
              <h3 class="su-heading-md">{method.name}</h3>
            </div>

            {method.description ? (
              <p class="su-body-sm su-text-mute mb-4 text-center">
                {method.description}
              </p>
            ) : null}

            {method.qrCode ? (
              <div class="relative w-full max-w-[200px] aspect-square su-canvas rounded-lg p-4 mb-4 mx-auto">
                <img
                  src={url(method.qrCode)}
                  alt={`${method.name} ${i18n(I18nKey.scanToSponsor)}`}
                  class="w-full h-full object-contain"
                  loading="lazy"
                />
              </div>
            ) : null}

            {method.link ? (
              <a
                href={method.link}
                target="_blank"
                rel="noopener noreferrer"
                class="su-btn su-btn--primary w-full"
              >
                <span>{i18n(I18nKey.sponsorGoTo)}</span>
                <Icon name="fa7-solid:arrow-up-right-from-square" class="text-sm" />
              </a>
            ) : null}
          </div>
        ))}
      </div>
    </section>

    <!-- 赞助者列表 -->
    {showSponsorsList ? (
      <section aria-labelledby="list-title">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg su-primary/10 flex items-center justify-center">
              <Icon name="material-symbols:emoji-people-rounded" class="text-xl su-text-primary" />
            </div>
            <h2 class="su-heading-lg">{i18n(I18nKey.sponsorList)}</h2>
          </div>
          {sponsors.length > 0 ? (
            <span class="su-caption su-text-mute">{sponsors.length}</span>
          ) : null}
        </div>
        {sponsors.length > 0 ? (
          <div class="sponsor-grid grid grid-cols-1 sm:grid-cols-2 gap-3">
            {sponsors.map((sponsor) => (
              <div class="su-card su-card--hover group flex items-center gap-3 p-3">
                <div class="w-9 h-9 rounded-full su-primary/10 flex items-center justify-center shrink-0 group-hover:su-primary/20 transition-colors">
                  <span class="text-sm font-bold su-text-primary">{sponsor.name.charAt(0)}</span>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    <span class="font-semibold text-sm su-text-foreground truncate">{sponsor.name}</span>
                    {sponsor.amount ? (
                      <span class="shrink-0 text-xs font-bold su-text-primary">{sponsor.amount}</span>
                    ) : null}
                  </div>
                  {sponsor.date ? (
                    <span class="su-caption su-text-mute">
                      {new Date(sponsor.date).toLocaleDateString()}
                    </span>
                  ) : null}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="su-prose-page text-center py-12 su-text-mute">
            <p>{i18n(I18nKey.sponsorEmpty)}</p>
          </div>
        )}
      </section>
    ) : null}

    <!-- 评论区 -->
    {isCommentEnabled ? (
      <div class="mt-6">
        <Comment customPath="/sponsor/" title="sponsor" />
      </div>
    ) : null}
  </div>
</SupabaseLayout>

<style>
  /* 透明模式下使用半透明背景 */
  :global(body.wallpaper-transparent .su-card) {
    background-color: rgba(var(--su-primary-rgb, 70, 130, 180), 0.15) !important;
  }

  :global(:root.dark body.wallpaper-transparent .su-card) {
    background-color: oklch(from var(--su-primary) l c h / 0.15) !important;
  }
</style>