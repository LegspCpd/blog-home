---
import Comment from "@components/comment/index.astro";
import { Icon } from "astro-icon/components";
import { commentConfig, siteConfig, sponsorConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import SupabaseLayout from "@/layouts/SupabaseLayout.astro";
import SbPageHeader from "@/components/layout/SbPageHeader.astro";
import { url } from "@/utils/url-utils";

// 检查页面是否启用
if (!siteConfig.pages.sponsor) {
	return Astro.redirect("/404/");
}

// 检查评论系统是否启用
const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	sponsorConfig.showComment !== false;

const title = sponsorConfig.title || i18n(I18nKey.sponsorTitle);
const description =
	sponsorConfig.description || i18n(I18nKey.sponsorDescription);
const enabledMethods = sponsorConfig.methods.filter((method) => method.enabled);
const sponsors = sponsorConfig.sponsors || [];
const showSponsorsList = sponsorConfig.showSponsorsList !== false;
---

<SupabaseLayout title={title} description={description}>
  <SbPageHeader eyebrow="Sponsor" title={title} subtitle={description} />

  <!-- 用途说明 -->
  {
    sponsorConfig.usage ? (
      <aside class="su-card su-card--pad su-usage">
        <Icon name="material-symbols:info-outline" class="su-usage-icon" />
        <p class="su-body-sm">{sponsorConfig.usage}</p>
      </aside>
    ) : null
  }

  <!-- 赞助方式 -->
  {
    enabledMethods.length > 0 ? (
      <section class="su-section-sm" aria-labelledby="su-methods-title">
        <h2 id="su-methods-title" class="su-section-title su-sponsor-sub">
          <Icon name="material-symbols:favorite" />
          {i18n(I18nKey.sponsorMethods)}
        </h2>

        <ul class="su-methods">
          {enabledMethods.map((method) => (
            <li class="su-card su-card--pad su-method">
              {method.icon ? (
                <span class="su-method-icon">
                  <Icon name={method.icon} />
                </span>
              ) : null}

              <h3 class="su-heading-md su-method-name">{method.name}</h3>

              {method.description ? (
                <p class="su-body-sm su-text-mute su-method-desc">
                  {method.description}
                </p>
              ) : null}

              {method.qrCode ? (
                <div class="su-method-qr">
                  <img
                    src={url(method.qrCode)}
                    alt={`${method.name} ${i18n(I18nKey.scanToSponsor)}`}
                    loading="lazy"
                  />
                  <span class="su-caption su-text-mute">
                    {i18n(I18nKey.scanToSponsor)}
                  </span>
                </div>
              ) : null}

              {method.link ? (
                <a
                  class="su-btn su-btn--primary su-method-link"
                  href={method.link}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {i18n(I18nKey.sponsorGoTo)}
                  <Icon name="fa7-solid:arrow-up-right-from-square" />
                </a>
              ) : null}
            </li>
          ))}
        </ul>
      </section>
    ) : null
  }

  <!-- 赞助者列表 -->
  {
    showSponsorsList ? (
      <section class="su-section-sm" aria-labelledby="su-sponsors-title">
        <div class="su-sponsor-head">
          <h2 id="su-sponsors-title" class="su-section-title su-sponsor-sub">
            <Icon name="material-symbols:emoji-people-rounded" />
            {i18n(I18nKey.sponsorList)}
          </h2>
          {sponsors.length > 0 ? (
            <span class="su-num">{sponsors.length}</span>
          ) : null}
        </div>

        {sponsors.length > 0 ? (
          <ul class="su-sponsors">
            {sponsors.map((sponsor) => (
              <li class="su-card su-card--hover su-sponsor">
                <span class="su-sponsor-avatar" aria-hidden="true">
                  {sponsor.name.charAt(0)}
                </span>
                <span class="su-sponsor-info">
                  <span class="su-sponsor-name">{sponsor.name}</span>
                  {sponsor.date ? (
                    <span class="su-caption su-text-mute">
                      {new Date(sponsor.date).toLocaleDateString("zh-CN")}
                    </span>
                  ) : null}
                </span>
                {sponsor.amount ? (
                  <span class="su-pill su-pill--green su-sponsor-amount">
                    {sponsor.amount}
                  </span>
                ) : null}
              </li>
            ))}
          </ul>
        ) : (
          <p class="su-body-md su-text-mute">{i18n(I18nKey.sponsorEmpty)}</p>
        )}
      </section>
    ) : null
  }

  <!-- 评论区 -->
  {isCommentEnabled ? <Comment customPath="/sponsor/" title="sponsor" /> : null}
</SupabaseLayout>

<style>
	.su-usage {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		background-color: var(--su-canvas-soft);
	}

	.su-usage-icon {
		flex: none;
		margin-top: 1px;
		font-size: 18px;
		color: var(--su-primary);
	}

	.su-sponsor-sub {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 24px;
	}

	.su-sponsor-sub :global(svg) {
		color: var(--su-primary);
	}

	/* 赞助方式卡片 */
	.su-methods {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.su-method {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 12px;
	}

	.su-method-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border: 1px solid var(--su-border);
		border-radius: var(--su-radius-md);
		background-color: var(--su-muted);
		font-size: 20px;
		color: var(--su-foreground);
	}

	.su-method-desc {
		max-width: 30ch;
	}

	/* 二维码：白底衬底，保证扫码对比度 */
	.su-method-qr {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		padding: 12px;
		border: 1px solid var(--su-border);
		border-radius: var(--su-radius-md);
		background-color: #ffffff;
	}

	.su-method-qr img {
		width: 180px;
		height: 180px;
		object-fit: contain;
	}

	.su-method-link {
		margin-top: auto;
	}

	/* 赞助者 */
	.su-sponsor-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
	}

	.su-sponsors {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 12px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.su-sponsor {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px 16px;
	}

	.su-sponsor-avatar {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: var(--su-radius-full);
		background-color: var(--su-primary);
		color: var(--su-primary-foreground);
		font-size: 14px;
		font-weight: 500;
	}

	.su-sponsor-info {
		display: flex;
		flex-direction: column;
		min-width: 0;
		flex: 1;
	}

	.su-sponsor-name {
		font-size: 15px;
		font-weight: 500;
		color: var(--su-foreground);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.su-sponsor-amount {
		flex: none;
	}
</style>