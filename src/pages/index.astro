---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { SITE } from "../config/site";
import EfStrip from "../components/win/EfStrip.astro";

/**
 * 首页。
 *
 * 这里**只放 hero**，不列任何文章 —— 文章列表搬到 /posts/（左侧导航的「文章」）。
 * 之前首页同时承担「首页 + 文章列表 + 分页」，用户要求拆开：
 * 首页就写点东西，列表单独一页。
 */
const posts = await getCollection("posts", ({ data }) => !data.draft);
---

<Base>
  <section class="hero">
    <!-- 三色条：套件规定只出现在"页面开始"和"详情标题下方"这两处 -->
    <EfStrip />
    <p class="eyebrow">{SITE.subtitle}</p>
    <!--
      展示型页面的字标：宽体大写、实心。
      对读屏软件是冗余的（站点名在 <title> 和页脚都有），所以 aria-hidden。
      终末地主题下才显示，见 endfield/skin.css。
    -->
    <p class="ef-wordmark" aria-hidden="true">LegspCpd <span class="ef-slash">/</span></p>
    <h1 class="hero-title">写点<span class="accent">有意思</span>的东西</h1>
    <p class="hero-sub">{posts.length} 篇记录。技术、设计、还有一些想不清楚的事。</p>
    <div class="hero-actions">
      <a class="btn-primary" href="/posts/">开始读 <span aria-hidden="true">→</span></a>
      <a class="btn-ghost" href="/rss.xml">订阅 RSS</a>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ────────────────────────────────────────────────
     排版取自 Cursor（weight 500 而非 700，靠字距说话）
     与 Linear（紧到 -2.2px 的 display）
     霓虹只出现在一个词上。 */
  .hero {
    padding: var(--s-xl) 0 var(--s-xl);
    max-width: 760px;
  }

  .hero .eyebrow {
    color: var(--c-faint);
    margin-bottom: var(--s-md);
  }

  /* 中文标题不能带负字距：Inter 只覆盖拉丁，中文回落到系统字体，
     负字距会把中文字形往左压、右侧被切掉（「有意思」变成「有息」）。
     所以只有 .accent 这个纯拉丁词享受紧字距。 */
  .hero-title {
    font-size: var(--t-mega-size);
    font-weight: var(--t-mega-weight);
    line-height: var(--t-mega-lh);
    letter-spacing: 0;
    margin: 0 0 var(--s-md);
    color: var(--c-ink);
  }

  /* 强调词：统一强调色 + 拉丁词紧字距。
     原来是"每个内容取一个情绪色 + 发光"，WinUI 没有文字发光，
     也没有按内容换色。 */
  .accent {
    color: var(--c-neon-volt);
    letter-spacing: -0.6px;
  }

  .hero-sub {
    margin: 0 0 var(--s-lg);
    color: var(--c-muted);
    font-size: 16.5px;
    line-height: 1.68;
    max-width: 46ch;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--s-sm);
    flex-wrap: wrap;
  }

  /* 主按钮：hover 抬起，active 缩回。触感全在这两行 */
  /*
   * 两个按钮共用同一套盒子。
   *
   * 之前 .btn-primary 与 .btn-ghost 各写各的 padding，而 .btn-ghost 还多一圈
   * 1px border、又没设 box-sizing —— 实测同一行里一个高 42px、一个高 44px，
   * 垂直方向还错开 1px。看起来就是"按钮没对齐"。
   * 统一成 border-box + 固定最小高 + 相同内边距，边框就不再影响尺寸。
   */
  .btn-primary {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 36px;
    padding: 0 16px;
    border-radius: var(--r-md);
    background: var(--c-neon-volt);
    color: var(--c-on-neon);
    font-size: 14px;
    font-weight: 650;
    transition:
      transform var(--m-quick),
      box-shadow var(--m-quick),
      filter var(--m-snap);
  }
  .btn-primary:hover {
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: 0 8px 26px -8px rgba(0, 229, 154, 0.6);
  }
  .btn-primary:active {
    transform: translateY(0) scale(0.97);
    box-shadow: none;
    transition-duration: var(--m-snap);
  }
  .btn-primary span {
    transition: transform var(--m-quick);
  }
  .btn-primary:hover span {
    transform: translateX(3px);
  }

  /* 次按钮：描边 + hover 时霓虹描边 */
  .btn-ghost {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 16px;
    border: 1px solid var(--line-base);
    border-radius: var(--r-md);
    color: var(--c-muted);
    font-size: 14px;
    font-weight: 600;
    transition:
      color var(--m-quick),
      border-color var(--m-quick),
      background var(--m-quick);
  }
  .btn-ghost:hover {
    text-decoration: none;
    color: var(--c-ink);
    border-color: color-mix(in srgb, var(--c-neon-volt) 55%, transparent);
    background: color-mix(in srgb, var(--c-neon-volt) 7%, transparent);
  }

  /* ── 文章网格：两列，首篇跨列 ─────────────────────────────
     不对称的来源就在这里。 */
  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-md);
    margin-bottom: var(--s-xl);
  }

  /* ── 分页 ─────────────────────────────────────────────── */
  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-md);
    padding: var(--s-md) 0;
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
    margin-bottom: var(--s-xl);
  }

  .pager-link {
    padding: 8px 15px;
    border: 1px solid var(--line-base);
    border-radius: var(--r-md);
    color: var(--c-body);
    font-size: 14px;
    font-weight: 600;
    transition:
      transform var(--m-quick),
      border-color var(--m-quick),
      background var(--m-quick),
      color var(--m-quick);
  }
  .pager-link:hover {
    text-decoration: none;
    transform: translateY(-2px);
    color: var(--c-ink);
    border-color: var(--line-strong);
    background: var(--c-s2);
  }
  .pager-link:active {
    transform: translateY(0) scale(0.98);
    transition-duration: var(--m-snap);
  }
  /* 不可用的那一侧：保留位置，但明显退后 */
  .pager-link.is-off {
    color: var(--c-faint);
    border-color: var(--line-soft);
    background: transparent;
    cursor: not-allowed;
    transform: none;
  }

  .pager-info {
    color: var(--c-faint);
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.4px;
  }

  /* ── 标签云 ──────────────────────────────────────────────
     字号按词频缩放——看似随机，其实有规则。 */
  .tags-band {
    padding-top: var(--s-lg);
  }

  .tags-band .eyebrow {
    color: var(--c-faint);
    margin-bottom: var(--s-md);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-sm) var(--s-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cloud {
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
    font-size: calc(13px * var(--scale));
    font-weight: calc(400 + (var(--scale) - 0.86) * 1000);
    color: var(--c-muted);
    transition:
      color var(--m-quick),
      transform var(--m-quick);
  }
  .cloud:hover {
    text-decoration: none;
    color: var(--c-neon-volt);
    transform: translateY(-2px);
  }

  .cloud sup {
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--c-faint);
  }

  .page-title {
    font-size: 28px;
    padding: var(--s-xl) 0 var(--s-lg);
  }

  .empty {
    color: var(--c-faint);
    padding: var(--s-xl) 0;
  }

  @media (max-width: 720px) {
    .hero {
      padding-top: var(--s-xl);
    }
    .hero-title {
      font-size: clamp(32px, 9vw, 44px);
      letter-spacing: -1.4px;
    }
    .post-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
