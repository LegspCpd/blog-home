---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PostCard from "../components/win/PostCard.astro";
import { POSTS_PER_PAGE } from "../config/site";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const page = Math.max(1, Number(Astro.url.searchParams.get("page")) || 1);
const total = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const current = Math.min(page, total);
const slice = posts.slice((current - 1) * POSTS_PER_PAGE, current * POSTS_PER_PAGE);

const base = current > 1 ? `/?page=${current - 1}/` : "/";
const next = current < total ? `/?page=${current + 1}/` : null;
---

<Base title={current > 1 ? `第 ${current} 页` : undefined}>
  <h1 class="page-title">最新文章</h1>

  {
    slice.length === 0 ? (
      <p class="empty">还没有文章。</p>
    ) : (
      <div class="post-list">
        {slice.map((post) => (
          <PostCard post={post} slug={post.id} />
        ))}
      </div>
    )
  }

  {
    total > 1 && (
      <nav class="pager" aria-label="分页导航">
        {current > 1 ? (
          <a class="pager-link" href={base}>← 上一页</a>
        ) : (
          <span class="pager-link disabled">← 上一页</span>
        )}
        <span class="pager-info">
          第 {current} / {total} 页
        </span>
        {next ? (
          <a class="pager-link" href={next}>下一页 →</a>
        ) : (
          <span class="pager-link disabled">下一页 →</span>
        )}
      </nav>
    )
  }
</Base>

<style>
  .page-title {
    margin-bottom: var(--spacingHorizontalXL);
    font-size: var(--fontSizeBase600);
  }

  .post-list {
    display: grid;
    gap: var(--spacingHorizontalL);
  }

  .empty {
    color: var(--colorNeutralForeground4);
    text-align: center;
    padding-block: 64px;
  }

  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacingHorizontalM);
    margin-top: var(--spacingHorizontalXL);
  }

  .pager-link {
    padding: 8px 16px;
    border-radius: var(--borderRadiusMedium);
    border: 1px solid var(--colorNeutralStroke1);
    color: var(--colorNeutralForeground1);
    font-size: var(--fontSizeBase200);
    text-decoration: none;
    transition: background-color var(--durationFast) var(--curveEasyEase);
  }
  .pager-link:hover {
    background: var(--colorSubtleBackgroundHover);
    text-decoration: none;
  }
  .pager-link.disabled {
    color: var(--colorNeutralForegroundDisabled);
    pointer-events: none;
  }

  .pager-info {
    color: var(--colorNeutralForeground4);
    font-size: var(--fontSizeBase200);
  }
</style>