---
import { render } from "astro:content";
import * as path from "node:path";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import EncryptedPost from "@components/features/EncryptedPost.astro";
import KatexManager from "@components/features/KatexManager.astro";
import License from "@components/misc/License.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import SupabaseLayout from "@layouts/SupabaseLayout.astro";
import { getRelatedPosts, getSortedPosts } from "@utils/content-utils";
import {
	getFileDirFromPath,
	getPostUrlBySlug,
	removeFileExtension,
	url,
} from "@utils/url-utils";
import CoverImage from "@/components/common/CoverImage.astro";
import SharePoster from "@/components/misc/SharePoster.svelte";
import { coverImageConfig } from "@/config/coverImageConfig";
import { licenseConfig } from "@/config/licenseConfig";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import { sponsorConfig } from "@/config/sponsorConfig";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getBlogPostStructuredData } from "@/lib/seo/json-ld";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import { Icon } from "astro-icon/components";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => {
		const slug = removeFileExtension(entry.id);
		return {
			params: { slug },
			props: { entry },
		};
	});
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { remarkPluginFrontmatter } = await render(entry);

// 处理随机图：如果 image 为 "api"，则从配置的 API 获取随机图
const processedImage = processCoverImageSync(entry.data.image, entry.id);
const apiUrls = getApiUrlList(entry.data.image, entry.id);

let posterCoverUrl = processedImage;
if (processedImage) {
	const isLocal = !(
		processedImage.startsWith("/") ||
		processedImage.startsWith("http") ||
		processedImage.startsWith("https") ||
		processedImage.startsWith("data:")
	);
	if (isLocal) {
		const basePath = getFileDirFromPath(entry.filePath || "");
		const files = import.meta.glob<ImageMetadata>("../../**", {
			import: "default",
		});
		const normalizedPath = path
			.normalize(path.join("../../", basePath, processedImage))
			.replace(/\\/g, "/");
		const file = files[normalizedPath];
		if (file) {
			const img = await file();
			posterCoverUrl = img.src;
		}
	}
}

let posterAvatarUrl: string | null = profileConfig.avatar || null;
if (posterAvatarUrl) {
	const isLocalAvatar = !(
		posterAvatarUrl.startsWith("/") ||
		posterAvatarUrl.startsWith("http") ||
		posterAvatarUrl.startsWith("https") ||
		posterAvatarUrl.startsWith("data:")
	);
	if (isLocalAvatar) {
		const files = import.meta.glob<ImageMetadata>("../../**", {
			import: "default",
		});
		const normalizedPath = path
			.normalize(path.join("../../", posterAvatarUrl))
			.replace(/\\/g, "/");
		const file = files[normalizedPath];
		if (file) {
			const img = await file();
			posterAvatarUrl = img.src;
		}
	}
}

dayjs.extend(utc);

const jsonLdRaw = getBlogPostStructuredData({
	title: entry.data.title,
	description:
		entry.data.description?.trim() ||
		remarkPluginFrontmatter.excerpt?.trim() ||
		entry.data.title,
	publishedDate: formatDateToYYYYMMDD(entry.data.published),
	updatedDate: entry.data.updated
		? formatDateToYYYYMMDD(entry.data.updated)
		: undefined,
	slug: entry.id,
	tags: entry.data.tags,
	coverImage: processedImage || undefined,
	authorName: profileConfig.name,
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
});

const relatedPosts = await getRelatedPosts(entry, 5);

const postDescription = (
	entry.data.description?.trim() ||
	remarkPluginFrontmatter.excerpt?.trim() ||
	entry.data.title
).slice(0, 200);
const postOgImage = processedImage || undefined;

// 本节目录：只取 2-3 级标题，少于 3 条时不展示
const tocHeadings = (headings || []).filter((h) => h.depth >= 2 && h.depth <= 3);
const showToc = tocHeadings.length >= 3;

const tags = entry.data.tags ?? [];

// 上一篇 = 更早发布（prevSlug），下一篇 = 更新发布（nextSlug）
const prevPost = entry.data.prevSlug
	? { slug: entry.data.prevSlug, title: entry.data.prevTitle || "无标题" }
	: null;
const nextPost = entry.data.nextSlug
	? { slug: entry.data.nextSlug, title: entry.data.nextTitle || "无标题" }
	: null;

const showSponsor = sponsorConfig.showButtonInPost && siteConfig.pages.sponsor;
const showShareBlock = siteConfig.sharePoster || showSponsor;
---

<SupabaseLayout
  title={entry.data.title}
  description={postDescription}
  lang={entry.data.lang}
  setOGTypeArticle={true}
  postSlug={entry.id}
  ogImage={postOgImage}
>
  <KatexManager slot="head" />

  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={jsonLdRaw}
  />

  <div class="su-article-page">
    <!--
      返回入口：同源进入（含 swup 站内跳转）时回到上一页，
      直接打开/外站进入时回落到文章列表，不会出现"点了没反应"。
    -->
    <a
      id="su-back-link"
      class="su-back"
      href="/posts/"
      data-fallback="/posts/"
    >
      <Icon name="material-symbols:arrow-back" width="14" height="14" />
      返回文章列表
    </a>

    <article id="post-container" data-pagefind-body>
      <header class="su-post-head">
        {
          entry.data.category && (
            <p class="su-kicker is-plain su-post-category">{entry.data.category}</p>
          )
        }

        <h1
          class="su-post-title"
          data-pagefind-weight="10"
          data-pagefind-meta="title"
        >
          {entry.data.title}
        </h1>

        <div class="su-meta su-post-meta">
          <span class="su-num">{formatDateToYYYYMMDD(entry.data.published)}</span>
          {
            entry.data.updated && (
              <>
                <span class="su-dot">·</span>
                <span class="su-num">
                  {i18n(I18nKey.updatedAt)} {formatDateToYYYYMMDD(entry.data.updated)}
                </span>
              </>
            )
          }
          {
            remarkPluginFrontmatter.words && (
              <>
                <span class="su-dot">·</span>
                <span class="su-num">
                  {remarkPluginFrontmatter.words} {i18n(I18nKey.wordsCount)}
                </span>
              </>
            )
          }
          {
            remarkPluginFrontmatter.minutes && (
              <>
                <span class="su-dot">·</span>
                <span class="su-num">
                  {remarkPluginFrontmatter.minutes}
                  {i18n(
                    remarkPluginFrontmatter.minutes === 1
                      ? I18nKey.minuteCount
                      : I18nKey.minutesCount
                  )}
                </span>
              </>
            )
          }
          {
            entry.data.password && (
              <>
                <span class="su-dot">·</span>
                <span class="su-meta-lock">
                  <Icon name="material-symbols:lock-outline" width="14" height="14" />
                  {i18n(I18nKey.postEncrypted)}
                </span>
              </>
            )
          }
        </div>

        {
          tags.length > 0 && (
            <div class="su-post-tags">
              {tags.map((tag) => (
                <span class="su-pill">#{tag}</span>
              ))}
            </div>
          )
        }
      </header>

      <hr class="su-hairline su-post-rule" />

      {
        processedImage && coverImageConfig.enableInPost && (
          <CoverImage
            id="post-cover"
            src={processedImage}
            basePath={getFileDirFromPath(entry.filePath || "")}
            alt={`${entry.data.title} - ${siteConfig.title}`}
            class="su-post-cover"
            preview={false}
            apiUrls={apiUrls}
          />
        )
      }

      {
        showToc && (
          <details class="su-toc" data-pagefind-ignore open>
            <summary class="su-toc-summary">{i18n(I18nKey.tableOfContents)}</summary>
            <ol class="su-toc-list">
              {tocHeadings.map((h) => (
                <li class:list={["su-toc-item", `depth-${h.depth}`]}>
                  <a href={`#${h.slug}`}>{h.text.replace(/#$/, "")}</a>
                </li>
              ))}
            </ol>
          </details>
        )
      }

      {
        entry.data.password ? (
          <EncryptedPost
            password={entry.data.password}
            slug={entry.id}
            hint={entry.data.passwordHint}
          >
            <Markdown class="su-post-body markdown-content" pagefindBody={false}>
              <Content />
            </Markdown>

            {showShareBlock && (
              <div class="su-share-block" data-pagefind-ignore>
                <div class="su-share-text">
                  <p class="su-share-title">
                    {showSponsor
                      ? i18n(I18nKey.sponsorButton)
                      : i18n(I18nKey.shareOnSocial)}
                  </p>
                  <p class="su-share-desc">
                    {showSponsor
                      ? i18n(I18nKey.sponsorButtonText)
                      : i18n(I18nKey.shareOnSocialDescription)}
                  </p>
                </div>
                <div class="su-share-actions">
                  {siteConfig.sharePoster && (
                    <SharePoster
                      client:visible
                      title={entry.data.title}
                      author={profileConfig.name}
                      description={entry.data.description || entry.data.title}
                      pubDate={formatDateToYYYYMMDD(entry.data.published)}
                      coverImage={posterCoverUrl}
                      url={Astro.url.href}
                      siteTitle={siteConfig.title}
                      avatar={posterAvatarUrl}
                    />
                  )}
                  {showSponsor && (
                    <a href={url("/sponsor/")} class="su-btn is-primary">
                      {i18n(I18nKey.sponsor)}
                      <Icon name="fa7-solid:arrow-right" width="14" height="14" />
                    </a>
                  )}
                </div>
              </div>
            )}

            {licenseConfig.enable && (
              <License
                title={entry.data.title}
                id={entry.id}
                pubDate={entry.data.published}
                author={entry.data.author}
                sourceLink={entry.data.sourceLink}
                licenseName={entry.data.licenseName}
                licenseUrl={entry.data.licenseUrl}
                class="su-license"
              />
            )}
          </EncryptedPost>
        ) : (
          <>
            <Markdown class="su-post-body markdown-content" pagefindBody={false}>
              <Content />
            </Markdown>

            {showShareBlock && (
              <div class="su-share-block" data-pagefind-ignore>
                <div class="su-share-text">
                  <p class="su-share-title">
                    {showSponsor
                      ? i18n(I18nKey.sponsorButton)
                      : i18n(I18nKey.shareOnSocial)}
                  </p>
                  <p class="su-share-desc">
                    {showSponsor
                      ? i18n(I18nKey.sponsorButtonText)
                      : i18n(I18nKey.shareOnSocialDescription)}
                  </p>
                </div>
                <div class="su-share-actions">
                  {siteConfig.sharePoster && (
                    <SharePoster
                      client:visible
                      title={entry.data.title}
                      author={profileConfig.name}
                      description={entry.data.description || entry.data.title}
                      pubDate={formatDateToYYYYMMDD(entry.data.published)}
                      coverImage={posterCoverUrl}
                      url={Astro.url.href}
                      siteTitle={siteConfig.title}
                      avatar={posterAvatarUrl}
                    />
                  )}
                  {showSponsor && (
                    <a href={url("/sponsor/")} class="su-btn is-primary">
                      {i18n(I18nKey.sponsor)}
                      <Icon name="fa7-solid:arrow-right" width="14" height="14" />
                    </a>
                  )}
                </div>
              </div>
            )}

            {licenseConfig.enable && (
              <License
                title={entry.data.title}
                id={entry.id}
                pubDate={entry.data.published}
                author={entry.data.author}
                sourceLink={entry.data.sourceLink}
                licenseName={entry.data.licenseName}
                licenseUrl={entry.data.licenseUrl}
                class="su-license"
              />
            )}
          </>
        )
      }

      {
        siteConfig.showLastModified && (() => {
          const lastModified = dayjs(entry.data.updated || entry.data.published);
          const dateStr = lastModified.format("YYYY-MM-DD");
          const outdatedThreshold = siteConfig.outdatedThreshold ?? 1;
          return (
            <div
              id="outdated-card"
              class="su-outdated hidden"
              data-pagefind-ignore
              data-date={lastModified.toISOString()}
              data-threshold={outdatedThreshold}
            >
              <Icon name="material-symbols:history-rounded" width="16" height="16" />
              <span class="su-num">
                {i18n(I18nKey.lastModifiedPrefix)}{dateStr}
                <span
                  id="days-ago-text"
                  data-template={i18n(I18nKey.lastModifiedDaysAgo)}
                />
              </span>
              <span id="outdated-warning" class="su-outdated-warning hidden">
                {i18n(I18nKey.lastModifiedOutdated)}
              </span>
            </div>
          );
        })()
      }
    </article>

    {
      (prevPost || nextPost) && (
        <nav class="su-post-nav" aria-label="上下篇导航">
          {prevPost ? (
            <a class="su-post-nav-item is-prev" href={getPostUrlBySlug(prevPost.slug)}>
              <span class="su-post-nav-label">
                <Icon
                  name="material-symbols:chevron-left-rounded"
                  width="16"
                  height="16"
                />
                上一篇
              </span>
              <span class="su-post-nav-title">{prevPost.title}</span>
            </a>
          ) : (
            <span class="su-post-nav-item is-empty" aria-hidden="true" />
          )}
          {nextPost ? (
            <a class="su-post-nav-item is-next" href={getPostUrlBySlug(nextPost.slug)}>
              <span class="su-post-nav-label">
                下一篇
                <Icon
                  name="material-symbols:chevron-right-rounded"
                  width="16"
                  height="16"
                />
              </span>
              <span class="su-post-nav-title">{nextPost.title}</span>
            </a>
          ) : (
            <span class="su-post-nav-item is-empty" aria-hidden="true" />
          )}
        </nav>
      )
    }

    {
      relatedPosts.length > 0 && (
        <section class="su-related">
          <h2 class="su-related-title">{i18n(I18nKey.relatedPosts)}</h2>
          <ul class="su-list">
            {relatedPosts.map((post) => (
              <li>
                <a class="su-row" href={getPostUrlBySlug(post.id)}>
                  <span class="su-row-date">
                    {formatDateToYYYYMMDD(post.data.published)}
                  </span>
                  <span class="su-row-title">{post.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {entry.data.comment && !entry.data.password && <Comment post={entry} />}
  </div>

  <script>
    import dayjs from "dayjs";

    // 返回入口：站内跳转过来时回到上一页，否则回落到文章列表
    const backLink = document.getElementById("su-back-link");
    if (backLink) {
      backLink.addEventListener("click", (event) => {
        let sameOrigin = false;
        try {
          sameOrigin =
            !!document.referrer &&
            new URL(document.referrer).origin === location.origin;
        } catch {
          sameOrigin = false;
        }
        const navigatedInApp =
          sameOrigin || document.documentElement.hasAttribute("data-su-navigated");
        if (navigatedInApp && window.history.length > 1) {
          event.preventDefault();
          window.history.back();
        }
      });
    }

    const card = document.getElementById("outdated-card");

    if (card) {
      const lastModified = dayjs(card.dataset.date);
      const daysDiff = dayjs().diff(lastModified, "day");
      const threshold = Number(card.dataset.threshold);

      if (daysDiff >= threshold) {
        card.classList.remove("hidden");

        const textEl = document.getElementById("days-ago-text");
        if (textEl && textEl.dataset.template) {
          textEl.textContent = `，${textEl.dataset.template.replace("{days}", daysDiff.toString())}`;
        }

        document.getElementById("outdated-warning")?.classList.remove("hidden");
      }
    }
  </script>
</SupabaseLayout>

<style>
  .su-article-page {
    max-width: 760px;
    margin-inline: auto;
  }

  /* 返回入口：与正文同宽同左边界，克制不抢眼 */
  .su-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 24px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--su-muted-foreground);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .su-back:hover {
    color: var(--su-primary);
  }

  .su-post-head {
    margin-bottom: 24px;
  }

  .su-post-category {
    margin: 0 0 12px;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .su-post-title {
    margin: 0 0 16px;
    font-size: 36px;
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.72px;
    color: var(--su-foreground);
  }

  .su-post-meta {
    gap: 6px 8px;
  }

  .su-meta-lock {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono-supabase);
    font-size: 13px;
    color: var(--su-muted-foreground);
  }

  .su-post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 16px;
  }

  .su-post-rule {
    margin: 0 0 32px;
  }

  .su-post-body {
    margin-bottom: 48px;
  }

  /* 本节目录：只用上下一道 hairline 分隔，不用卡片外壳 */
  .su-toc {
    margin: 0 0 32px;
    padding: 16px 0;
    border: 0;
    border-top: 1px solid var(--su-border);
    border-bottom: 1px solid var(--su-border);
    border-radius: 0;
    background: none;
    font-size: 14px;
  }

  .su-toc-summary {
    cursor: pointer;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--su-muted-foreground);
    list-style: none;
  }

  .su-toc-summary::-webkit-details-marker {
    display: none;
  }

  .su-toc-list {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .su-toc-item {
    margin: 0;
    padding: 4px 0;
    line-height: 1.5;
  }

  .su-toc-item.depth-3 {
    padding-left: 16px;
  }

  .su-toc-item a {
    color: var(--su-muted-foreground);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .su-toc-item a:hover {
    color: var(--su-primary);
  }

  .su-share-block {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    margin: 64px 0 0;
    padding: 24px;
    border: 1px solid var(--su-border);
    border-radius: 12px;
  }

  .su-share-title {
    margin: 0 0 4px;
    font-size: 14px;
    font-weight: 500;
    color: var(--su-foreground);
  }

  .su-share-desc {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--su-muted-foreground);
  }

  .su-share-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .su-outdated {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 24px 0 0;
    padding: 12px 16px;
    border: 0;
    border-left: 2px solid var(--su-border);
    border-radius: 0;
    color: var(--su-muted-foreground);
  }

  .su-outdated-warning {
    font-size: 13px;
  }

  /* 上下篇：只靠 hairline 分栏，去掉卡片边框 */
  .su-post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin: 64px 0 0;
    border-top: 1px solid var(--su-border);
  }

  .su-post-nav-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px 24px 24px 0;
    border: 0;
    border-radius: 0;
    text-decoration: none;
  }

  .su-post-nav-item.is-next {
    padding: 24px 0 24px 24px;
    border-left: 1px solid var(--su-border);
    text-align: right;
    align-items: flex-end;
  }

  .su-post-nav-item.is-empty {
    padding: 0;
    border-left: 0;
  }

  .su-post-nav-label {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    line-height: 1.45;
    color: var(--su-muted-foreground);
  }

  .su-post-nav-title {
    font-size: 16px;
    line-height: 1.4;
    font-weight: 500;
    color: var(--su-foreground);
    transition: color 0.15s ease;
  }

  a.su-post-nav-item:hover .su-post-nav-title {
    color: var(--su-primary);
  }

  .su-related {
    margin-top: 64px;
  }

  .su-related-title {
    margin: 0 0 8px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--su-muted-foreground);
  }

  @media (max-width: 640px) {
    .su-post-title {
      font-size: 28px;
      line-height: 1.2;
      letter-spacing: -0.42px;
    }

    .su-post-nav {
      grid-template-columns: 1fr;
    }

    .su-post-nav-item,
    .su-post-nav-item.is-next {
      padding: 24px 0;
      text-align: left;
      align-items: flex-start;
      border-left: 0;
    }

    .su-post-nav-item + .su-post-nav-item:not(.is-empty) {
      border-top: 1px solid var(--su-border);
    }
  }
</style>
