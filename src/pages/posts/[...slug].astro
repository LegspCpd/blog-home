---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { SITE } from "../../config/site";
import PageHeader from "../../components/win/PageHeader.astro";
import EfStrip from "../../components/win/EfStrip.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;

const dateFmt = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

/* 上下篇：让长文有来处也有去处 */
const all = (await getCollection("posts", ({ data: d }) => !d.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);
const i = all.findIndex((p) => p.id === post.id);
const newer = i > 0 ? all[i - 1] : null;
const older = i >= 0 && i < all.length - 1 ? all[i + 1] : null;


/* 阅读时长：用 frontmatter 的 summary 不准，正文在 post.body。
   注意是 post.body 而不是 data.body —— 后者是 frontmatter，不含正文。 */
const words = (post.body ?? "").split(/\s+/).length;
const readMinutes = Math.max(1, Math.round(words / 400));
---

<Base
  title={data.title}
  description={data.description || SITE.description}
  path={`/posts/${post.id}/`}
  ogImage={data.image || undefined}
  type="article"
  publishedTime={data.published.toISOString()}
  modifiedTime={
    data.updated && data.updated.getTime() !== data.published.getTime()
      ? data.updated.toISOString()
      : undefined
  }
  tags={data.tags}
>
  <article class="post">
    <PageHeader title={data.title} />
    <!-- 套件规定：三色条只出现在"页面开始"和"详情标题下方"这两处，这是第二处 -->
    <EfStrip />

    <header class="head">
      {data.description && <p class="desc">{data.description}</p>}
      <!--
        文章标题由 NavigationView 的 52px 页头显示（Base 会把 title 传上去），
        页头里已经有一个语义 h1，正文再画一个就是两个大标题叠着。
        这里保留分类眉标、摘要与元信息，标题不再重复。
      -->
      <p class="eyebrow">{data.category ?? "随笔"}</p>

      <div class="meta">
        <time datetime={data.published.toISOString()}>
          {dateFmt.format(data.published)}
        </time>
        {
          data.updated &&
            data.updated.getTime() !== data.published.getTime() && (
              <span>· 改于 {dateFmt.format(data.updated)}</span>
            )
        }
        <span>· 约 {readMinutes} 分钟</span>
      </div>

      {data.image && (
        <div class="cover">
          <img src={data.image} alt="" loading="eager" decoding="async" />
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      data.tags.length > 0 && (
        <footer class="tags">
          <span class="eyebrow">标签</span>
          <ul>
            {data.tags.map((t) => (
              <li>
                <a href={`/tags/${encodeURIComponent(t)}/`}>{t}</a>
              </li>
            ))}
          </ul>
        </footer>
      )
    }

    {
      (newer || older) && (
        <nav class="pager-nav" aria-label="文章导航">
          {older ? (
            <a class="pn pn-prev" href={`/posts/${older.id}/`}>
              <span class="pn-dir">← 上一篇</span>
              <span class="pn-title">{older.data.title}</span>
            </a>
          ) : (
            <span class="pn is-off" />
          )}

          {newer ? (
            <a class="pn pn-next" href={`/posts/${newer.id}/`}>
              <span class="pn-dir">下一篇 →</span>
              <span class="pn-title">{newer.data.title}</span>
            </a>
          ) : (
            <span class="pn is-off" />
          )}
        </nav>
      )
    }
  </article>
</Base>

<style>
  /* 短文章别显得空 —— 这条原来放在通用容器上会波及首页，挪到这里才合身 */
  .post {
    min-height: 60dvh;
    padding: var(--s-xl) 0 0;
  }

  /* ── 文章头部 ──────────────────────────────────────────
     一度是居中（margin: 0 auto），但 WinUI 的内容一律左对齐。
     居中的副作用很显眼：页头标题贴左边、正文却缩进去一大截，
     两者对不齐。现在统一左对齐，只用 max-width 控制行宽。 ── */
  .head {
    max-width: var(--readable-head, 720px);
    margin: 0 0 var(--s-xl);
  }

  /* 分类眉标用统一的强调色。
     以前这里用 --mood（按文章 id 哈希取色），WinUI 没有"每个内容换一个颜色"
     这种做法 —— 同一个界面里出现五六种强调色会显得没有体系。 */
  .head .eyebrow {
    color: var(--c-neon-volt);
    margin-bottom: var(--s-sm);
  }

  /* 中文标题不加负字距（原因同首页：Inter 只覆盖拉丁，
     负字距会把中文字形压到被切掉） */
  .title {
    font-size: clamp(30px, 5vw, 42px);
    font-weight: var(--t-display-weight);
    line-height: 1.18;
    letter-spacing: 0;
    margin: 0 0 var(--s-md);
    color: var(--c-ink);
  }

  .desc {
    margin: 0 0 var(--s-md);
    font-size: 17px;
    line-height: 1.68;
    color: var(--c-muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--c-faint);
    letter-spacing: 0.2px;
  }

  /* 封面：比正文更宽，打破 680px 的窄栏——刻意的宽度不对称 */
  .cover {
    max-width: 1000px;
    margin: var(--s-xl) 0 0;
    border: 1px solid var(--line-base);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--c-inset);
  }

  .cover img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 8;
    object-fit: cover;
  }

  /* ── 标签 ─────────────────────────────────────────────── */
  .tags {
    max-width: var(--readable-prose, 680px);
    margin: var(--s-xl) 0 0;
    padding-top: var(--s-lg);
    border-top: 1px solid var(--line-soft);
  }

  .tags .eyebrow {
    color: var(--c-faint);
    margin-bottom: var(--s-sm);
  }

  .tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 与 /tags/ 页同一套 chip：4px 圆角、淡表面、1px 描边，
     hover 只叠一层更亮的填充（不做位移、不换色） */
  .tags a {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border: 1px solid var(--line-base);
    border-radius: var(--r-sm);
    background: var(--c-s3);
    color: var(--c-body);
    font-size: 13px;
    font-weight: 500;
    transition:
      background var(--m-snap),
      border-color var(--m-snap),
      color var(--m-snap);
  }

  .tags a:hover {
    text-decoration: none;
    color: var(--c-ink);
    background: var(--c-s2);
    border-color: var(--line-strong);
  }

  /* ── 上下篇：左右不对称地撑开，鼠标移上去才显出方向 ───── */
  .pager-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-md);
    max-width: 1000px;
    margin: var(--s-xl) auto 0;
  }

  .pn {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: var(--s-md) var(--s-lg);
    border: 1px solid var(--line-base);
    border-radius: var(--r-md);
    background: var(--c-s1);
    transition:
      transform var(--m-quick),
      border-color var(--m-quick),
      background var(--m-quick);
  }

  .pn:hover {
    text-decoration: none;
    transform: translateY(-3px);
    border-color: var(--line-strong);
    background: var(--c-s2);
  }

  .pn-next {
    text-align: right;
  }

  .pn.is-off {
    border-color: transparent;
    background: transparent;
  }

  /* WinUI 的 Caption 是 12px、常规字距，不做大写宽字距 */
  .pn-dir {
    font-size: 12px;
    letter-spacing: 0;
    color: var(--c-faint);
  }

  .pn-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--c-ink);
    /* 标题可能很长，限制两行保持左右两栏等高 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pn:hover .pn-title {
    color: var(--c-neon-volt);
  }

  @media (max-width: 640px) {
    .pager-nav {
      grid-template-columns: minmax(0, 1fr);
    }
    .pn-next {
      text-align: left;
    }
  }
</style>
