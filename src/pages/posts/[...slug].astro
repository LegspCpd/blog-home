---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { SITE } from "../../config/site";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;

const dateFmt = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Base
  title={data.title}
  description={data.description || SITE.description}
  path={`/posts/${post.id}/`}
  ogImage={data.image || undefined}
  type="article"
  publishedTime={data.published.toISOString()}
>
  <article class="post">
    <header class="post-head">
      <h1>{data.title}</h1>
      <div class="post-meta">
        <time datetime={data.published.toISOString()}>
          {dateFmt.format(data.published)}
        </time>
        {
          data.updated &&
            data.updated.getTime() !== data.published.getTime() && (
              <span>· 更新于 {dateFmt.format(data.updated)}</span>
            )
        }
        {data.category && <span class="badge">{data.category}</span>}
      </div>
      {data.tags.length > 0 && (
        <ul class="tags">
          {data.tags.map((tag) => (
            <li><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>
          ))}
        </ul>
      )}
    </header>

    {
      data.image && (
        <img class="cover" src={data.image} alt="" loading="eager" decoding="async" />
      )
    }

    <div class="prose">
      <Content />
    </div>

    <footer class="post-foot">
      <a class="back" href="/posts/">← 返回文章列表</a>
    </footer>
  </article>
</Base>

<style>
  .post { max-width: 760px; margin-inline: auto; }

  .post-head {
    margin-bottom: var(--spacingHorizontalXL);
    padding-bottom: var(--spacingHorizontalL);
    border-bottom: 1px solid var(--colorNeutralStroke1);
  }

  .post-head h1 {
    margin-bottom: 10px;
    font-size: var(--fontSizeBase600);
    line-height: 1.3;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: var(--colorNeutralForeground4);
    font-size: var(--fontSizeBase200);
  }

  .badge {
    padding: 1px 8px;
    border-radius: var(--borderRadiusCircular);
    background: var(--colorSubtleBackground);
    color: var(--colorBrandForeground1);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .tags a {
    padding: 1px 8px;
    border-radius: var(--borderRadiusCircular);
    border: 1px solid var(--colorNeutralStroke1);
    color: var(--colorNeutralForeground3);
    font-size: var(--fontSizeBase100);
    text-decoration: none;
  }
  .tags a:hover {
    background: var(--colorSubtleBackgroundHover);
    color: var(--colorNeutralForeground1);
  }

  .cover {
    width: 100%;
    border-radius: var(--borderRadiusXLarge);
    margin-bottom: var(--spacingHorizontalXL);
  }

  .post-foot {
    margin-top: 48px;
    padding-top: var(--spacingHorizontalL);
    border-top: 1px solid var(--colorNeutralStroke1);
  }

  .back {
    color: var(--colorNeutralForeground3);
    font-size: var(--fontSizeBase200);
    text-decoration: none;
  }
  .back:hover { color: var(--colorBrandForeground1); }
</style>