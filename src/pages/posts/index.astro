---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/win/PostCard.astro";
import PageHeader from "../../components/win/PageHeader.astro";
import { POSTS_PER_PAGE } from "../../config/site";

/**
 * 文章列表。
 *
 * 从首页搬过来的：用户要「首页不放任何文章，文章单独一页」，左侧导航也多一项。
 * 内容与之前首页上的列表一致（分页 + 卡片网格），只是挂到了 /posts/。
 */
const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);

const page = Math.max(1, Number(Astro.url.searchParams.get("page")) || 1);
const total = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const current = Math.min(page, total);
const slice = posts.slice((current - 1) * POSTS_PER_PAGE, current * POSTS_PER_PAGE);

const base = current > 1 ? `/posts/?page=${current - 1}` : "/posts/";
const next = current < total ? `/posts/?page=${current + 1}` : null;
---

<Base title={current > 1 ? `文章 · 第 ${current} 页` : "文章"} path="/posts/">
  <PageHeader
    title="文章"
    meta={total > 1 ? `共 ${posts.length} 篇，第 ${current} / ${total} 页` : `共 ${posts.length} 篇`}
  />

  {
    slice.length === 0 ? (
      <p class="empty">还没有文章。</p>
    ) : (
      <div class="post-grid">
        {slice.map((post) => (
          <PostCard post={post} slug={post.id} />
        ))}
      </div>
    )
  }

  {
    total > 1 && (
      <nav class="pager" aria-label="分页">
        {current > 1 ? <a href={base}>← 上一页</a> : <span />}
        {next ? <a href={next}>下一页 →</a> : <span />}
      </nav>
    )
  }
</Base>

<style>
  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-md);
  }

  @media (max-width: 720px) {
    .post-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--s-md);
    margin-top: var(--s-xl);
    padding-top: var(--s-md);
    border-top: 1px solid var(--line-soft);
    font-size: 14px;
  }

  .empty {
    color: var(--c-muted);
  }
</style>
