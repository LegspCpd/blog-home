---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import SupabaseLayout from "@/layouts/SupabaseLayout.astro";
import SbPageHeader from "@/components/layout/SbPageHeader.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";

const posts = await getSortedPosts();
const recentPosts = posts.slice(0, 6);
const feedUrl = `${Astro.site}rss.xml`;
---

<SupabaseLayout title={i18n(I18nKey.rss)} description={i18n(I18nKey.rssDescription)}>
  <SbPageHeader
    eyebrow="RSS"
    title={i18n(I18nKey.rss)}
    subtitle={i18n(I18nKey.rssSubtitle)}
  />

  <!-- 订阅链接 + 一键复制 -->
  <section class="su-card su-card--pad su-rss-link">
    <span class="su-rss-icon" aria-hidden="true">
      <Icon name="material-symbols:rss-feed" />
    </span>
    <div class="su-rss-text">
      <h2 class="su-heading-md">{i18n(I18nKey.rssLink)}</h2>
      <p class="su-caption su-text-mute">{i18n(I18nKey.rssCopyToReader)}</p>
      <code class="su-rss-url">{feedUrl}</code>
    </div>
    <button
      type="button"
      id="copy-rss-btn"
      class="su-btn su-btn--primary su-btn--sm"
      data-url={feedUrl}
      data-copied-text={i18n(I18nKey.rssCopied)}
      data-failed-text={i18n(I18nKey.rssCopyFailed)}
    >
      {i18n(I18nKey.rssCopyLink)}
    </button>
  </section>

  <!-- 最新文章 -->
  <section class="su-section-sm">
    <h2 class="su-section-title su-rss-sub">
      <Icon name="material-symbols:article" />
      {i18n(I18nKey.rssLatestPosts)}
    </h2>

    {
      recentPosts.length > 0 ? (
        <ul class="su-list">
          {recentPosts.map((post) => (
            <li>
              <a class="su-row" href={`/posts/${post.id}/`}>
                <time class="su-row-date" datetime={post.data.published.toISOString()}>
                  {formatDateToYYYYMMDD(post.data.published)}
                </time>
                <span class="su-row-title">{post.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="su-body-md su-text-mute">暂无文章。</p>
      )
    }
  </section>

  <!-- RSS 说明 -->
  <section class="su-prose-page su-rss-about">
    <h2 class="su-section-title su-rss-sub">
      <Icon name="material-symbols:help-outline" />
      {i18n(I18nKey.rssWhatIsRSS)}
    </h2>
    <p class="su-body-md">{i18n(I18nKey.rssWhatIsRSSDescription)}</p>
    <ul class="su-rss-benefits">
      <li>{i18n(I18nKey.rssBenefit1)}</li>
      <li>{i18n(I18nKey.rssBenefit2)}</li>
      <li>{i18n(I18nKey.rssBenefit3)}</li>
      <li>{i18n(I18nKey.rssBenefit4)}</li>
    </ul>
    <p class="su-body-sm su-text-mute">{i18n(I18nKey.rssHowToUse)}</p>
  </section>
</SupabaseLayout>

<script>
	function initRssCopy() {
		const copyBtn = document.getElementById("copy-rss-btn");
		if (!copyBtn) return;

		// 克隆节点，丢掉旧监听器，避免 swup 切页后重复绑定。
		if ((copyBtn as HTMLElement).dataset.bound === "true") return;
		const newBtn = copyBtn.cloneNode(true) as HTMLElement;
		newBtn.dataset.bound = "true";
		copyBtn.parentNode?.replaceChild(newBtn, copyBtn);

		newBtn.addEventListener("click", async function () {
			const url = this.getAttribute("data-url");
			if (!url) return;
			const original = this.textContent;
			try {
				await navigator.clipboard.writeText(url);
				this.textContent = this.getAttribute("data-copied-text") || "";
				this.classList.add("is-copied");
				setTimeout(() => {
					this.textContent = original;
					this.classList.remove("is-copied");
				}, 2000);
			} catch (err) {
				console.error("复制失败:", err);
				this.textContent = this.getAttribute("data-failed-text") || "";
				setTimeout(() => {
					this.textContent = original;
				}, 2000);
			}
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initRssCopy);
	} else {
		initRssCopy();
	}

	// swup 切页后重新绑定
	document.addEventListener("swup:contentReplaced", () => {
		setTimeout(initRssCopy, 0);
	});
	if (window.swup?.hooks) {
		window.swup.hooks.on("content:replace", () => setTimeout(initRssCopy, 100));
	}
</script>

<style>
	.su-rss-link {
		display: flex;
		align-items: center;
		gap: 20px;
		flex-wrap: wrap;
	}

	.su-rss-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: none;
		width: 44px;
		height: 44px;
		border-radius: var(--su-radius-md);
		background-color: var(--su-primary);
		color: var(--su-primary-foreground);
		font-size: 22px;
	}

	.su-rss-text {
		flex: 1;
		min-width: 220px;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.su-rss-url {
		margin-top: 4px;
		padding: 2px 6px;
		border: 1px solid var(--su-border);
		border-radius: var(--su-radius-xs);
		background-color: var(--su-muted);
		font-family: var(--font-mono-supabase);
		font-size: 13px;
		color: var(--su-foreground);
		word-break: break-all;
	}

	#copy-rss-btn.is-copied {
		background-color: var(--su-primary-deep);
		border-color: var(--su-primary-deep);
	}

	.su-rss-sub {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 20px;
	}

	.su-rss-sub :global(svg) {
		color: var(--su-primary);
	}

	.su-rss-about {
		margin-top: 48px;
		padding-top: 32px;
		border-top: 1px solid var(--su-border);
	}

	.su-rss-benefits {
		margin: 16px 0;
		padding-left: 22px;
		list-style: disc;
		color: var(--su-foreground);
	}

	.su-rss-benefits li {
		margin: 8px 0;
		font-size: 15px;
		line-height: 1.7;
	}

	@media (max-width: 640px) {
		.su-rss-link {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>