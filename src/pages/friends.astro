---
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import {
	commentConfig,
	friendsPageConfig,
	getEnabledFriends,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import SupabaseLayout from "@/layouts/SupabaseLayout.astro";
import SbPageHeader from "@/components/layout/SbPageHeader.astro";

// 检查页面是否启用
if (!siteConfig.pages.friends) {
	return Astro.redirect("/404/");
}

const friendsPost = await getEntry("spec", "friends");

if (!friendsPost) {
	throw new Error("friends page content not found");
}

const { Content } = await render(friendsPost);

// 检查评论系统是否启用
const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	friendsPageConfig.showComment !== false;

// 使用配置文件中的友链数据，按权重排序
const items = getEnabledFriends();
const allTags = [...new Set(items.flatMap((item) => item.tags || []))].sort();

// 页面标题和描述
const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description =
	friendsPageConfig.description || i18n(I18nKey.friendsDescription);
---

<SupabaseLayout title={title} description={description}>
  <SbPageHeader title={title} subtitle={description} />

  <div class="friends-page">
    <!-- 标签筛选 -->
    {items.length > 0 ? (
      <div class="friend-filter mb-6 flex flex-wrap gap-2">
          <button
            data-tag="all"
            class="su-btn su-btn--primary text-sm"
          >
            {i18n(I18nKey.all)}
          </button>
          {allTags.map((tag) => (
            <button
              data-tag={tag}
              class="su-btn su-btn--outline text-sm"
            >
              {tag}
            </button>
          ))}
        </div>
      ) : null}

    <div class="friends-grid">
      {items.map((item) => (
          <a
            href={item.siteurl}
            target="_blank"
            rel="noopener noreferrer"
            data-tags={item.tags?.join(",")}
            class="friend-card su-card"
          >
            <div class="friend-avatar">
              <img src={item.imgurl} alt={item.title} />
            </div>
            <div class="friend-info">
              <div class="friend-header">
                <h3 class="friend-title">{item.title}</h3>
                <a href={item.siteurl} target="_blank" rel="noopener noreferrer" class="su-link">
                  <Icon name="material-symbols:arrow-outward-rounded" />
                </a>
              </div>
              <p class="friend-desc">{item.desc}</p>
              <div class="friend-tags">
                {item.tags && item.tags.length > 0
                  ? item.tags.slice(0, 3).map((tag) => (
                    <span class="su-pill su-pill--outline">{tag}</span>
                  ))
                  : null}
              </div>
            </div>
          </a>
        ))
      }
    </div>

    {friendsPageConfig.showCustomContent !== false ? (
      <div class="mt-6 su-prose-page">
        <Markdown class="">
          <Content />
        </Markdown>
      </div>
    ) : null}

    <!-- 评论区 -->
    {isCommentEnabled ? (
      <div class="mt-6">
        <Comment post={friendsPost} customPath="/friends/" />
      </div>
    ) : null}
  </div>
</SupabaseLayout>

<script is:inline>
if (!customElements.get("friend-filter")) {
  class FriendFilter extends HTMLElement {
    constructor() { super(); }
    connectedCallback() { this.addEventListener("click", this.handleClick); }
    disconnectedCallback() { this.removeEventListener("click", this.handleClick); }

    handleClick(e) {
      const button = e.target.closest("button");
      if (!button) return;
      const selectedTag = button.dataset.tag;
      const filters = this.querySelectorAll("button");
      const container = this.closest(".friends-page");
      if (!container) return;
      const cards = container.querySelectorAll(".friend-card");

      filters.forEach((f) => {
        f.classList.remove("su-btn--primary");
        f.classList.add("su-btn--outline");
        if (f === button) {
          f.classList.remove("su-btn--outline");
          f.classList.add("su-btn--primary");
        }
      });

      cards.forEach((card) => {
        const tags = (card.dataset.tags || "").split(",");
        if (selectedTag === "all" || (selectedTag && tags.includes(selectedTag))) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }
      });
    }
  }
  customElements.define("friend-filter", FriendFilter);
}
</script>

<style>
  .friends-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .friend-card {
    display: flex;
    gap: 1rem;
    padding: 1rem;
    text-decoration: none;
    color: inherit;
  }

  .friend-avatar {
    width: 64px;
    height: 64px;
    border-radius: 12px;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--su-canvas-soft);
  }

  .friend-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .friend-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
  }

  .friend-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .friend-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--su-foreground);
    truncate: true;
  }

  .friend-desc {
    font-size: 0.875rem;
    color: var(--su-muted-foreground);
    line-clamp: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .friend-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (max-width: 640px) {
    .friend-card {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .friend-header {
      justify-content: center;
    }
  }
</style>