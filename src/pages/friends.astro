---
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import {
	commentConfig,
	friendsPageConfig,
	getEnabledFriends,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import SupabaseLayout from "@/layouts/SupabaseLayout.astro";

// 检查页面是否启用
if (!siteConfig.pages.friends) {
	return Astro.redirect("/404/");
}

const friendsPost = await getEntry("spec", "friends");

if (!friendsPost) {
	throw new Error("friends page content not found");
}

const { Content } = await render(friendsPost);

const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	friendsPageConfig.showComment !== false;

const items = getEnabledFriends();
const allTags = [...new Set(items.flatMap((item) => item.tags || []))].sort();

const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description =
	friendsPageConfig.description || i18n(I18nKey.friendsDescription);
---

<SupabaseLayout title={title} description={description}>
  <div class="su-friends-page">
    <header class="su-page-head">
      <p class="su-kicker">{i18n(I18nKey.friends)}</p>
      <h1 class="su-title">{title}</h1>
      {description && <p class="su-page-desc">{description}</p>}
      <p class="su-page-count">
        <span class="su-num">{items.length}</span> 位朋友
      </p>
    </header>

    {
      items.length > 0 && (
        <friend-filter class="su-filter-row">
          <button type="button" data-tag="all" class="su-pill is-active">
            {i18n(I18nKey.all)}
          </button>
          {allTags.map((tag) => (
            <button type="button" data-tag={tag} class="su-pill">
              {tag}
            </button>
          ))}
        </friend-filter>
      )
    }

    <div class="su-friends-grid">
      {
        items.map((item) => (
          <a
            href={item.siteurl}
            target="_blank"
            rel="noopener noreferrer"
            data-tags={item.tags?.join(",")}
            class="su-friend"
          >
            <img
              class="su-friend-avatar"
              src={item.imgurl}
              alt={item.title}
              width="40"
              height="40"
              loading="lazy"
              decoding="async"
              onerror="this.style.visibility='hidden'"
            />
            <span class="su-friend-body">
              <span class="su-friend-name">
                {item.title}
                <Icon name="material-symbols:arrow-outward" width="12" height="12" />
              </span>
              <span class="su-friend-desc" title={item.desc}>
                {item.desc}
              </span>
              {item.tags && item.tags.length > 0 && (
                <span class="su-friend-tags">
                  {item.tags.slice(0, 3).map((tag) => (
                    <span class="su-friend-tag">#{tag}</span>
                  ))}
                </span>
              )}
            </span>
          </a>
        ))
      }
    </div>

    {
      friendsPageConfig.showCustomContent !== false && (
        <section class="su-friends-extra">
          <Markdown class="markdown-content">
            <Content />
          </Markdown>
        </section>
      )
    }

    {isCommentEnabled && <Comment post={friendsPost} customPath="/friends/" />}
  </div>

  <script slot="head" is:inline>
    if (!customElements.get("friend-filter")) {
      class FriendFilter extends HTMLElement {
        connectedCallback() {
          this.addEventListener("click", this.handleClick);
        }

        disconnectedCallback() {
          this.removeEventListener("click", this.handleClick);
        }

        handleClick(e) {
          const button = e.target.closest("button");
          if (!button) return;

          const selectedTag = button.dataset.tag;
          const root = this.closest(".su-friends-page") || document;
          const cards = root.querySelectorAll(".su-friend");

          this.querySelectorAll("button").forEach((f) => {
            f.classList.toggle("is-active", f === button);
          });

          cards.forEach((card) => {
            const tags = (card.dataset.tags || "").split(",");
            const visible =
              selectedTag === "all" ||
              (selectedTag && tags.includes(selectedTag));
            card.hidden = !visible;
          });
        }
      }
      customElements.define("friend-filter", FriendFilter);
    }
  </script>
</SupabaseLayout>

<style>
  .su-friends-page {
    max-width: 1080px;
    margin-inline: auto;
  }

  .su-page-head {
    margin-bottom: 32px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--su-border);
  }

  .su-title {
    margin: 8px 0 12px;
  }

  .su-page-desc {
    margin: 0 0 12px;
    max-width: 640px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--su-muted-foreground);
  }

  .su-page-count {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    font-size: 13px;
    color: var(--su-muted-foreground);
  }

  .su-filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }

  .su-filter-row button {
    cursor: pointer;
  }

  .su-friends-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 12px;
  }

  .su-friend {
    display: flex;
    /* 头像与文字块垂直居中：卡片文案可能是 1～3 行，
       用 flex-start 会让 40px 头像黏在顶部、下方留一大块空白 */
    align-items: center;
    gap: 12px;
    padding: 14px;
    border: 1px solid var(--su-border);
    border-radius: 12px;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .su-friend:hover {
    background-color: var(--su-accent);
    border-color: var(--su-muted-foreground);
  }

  .su-friend[hidden] {
    display: none;
  }

  .su-friend-avatar {
    display: block;
    flex: none;
    align-self: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--su-border);
    border-radius: 8px;
    object-fit: cover;
    /* 加载失败时是中性色块而不是破图图标 */
    background-color: var(--su-muted);
    vertical-align: middle;
  }

  .su-friend-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .su-friend-name {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    overflow: hidden;
    font-size: 16px;
    font-weight: 500;
    color: var(--su-foreground);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .su-friend:hover .su-friend-name {
    color: var(--su-primary);
  }

  .su-friend-desc {
    overflow: hidden;
    font-size: 13px;
    line-height: 1.5;
    color: var(--su-muted-foreground);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .su-friend-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }

  .su-friend-tag {
    font-family: var(--font-mono-supabase);
    font-size: 11px;
    color: var(--su-ink-faint);
  }

  .su-friends-extra {
    margin-top: 64px;
    padding-top: 40px;
    border-top: 1px solid var(--su-border);
  }

  .su-friends-extra :global(.custom-md) {
    max-width: 820px;
  }
</style>
