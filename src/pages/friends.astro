---
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import {
	commentConfig,
	friendsPageConfig,
	getEnabledFriends,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import SupabaseLayout from "@/layouts/SupabaseLayout.astro";
import SbPageHeader from "@/components/layout/SbPageHeader.astro";
import { getSiteAvatar } from "@utils/site-avatar";

// 检查页面是否启用
if (!siteConfig.pages.friends) {
	return Astro.redirect("/404/");
}

const friendsPost = await getEntry("spec", "friends");

if (!friendsPost) {
	throw new Error("friends page content not found");
}

const { Content } = await render(friendsPost);

// 检查评论系统是否启用
const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	friendsPageConfig.showComment !== false;

// 使用配置文件中的友链数据，按权重排序
const items = getEnabledFriends();
const allTags = [...new Set(items.flatMap((item) => item.tags || []))].sort();

// 页面标题和描述
const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description =
	friendsPageConfig.description || i18n(I18nKey.friendsDescription);

// 申请友链所需信息：头像走统一解析（src 相对路径也能得到可用 URL）
const avatarUrl = (await getSiteAvatar()).src;

const applyText = [
	"站点名称：" + siteConfig.title,
	"站点描述：" + siteConfig.description,
	"站点链接：" + siteConfig.site_url,
	"头像链接：" + avatarUrl,
].join("\n");
---

<SupabaseLayout title={title} description={description}>
  <SbPageHeader
    eyebrow="Friends"
    title={title}
    subtitle={description}
  >
    <p class="su-page-meta">
      <span class="su-num">{items.length}</span> 位友链
      <span class="su-dot">·</span>
      <span>共 <span class="su-num">{allTags.length}</span> 个标签</span>
    </p>
  </SbPageHeader>

  <!-- 申请友链信息：一键复制，省去手动誊抄 -->
  <section class="fr-apply" aria-label="申请友链">
    <div class="fr-apply-head">
      <h2 class="su-heading-md">申请友链</h2>
      <p class="su-caption su-text-mute">
        先在您的站点添加本站信息，再把下面这段发给站点主人。
      </p>
    </div>

    <dl class="fr-apply-grid">
      <div>
        <dt>站点名称</dt>
        <dd>{siteConfig.title}</dd>
      </div>
      <div>
        <dt>站点描述</dt>
        <dd>{siteConfig.description}</dd>
      </div>
      <div>
        <dt>站点链接</dt>
        <dd class="su-mono">{siteConfig.site_url}</dd>
      </div>
      <div>
        <dt>头像链接</dt>
        <dd class="su-mono">{avatarUrl}</dd>
      </div>
    </dl>

    <div class="fr-apply-actions">
      <button
        type="button"
        class="su-btn su-btn--outline su-btn--sm"
        data-fr-copy={applyText}
        data-fr-copied="已复制"
        data-fr-failed="复制失败"
      >
        <Icon name="material-symbols:content-copy" />
        <span>复制申请信息</span>
      </button>
    </div>
  </section>

  <!-- 标签筛选 -->
  {
    items.length > 0 && allTags.length > 0 ? (
      <div class="friend-filter su-page-tabs">
        <button
          type="button"
          data-tag="all"
          class="su-btn su-btn--primary su-btn--sm"
        >
          {i18n(I18nKey.all)}
        </button>
        {allTags.map((tag) => (
          <button type="button" data-tag={tag} class="su-btn su-btn--outline su-btn--sm">
            {tag}
          </button>
        ))}
      </div>
    ) : null
  }

  <!-- 友链卡片网格 -->
  {
    items.length > 0 ? (
      <ul class="friends-grid su-animate">
        {items.map((item) => (
          <li>
            <a
              class="su-card su-card--hover friend-card"
              href={item.siteurl}
              target="_blank"
              rel="noopener noreferrer"
              data-tags={item.tags?.join(",")}
            >
              <span class="friend-avatar">
                <img
                  src={item.imgurl}
                  alt={item.title}
                  loading="lazy"
                  referrerpolicy="no-referrer"
                  onerror="this.remove()"
                />
              </span>

              <span class="friend-body">
                <span class="friend-head">
                  <span class="friend-name">{item.title}</span>
                  <Icon
                    name="material-symbols:arrow-outward-rounded"
                    class="friend-arrow"
                  />
                </span>

                <span class="friend-desc">{item.desc}</span>

                {item.tags && item.tags.length > 0 ? (
                  <span class="friend-tags">
                    {item.tags.slice(0, 3).map((tag) => (
                      <span class="su-pill su-pill--outline">{tag}</span>
                    ))}
                  </span>
                ) : null}
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="su-body-md su-text-mute">还没有友链。</p>
    )
  }

  <!-- 站点自定义内容（申请友链说明等） -->
  {
    friendsPageConfig.showCustomContent !== false ? (
      <section class="su-prose-page su-friends-custom">
        <Markdown class="">
          <Content />
        </Markdown>
      </section>
    ) : null
  }

  <!-- 评论区 -->
  {isCommentEnabled ? <Comment post={friendsPost} customPath="/friends/" /> : null}
</SupabaseLayout>

<script is:inline>
	// 复制申请信息。
	// 用 data-* 携带文案，避免把多行中文塞进 inline script 造成转义问题。
	document.addEventListener("click", function (e) {
		var btn = e.target.closest("[data-fr-copy]");
		if (!btn) return;

		var text = btn.getAttribute("data-fr-copy") || "";
		var okText = btn.getAttribute("data-fr-copied") || "已复制";
		var failText = btn.getAttribute("data-fr-failed") || "复制失败";
		var label = btn.querySelector("span");
		var original = label ? label.textContent : null;

		var done = function (msg) {
			if (label) label.textContent = msg;
			btn.classList.add("is-done");
			setTimeout(function () {
				if (label && original !== null) label.textContent = original;
				btn.classList.remove("is-done");
			}, 2000);
		};

		if (navigator.clipboard && window.isSecureContext) {
			navigator.clipboard.writeText(text).then(
				function () {
					done(okText);
				},
				function () {
					done(failText);
				},
			);
			return;
		}

		// 非安全上下文（http 访问）下 clipboard API 不可用，退回 execCommand
		try {
			var ta = document.createElement("textarea");
			ta.value = text;
			ta.setAttribute("readonly", "");
			ta.style.position = "fixed";
			ta.style.top = "-1000px";
			document.body.appendChild(ta);
			ta.select();
			var ok = document.execCommand("copy");
			document.body.removeChild(ta);
			done(ok ? okText : failText);
		} catch (err) {
			done(failText);
		}
	});

	// 标签筛选：沿用原有交互，仅切换卡片显隐与按钮态。
	if (!customElements.get("friend-filter")) {
		class FriendFilter extends HTMLElement {
			connectedCallback() {
				this.addEventListener("click", this.handleClick);
			}
			disconnectedCallback() {
				this.removeEventListener("click", this.handleClick);
			}
			handleClick(e) {
				const button = e.target.closest("button");
				if (!button || !this.contains(button)) return;
				const selected = button.dataset.tag;
				const buttons = this.querySelectorAll("button");
				const cards = document.querySelectorAll(".friend-card");

				for (const b of buttons) {
					const on = b === button;
					b.classList.toggle("su-btn--primary", on);
					b.classList.toggle("su-btn--outline", !on);
					b.setAttribute("aria-pressed", on ? "true" : "false");
				}
				for (const card of cards) {
					const tags = (card.dataset.tags || "").split(",").filter(Boolean);
					const show = selected === "all" || tags.includes(selected);
					card.parentElement.style.display = show ? "" : "none";
				}
			}
		}
		customElements.define("friend-filter", FriendFilter);
	}
</script>

<style>
	/* ---- 申请友链 ---- */
	.fr-apply {
		padding: 20px;
		margin-bottom: 28px;
		border: 1px solid var(--su-border);
		border-radius: var(--su-radius-lg);
		background-color: var(--su-canvas-soft);
	}

	.fr-apply-head {
		margin-bottom: 16px;
	}

	.fr-apply-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 12px 20px;
		margin: 0 0 16px;
	}

	.fr-apply-grid dt {
		font-size: 12px;
		color: var(--su-muted-foreground);
		margin-bottom: 3px;
	}

	.fr-apply-grid dd {
		margin: 0;
		font-size: 14px;
		line-height: 1.5;
		color: var(--su-foreground);
		/* 描述可能较长，限制两行 */
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* 链接类字段可能很长，允许换行而不是撑破容器 */
	.fr-apply-grid dd.su-mono {
		font-size: 12px;
		word-break: break-all;
		-webkit-line-clamp: 2;
		line-clamp: 2;
	}

	.fr-apply-actions {
		display: flex;
		gap: 8px;
	}

	/* 复制成功后按钮短暂变绿，给出明确反馈 */
	[data-fr-copy].is-done {
		border-color: var(--su-primary);
		color: var(--su-primary-deep);
	}

	/* ---- 友链网格 ---- */
	.friends-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.friend-card {
		display: flex;
		align-items: center;
		gap: 16px;
		height: 100%;
		padding: 16px;
		text-decoration: none;
		color: inherit;
	}

	.friend-avatar {
		position: relative;
		flex: none;
		width: 56px;
		height: 56px;
		border: 1px solid var(--su-border);
		border-radius: var(--su-radius-md);
		background-color: var(--su-muted);
		overflow: hidden;
	}

	.friend-avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.friend-body {
		display: flex;
		flex-direction: column;
		gap: 6px;
		min-width: 0;
		flex: 1;
	}

	.friend-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
	}

	.friend-name {
		font-size: 16px;
		font-weight: 500;
		line-height: 1.4;
		color: var(--su-foreground);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		transition: color 0.15s ease;
	}

	.friend-card:hover .friend-name {
		color: var(--su-primary);
	}

	/* 外链箭头：默认隐藏，悬停时出现（强调色稀缺） */
	.friend-arrow {
		flex: none;
		font-size: 16px;
		color: var(--su-primary);
		opacity: 0;
		transform: translateX(-4px);
		transition:
			opacity 0.15s ease,
			transform 0.15s ease;
	}

	.friend-card:hover .friend-arrow {
		opacity: 1;
		transform: translateX(0);
	}

	.friend-desc {
		font-size: 13px;
		line-height: 1.5;
		color: var(--su-muted-foreground);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.friend-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 2px;
	}

	.su-friends-custom {
		margin-top: 48px;
		padding-top: 32px;
		border-top: 1px solid var(--su-border);
	}

	@media (max-width: 640px) {
		.friend-card {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>