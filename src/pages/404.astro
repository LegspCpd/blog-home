---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import SupabaseLayout from "@/layouts/SupabaseLayout.astro";
import SbPageHeader from "@/components/layout/SbPageHeader.astro";
import { url } from "@/utils/url-utils";
---

<SupabaseLayout title={i18n(I18nKey.notFound)} description={i18n(I18nKey.notFoundDescription)}>
  <SbPageHeader title={i18n(I18nKey.notFoundTitle)} />
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <div class="sb-404 sb-animate su-prose-page text-center">
    <div class="sb-404__code su-mono">{i18n(I18nKey.notFound)}</div>
    <h1 class="su-display-lg mb-4">{i18n(I18nKey.notFoundTitle)}</h1>
    <p class="su-body-md su-text-mute max-w-[44ch] mx-auto mb-8">{i18n(I18nKey.notFoundDescription)}</p>
    <a href={url("/")} class="su-btn su-btn--primary">
      <Icon name="material-symbols:home" />
      {i18n(I18nKey.backToHome)}
    </a>
  </div>
</SupabaseLayout>

<style>
  .sb-404 {
    min-height: 56vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-block: 64px;
  }

  .sb-404__code {
    font-size: 96px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -3px;
    color: var(--su-primary);
    margin-bottom: 24px;
  }

  @media (max-width: 640px) {
    .sb-404__code {
      font-size: 64px;
      letter-spacing: -2px;
    }
  }
</style>