---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import SupabaseLayout from "@/layouts/SupabaseLayout.astro";
import { pagesConfig } from "@/config";
import { siteConfig } from "@/config/siteConfig";
import { url } from "@/utils/url-utils";

const cfg = pagesConfig.notFound;

// 快捷入口：取最常用的几项，让访客一步回到正轨
const quickLinks = [
	{ label: "首页", href: "/", icon: "material-symbols:home-outline" },
	{ label: "文章", href: "/posts/", icon: "material-symbols:article-outline" },
	{ label: "归档", href: "/archive/", icon: "material-symbols:archive-outline" },
	{ label: "项目", href: "/projects/", icon: "material-symbols:deployed-code-outline" },
	{ label: "搜索", href: "/search/", icon: "material-symbols:search" },
].slice(0, cfg.maxNavItems);
---

<SupabaseLayout
	title={i18n(I18nKey.notFound)}
	description={i18n(I18nKey.notFoundDescription)}
>
	<meta slot="head" name="robots" content="noindex, nofollow" />

	<div class="nf su-prose-page su-animate">
		<!-- 错误码：视觉主体 -->
		<div class="nf-code" aria-hidden="true">404</div>

		<p class="su-kicker su-text-mute">{cfg.diagnostics.status}</p>
		<h1 class="su-display-lg nf-title">{i18n(I18nKey.notFoundTitle)}</h1>
		<p class="su-body-lg su-text-mute nf-lead">{cfg.lead}</p>

		<div class="nf-actions">
			<a href={url("/")} class="su-btn su-btn--primary">
				<Icon name="material-symbols:home-outline" />
				{i18n(I18nKey.backToHome)}
			</a>
			<a href={url("/search/")} class="su-btn su-btn--outline">
				<Icon name="material-symbols:search" />
				搜索站内内容
			</a>
		</div>

		<!-- 常见成因 -->
		<section class="nf-causes">
			<h2 class="su-heading-md">可能的原因</h2>
			<ul>
				{
					cfg.causes.map((cause) => (
						<li>
							<Icon name="material-symbols:chevron-right" />
							<span>{cause}</span>
						</li>
					))
				}
			</ul>
		</section>

		<!--
		  Cloudflare 风格诊断面板：
		  参考 donlon/cloudflare-error-page 的思路 —— 把边缘节点、Ray ID 这类
		  本来只出现在开发者工具里的信息，直接摆到访客面前，方便其自查或反馈。
		  取不到真实值时对应行保持隐藏，不显示空壳。
		-->
		{
			cfg.showDiagnostics ? (
				<section class="nf-diag su-card" data-nf-diagnostics>
					<header class="nf-diag-head">
						<span class="nf-diag-dot" aria-hidden="true" />
						<h2 class="su-heading-md">请求诊断</h2>
						<span class="su-caption su-text-faint su-mono nf-diag-edge">
							{cfg.diagnostics.edge}
						</span>
					</header>

					<dl class="nf-diag-grid">
						<div class="nf-diag-row">
							<dt>状态</dt>
							<dd class="su-mono">{cfg.diagnostics.status}</dd>
						</div>
						<div class="nf-diag-row" data-diag-field="ray" hidden>
							<dt>Ray ID</dt>
							<dd class="su-mono" data-diag-value="ray">—</dd>
						</div>
						<div class="nf-diag-row" data-diag-field="colo" hidden>
							<dt>Colo</dt>
							<dd class="su-mono" data-diag-value="colo">—</dd>
						</div>
						<div class="nf-diag-row" data-diag-field="country" hidden>
							<dt>访客地区</dt>
							<dd class="su-mono" data-diag-value="country">—</dd>
						</div>
					</dl>

					<p class="su-caption su-text-mute nf-diag-hint">
						{cfg.diagnostics.hint}
					</p>
				</section>
			) : null
		}

		<!-- 快捷入口 -->
		<nav class="nf-links" aria-label={cfg.helpfulTitle}>
			<h2 class="su-heading-md">{cfg.helpfulTitle}</h2>
			<ul>
				{
					quickLinks.map((link) => (
						<li>
							<a href={url(link.href)} class="su-pill su-pill--outline">
								<Icon name={link.icon} />
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<p class="nf-foot su-caption su-text-faint">
			{siteConfig.title} · <span class="su-mono">/</span>
		</p>
	</div>

	<script is:inline>
		// 诊断面板：仅在拿得到真实边缘信息时才展示对应行。
		// Cloudflare / EdgeOne 会把请求 ID、节点等信息注入 meta 或响应头，
		// 静态 404 产物里通常读不到，此时隐藏对应行而不是显示空壳。
		(function () {
			var panel = document.querySelector("[data-nf-diagnostics]");
			if (!panel) return;

			var set = function (field, value) {
				if (!value) return;
				var row = panel.querySelector('[data-diag-field="' + field + '"]');
				var cell = panel.querySelector('[data-diag-value="' + field + '"]');
				if (!row || !cell) return;
				cell.textContent = value;
				row.hidden = false;
			};

			var metas = document.querySelectorAll(
				'meta[name^="cf-"], meta[name^="eo-"]',
			);
			metas.forEach(function (m) {
				var name = (m.getAttribute("name") || "").toLowerCase();
				var val = m.getAttribute("content");
				if (!val) return;
				if (name === "cf-ray" || name === "eo-ray") set("ray", val);
				if (name === "cf-meta-colo" || name === "eo-colo") set("colo", val);
				if (name === "cf-meta-country" || name === "eo-country") {
					set("country", val);
				}
			});
		})();
	</script>
</SupabaseLayout>

<style>
	.nf {
		max-width: 680px;
		margin-inline: auto;
		padding-block: 24px 80px;
	}

	.nf-code {
		font-family: var(--font-mono-supabase);
		font-size: clamp(88px, 18vw, 148px);
		font-weight: 600;
		line-height: 0.9;
		letter-spacing: -6px;
		color: var(--su-primary);
		margin-bottom: 20px;
	}

	.nf-title {
		margin: 8px 0 12px;
	}

	.nf-lead {
		max-width: 52ch;
	}

	.nf-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 28px;
	}

	/* ---- 常见成因 ---- */
	.nf-causes {
		margin-top: 40px;
		padding-top: 28px;
		border-top: 1px solid var(--su-border);
	}

	.nf-causes ul {
		margin: 14px 0 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.nf-causes li {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 14px;
		color: var(--su-muted-foreground);
	}

	.nf-causes li :global(svg) {
		font-size: 16px;
		color: var(--su-ink-faint);
		flex: none;
	}

	/* ---- 诊断面板 ---- */
	.nf-diag {
		margin-top: 32px;
		padding: 20px;
		background-color: var(--su-canvas-soft);
	}

	.nf-diag-head {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 16px;
	}

	.nf-diag-dot {
		width: 8px;
		height: 8px;
		border-radius: var(--su-radius-full);
		background-color: var(--su-primary);
		flex: none;
		box-shadow: 0 0 0 3px var(--su-primary-soft);
	}

	.nf-diag-edge {
		margin-left: auto;
	}

	.nf-diag-grid {
		margin: 0;
		border: 1px solid var(--su-border);
		border-radius: var(--su-radius-md);
		overflow: hidden;
		background-color: var(--su-card);
	}

	.nf-diag-row {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 9px 14px;
		font-size: 13px;
		border-top: 1px solid var(--su-border);
	}

	.nf-diag-row:first-child {
		border-top: 0;
	}

	.nf-diag-row dt {
		flex: none;
		width: 88px;
		color: var(--su-muted-foreground);
	}

	.nf-diag-row dd {
		margin: 0;
		color: var(--su-foreground);
		word-break: break-all;
	}

	.nf-diag-hint {
		margin-top: 14px;
	}

	/* ---- 快捷入口 ---- */
	.nf-links {
		margin-top: 32px;
		padding-top: 28px;
		border-top: 1px solid var(--su-border);
	}

	.nf-links ul {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 14px 0 0;
		padding: 0;
		list-style: none;
	}

	.nf-links a {
		padding: 6px 12px;
		font-family: var(--font-supabase);
	}

	.nf-foot {
		margin-top: 40px;
	}

	@media (max-width: 640px) {
		.nf-code {
			letter-spacing: -3px;
		}
		.nf-diag-row {
			flex-direction: column;
			align-items: flex-start;
			gap: 2px;
		}
		.nf-diag-row dt {
			width: auto;
		}
	}
</style>