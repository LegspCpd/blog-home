---
import Base from "../layouts/Base.astro";
---

<Base title="404 · 页面不存在" path="/404/">
  <div class="nf">
    <p class="code">404</p>
    <h1>页面不存在</h1>
    <p class="hint">你访问的页面可能已被移动或删除。</p>
    <!-- 真正的 Fluent Web Component；未升级时靠下方 :not(:defined) 兜底 -->
    <fluent-button class="home" appearance="accent" href="/">返回首页</fluent-button>
  </div>
</Base>

<style>
  .nf { text-align: center; padding-block: 80px; }
  .code {
    margin: 0;
    font-size: 72px;
    font-weight: 700;
    color: var(--colorBrandForeground1);
    line-height: 1;
  }
  h1 { margin: 12px 0 8px; font-size: var(--fontSizeBase500); }
  .hint { margin: 0 0 28px; color: var(--colorNeutralForeground3); }

  /* 升级前：custom element 是未定义的，给出接近最终态的降级外观 */
  .home {
    display: inline-block;
    padding: 8px 20px;
    border-radius: var(--borderRadiusMedium);
    background: var(--colorBrandBackground);
    color: var(--colorNeutralForegroundOnBrand);
    font-size: var(--fontSizeBase200);
    text-decoration: none;
  }
  .home:hover { background: var(--colorBrandBackgroundHover); text-decoration: none; }
</style>
