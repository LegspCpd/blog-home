---
/**
 * SupabaseLayout — Supabase 设计系统的全站默认 Layout
 *
 * 结构：复用 Layout.astro（SEO / 主题 / 分析 / 背景等既有能力），
 *       把内容区换成「可折叠左侧 Sidebar + 右侧主内容区」。
 *
 * ⚠️ 刻意不做任何 DOM 搬移：侧栏与主内容区是普通兄弟节点，
 *    主内容区只用 CSS 让出侧栏宽度（见 supabase-layout.css）。
 *    早期实现用脚本把 #su-main 搬进 Sidebar 的 Svelte island 内，
 *    但那个节点会被 hydration 随机回收，导致内容整块消失（约半数刷新）。
 */
import AppSidebar from "@components/layout/AppSidebar.astro";
import CommandPalette from "@/components/layout/CommandPalette.astro";
import { backgroundAtmosphere } from "@/config/backgroundAtmosphere";
import { defaultNavItems as navDefaults } from "@/config/sidebarNav";
import type { SidebarNavItem } from "@/config/sidebarNav";
import { getAmbientBackgroundStyle } from "@/utils/ambient-background";
import { siteConfig } from "@/config/siteConfig";
import { url } from "@/utils/url-utils";
// 顺序要紧：令牌层必须在所有消费方之前，否则首帧 var() 解析不到会闪一下。
import "../styles/supabase-tokens.css";
// 组件层：可复用的 su-* 工具类（排版层级/卡片/按钮/标签/动效等）。
import "../styles/supabase-components.css";
import "../styles/supabase-content.css";
import "./supabase-layout.css";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	/** SEO：文章页标记 og:type=article */
	setOGTypeArticle?: boolean;
	/** SEO：文章 slug */
	postSlug?: string;
	/** SEO：og:image */
	ogImage?: string;
	/** 可选：覆盖侧栏导航项 */
	navItems?: SidebarNavItem[];
}

const {
	title,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	ogImage,
	navItems = navDefaults,
} = Astro.props;

// 背景氛围：把配置编译成 CSS 变量挂在 <main> 上，由 supabase-layout.css 消费。
// 关闭时返回 undefined → 不输出内联样式，也不加类名，等同于旧行为。
const ambientStyle = getAmbientBackgroundStyle();
---

<Layout
  title={title}
  description={description}
  lang={lang}
  setOGTypeArticle={setOGTypeArticle}
  postSlug={postSlug}
  ogImage={ogImage}
>
  <!-- 左侧可折叠 Sidebar（桌面 icon 折叠 / 移动端抽屉）
       刻意放在 #swup-container 之外：
       1) 路由切换时不被替换 → 折叠状态天然保持，且不会重新 hydration；
       2) 页面切换只需替换主内容，速度接近瞬时。 -->
  <AppSidebar items={navItems} />

  <!-- 全局命令面板：Ctrl/⌘+K 唤起。放在 swup 容器外，切页不丢状态。 -->
  <CommandPalette />

  <!-- 移动端顶栏：侧栏在窄屏收成抽屉，这里补一条固定顶栏，
       承载站点名 + 导航入口。
       放在 #swup-container 之外，跨页保持同一实例，不会重复挂载。
       导航项直接输出为普通链接 —— 抽屉依赖 Svelte hydration，
       万一脚本没跑起来，这些链接仍能保证访客可以跳转。 -->
  <div class="su-mobile-bar">
    <a href={url("/")} class="su-mobile-bar-brand">{siteConfig.title}</a>
    <nav class="su-mobile-bar-nav" aria-label="主导航">
      {
        navItems.slice(0, 4).map((item) => (
          <a href={url(item.href)} class="su-mobile-bar-link">
            {item.title}
          </a>
        ))
      }
    </nav>
  </div>

  <!-- 右侧主内容区：宽度偏移由 supabase-layout.css 控制 -->
  <main
    id="su-main"
    class:list={[
      "su-main",
      ambientStyle && "su-ambient",
      backgroundAtmosphere.interactiveElevation && "su-elevate",
    ]}
    style={ambientStyle}
  >
    <!-- swup 唯一替换容器，必须是全站每个页面都存在且结构一致 -->
    <div id="swup-container">
      <slot />
    </div>
  </main>
</Layout>
