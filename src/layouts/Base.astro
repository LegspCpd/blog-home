---
import { ClientRouter } from "astro:transitions";
import { SITE, NAV, abs } from "../config/site";
import { designVars } from "../styles/design";
import { getSearchIndex } from "../lib/search";
import Footer from "../components/win/Footer.astro";
import WinShell from "../components/win/WinShell.vue";
import "../styles/global.css";
// 终末地风味主题（endfield-ui skill）。两套主题同时存在，默认走 WinUI 3。
// 注意：不引套件那份 55KB 的 endfield.css —— 它的部件都是 .ef-* 类名，
// 而本站的换皮是在自己已有的类名上重写（见 skin.css），用不到它。
// 将来若要用套件的现成部件，再按页引入，别挂到全站。
import "../styles/endfield/tokens.css";
import "../styles/endfield/skin.css";

/**
 * ★ 页面转场 —— 对标 WinUI 3 的 drill-in。
 *
 * WinUI 的页面切换不是简单的淡入淡出，而是有**方向感**的：
 *   · 前进（点进下一层）：新内容从右侧滑入，旧内容淡出
 *   · 后退（回上一层）：反过来，从左侧滑入
 * 这正是"像是在导航层级里移动"而不是"换了一页"的来源。
 *
 * Astro 的 transition:animate 正好支持有方向的动画
 * （TransitionDirectionalAnimations：forwards / backwards）。
 *
 * 数值取 Fluent 的运动规范：
 *   进入 300ms + 减速曲线 cubic-bezier(0, 0, 0, 1)
 *   退出 167ms + 加速曲线 cubic-bezier(0.8, 0, 0.2, 1)
 * 关键帧定义在 src/styles/global.css（要全局可见）。
 */
const pageTransition = {
  forwards: {
    old: { name: "winui-page-out", duration: "167ms", easing: "cubic-bezier(0.8, 0, 0.2, 1)", fillMode: "both" },
    new: { name: "winui-page-in", duration: "300ms", easing: "cubic-bezier(0, 0, 0, 1)", fillMode: "both" },
  },
  backwards: {
    old: { name: "winui-page-out", duration: "167ms", easing: "cubic-bezier(0.8, 0, 0.2, 1)", fillMode: "both" },
    new: { name: "winui-page-in-back", duration: "300ms", easing: "cubic-bezier(0, 0, 0, 1)", fillMode: "both" },
  },
};

/**
 * 导航数据交给 Vue 外壳。
 *
 * 图标用 Segoe Fluent Icons 的字形码 —— 上游 NavigationView 直接吃字符串。
 * 注意：该字体**不可随网站分发**（上游 docs/icon-font.md 有说明），
 * 只能依赖 Windows 系统已安装的那一份。Windows 之外的平台字形会缺失，
 * 这是整个 WinUIonWeb 的既有约束，不是本项目引入的。
 */
const navItems = NAV.map((item) => ({
  Tag: item.href,
  Content: item.label,
  Icon: item.icon,
  /**
   * x:Name 会被 NavigationView 渲染成 DOM 上的 data-xaml-ref。
   *
   * 它是**事件委托导航**唯一可靠的锚点：NavigationView 自己的 ItemInvoked
   * 在这套环境里不触发（详见 WinShellClient.vue 里 attachNavigationFallback 的说明），
   * 而 data-navigation-value 只是它内部的序号（nvi-1 / nvi-2…），拿不到我们想要的地址。
   */
  "x:Name": item.href,
}));

/** 页脚项：官方规范里 FooterMenuItems 显示在「设置」项之前 */
/**
 * 页脚项：官方规范里 FooterMenuItems 显示在「设置」项之前。
 *
 * Icon 原来没给，所以左下角这两项**一直是纯文字、没有图标**。
 * 码位也是渲染出来确认过的（E71B 链接、E943 花括号）——
 * 之前设置页的「订阅 RSS」用的是 E734，那其实是个**星星**，看着不对。
 */
const footerItems = [
  { Tag: SITE.links.rss, Content: "RSS", Icon: "", "x:Name": SITE.links.rss },
  { Tag: SITE.links.github, Content: "GitHub", Icon: "", "x:Name": SITE.links.github },
];

/** 构建期生成的站内搜索索引，供标题栏的 AutoSuggestBox 使用 */
const searchIndex = await getSearchIndex();

/**
 * 设计令牌内联进 HTML。
 * 这套值是纯静态的（不随主题切换变化），但仍然必须内联：
 * 否则首屏在 CSS 加载完成前会是一片白闪，
 * 禁用 CSS 时则彻底失去配色。
 */
const vars = designVars();

interface Props {
  title?: string;
  description?: string;
  /** 页面路径，用于 canonical；默认取当前 URL */
  path?: string;
  ogImage?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
}

const {
  title,
  description = SITE.description,
  path = Astro.url.pathname,
  ogImage,
  type = "website",
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} — ${SITE.subtitle}`;
const canonical = abs(path);

// JSON-LD：统一从 SITE 派生，杜绝手写域名出错。
// 文章页额外给 BlogPosting —— 少了它就没有作者信息与文章富媒体摘要。
// 显式标注元素类型：否则 TS 会按前两个字面量收窄，
// 后面 push 带 author/publisher 的 BlogPosting 会报 2353。
const graph: Record<string, unknown>[] = [
  {
    "@type": "WebSite",
    "@id": `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.title,
    description: SITE.description,
    inLanguage: SITE.lang,
  },
  {
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: pageTitle,
    description,
    isPartOf: { "@id": `${SITE.url}/#website` },
    inLanguage: SITE.lang,
  },
];

if (type === "article" && publishedTime) {
  graph.push({
    "@type": "BlogPosting",
    "@id": `${canonical}#article`,
    url: canonical,
    headline: title ?? pageTitle,
    description,
    datePublished: publishedTime,
    ...(modifiedTime ? { dateModified: modifiedTime } : {}),
    inLanguage: SITE.lang,
    author: {
      "@type": "Person",
      name: SITE.author,
      url: SITE.url,
    },
    publisher: { "@id": `${SITE.url}/#website` },
    isPartOf: { "@id": `${canonical}#webpage` },
    ...(ogImage ? { image: [ogImage] } : {}),
    ...(tags.length ? { keywords: tags.join(", ") } : {}),
  });
}

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<!--
  html 上必须显式带 theme-dark。
  WinUIonWeb 的 theme.css 把浅色令牌定义在 `:root`，深色定义在 `.theme-dark`。
  不声明主题类时是**混合状态**：--app-bg 有 `:root:not(.theme-light)` 的深色兜底，
  但 --text-primary / ControlStroke 等仍是浅色值 ——
  实测表现为窗格里的搜索框是黑字黑边，在深色底上完全看不清。
-->
<!--
  shell-ready：把外壳变成「固定视口框架」。
  这个类从前是客户端挂载后才加的，现在**服务端就加上** ——
  因为服务端已经能渲染出一份几何一致的静态骨架（见 WinShell.vue），
  首屏就必须是固定框架，否则骨架会先按普通文档流铺一遍、再跳成框架。
-->
<html lang={SITE.lang} class="theme-dark shell-ready">
  <head>
    <!--
      ★ 主题引导脚本 —— 必须是 <head> 里第一件事，且不能 defer。

      主题是 <html> 上的一个 data 属性（data-site-theme）。
      默认主题 **WinUI 3 不打属性**；只有选了终末地风味才打上 endfield。
      浏览器解析到这里时 body 还没开始绘制，所以不会出现"先按默认主题画一帧，
      再闪成另一套"——这是这套做法能"零闪"的全部原因。

      同时把底色/字色/color-scheme 内联到 <html> 上：CSS 还在下载时，
      浏览器也得先画一个背景，内联值保证那一瞬间就是对的颜色。
      （参考站 2x.nz 的做法与此完全一致：localStorage + dataset + 内联底色。）

      为什么用 try/catch 全包：隐私模式下 localStorage 会直接抛异常，
      不允许它把首屏脚本打断。
    -->
    <script is:inline>
      (function () {
        function read() {
          try {
            return localStorage.getItem("blog:ui-theme");
          } catch (e) {
            return null; // 隐私模式下 localStorage 会抛异常
          }
        }

        function apply() {
          var r = document.documentElement;
          if (read() === "endfield") {
            r.dataset.siteTheme = "endfield";
            r.style.backgroundColor = "#f4f4f2";
            r.style.color = "#161616";
            r.style.colorScheme = "light";
          } else {
            // 回到默认主题：属性要去掉，内联样式也要清空，
            // 否则上一次的底色会留在 <html> 上。
            delete r.dataset.siteTheme;
            r.style.backgroundColor = "";
            r.style.color = "";
            r.style.colorScheme = "";
          }
        }

        apply();

        /*
         * ★ 站内跳转后必须重新贴一次。
         *
         * Astro 换页时会把新文档的 <html> 属性搬到当前文档上，
         * 而服务端渲染的 HTML 里**没有** data-site-theme（那是每个用户各自的
         * 选择，构建期不可能知道）—— 于是跳一次页属性就被抹掉了，
         * 用户会看到"选了终末地，点进文章又变回 WinUI"。
         *
         * astro:after-swap 在新 DOM 换好、**页面还没绘制**的那一刻触发，
         * 所以在这里补上不会闪。
         */
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>

    <meta charset="UTF-8" />
    <style set:html={`:root{${vars}}`}></style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--
      字体：**不再自托管任何 webfont**。
      --sans 换成 WinUI 的字体栈（Segoe UI Variable / Segoe UI）之后，
      Inter 已经没有任何地方在用，但这里原来仍每页 preload 一个 48KB 的 woff2
      —— 白付一次首屏往返，还拖慢 LCP。
      Segoe UI Variable 在 Windows 上是系统字体（零下载），
      其它平台按 --sans 的回落链走各自的系统 UI 字体；
      代码字体用 Cascadia Mono / Consolas，同样是系统字体。
    -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!--
      ★ 站内跳转（客户端路由）。
      没有它，每次点导航都是一次整页重载：重新下载 HTML/CSS/JS、
      重新水合那套 WinUI 组件（约 2.2MB）—— 慢，而且一定会闪。
      有了它，导航 = fetch 新页面的 HTML + 换掉 <body>，外壳不动。

      动画对标 WinUI 3 的页面转场：内容是淡入 + 轻微上移，
      时长 300ms、用 Fluent 的减速曲线（见下方 pageTransition）。
    -->
    <ClientRouter />

    <!-- RSS：博客必备 -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} RSS`}
      href={abs("/rss.xml")}
    />
    <!--
      图标。注意路径是 /favicon/favicon.ico ——
      这里原来写的是 /favicon.ico，全站 54 个页面每次访问都在请求一个不存在的文件。

      这一组原来的问题是"各处显示的不是同一个东西"：
        · favicon.ico 声明成 sizes="any"，浏览器会**优先选它**（any 被当成可缩放、
          优先级最高），而它是深色底 —— 深色主题的标签栏上几乎看不见，
          又和标题栏用的白色图标对不上。
        · ico 本身还是坏的：33x32、单尺寸、BMP。宽度都不是 32。
        · 128 / 192 两张图导出了但**从来没有被引用过**。
        · 没有 manifest，安卓加到主屏只能拿到一个模糊的兜底图标。
        · apple-touch-icon 四角是透明的，iOS 会把透明角落填成黑色。
      现在：ico 改成多尺寸内嵌 PNG 并去掉 sizes="any"（让主题化的 PNG 优先），
      补齐 192 / manifest / maskable / Windows 磁贴。
    -->
    <link rel="icon" href="/favicon/favicon.ico" sizes="16x16 32x32 48x48" />
    <link
      rel="icon"
      type="image/png"
      href="/favicon/favicon-light-32.png"
      sizes="32x32"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      href="/favicon/favicon-dark-32.png"
      sizes="32x32"
      media="(prefers-color-scheme: dark)"
    />
    <!-- 安卓 / PWA：声明出来，否则并入主屏会用兜底图标 -->
    <link rel="icon" type="image/png" href="/favicon/favicon-light-192.png" sizes="192x192" />
    <link rel="icon" type="image/png" href="/favicon/favicon-dark-512.png" sizes="512x512" />
    <!-- 满幅不透明版：iOS 会自己加圆角遮罩，不能用带透明角落的图 -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Windows 开始菜单磁贴（本站主题就是 WinUI，顺手补上） -->
    <meta name="msapplication-TileColor" content="#1e212b" />
    <meta name="msapplication-TileImage" content="/favicon/maskable-192.png" />
    <meta name="theme-color" content="#1e212b" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <!--
      跳到主内容：键盘用户按一次 Tab 就能进入正文，
      不用逐个穿过导航里的每个链接（WCAG 2.4.1）。
      视觉上隐藏，聚焦时才显现。
    -->
    <a class="skip-link" href="#main">跳到主内容</a>

    <!--
      ★ 顶部加载条。

      为什么需要它：线上实测站内跳转取 HTML 要 65–736ms（延迟全在取 HTML 这一步，
      其余环节都在 20ms 内），而这段时间**页面上没有任何反馈** —— 点下去像没反应。
      加载条把"死等"变成"看得见在进行"。

      动效用的是 Google Material 的不确定进度条：两条滑块各自
      先伸长再缩短地扫过，比单纯左右来回更耐看，也是用户点名要的那种。

      transition:persist 让它跨页存活 —— 否则每次导航 body 一换，
      进度条就被重置成隐藏状态，等它重新出现时加载早就结束了。
      它只是个普通 div（不是 island），所以不会像外壳那样挡住 body 交换。
    -->
    <div id="nav-progress" class="nav-progress" transition:persist aria-hidden="true">
      <div class="nav-progress-bar"></div>
      <div class="nav-progress-bar nav-progress-bar--second"></div>
    </div>

    <!--
      ★ 把手动导航暴露给 WinUI 外壳。

      ClientRouter 只拦截 <a> 的点击，而 NavigationView 的菜单项渲染出来是
      <div role="menuitem">，命中不了 —— 所以外壳必须自己发起导航。

      为什么不直接在 Vue 组件里 import：`astro:transitions/client` 是 Astro 的
      **虚拟模块**，只有 Astro 处理的脚本能静态解析它。我在 Vue 里写成
      `await import(...)` 时运行时是 "Failed to fetch dynamically imported module"，
      写成静态 import 也拿不到可靠结果。放在这里最稳，也顺带避免了两套解析路径。

      兜底：脚本没跑起来时 Vue 那边会用 location.href，功能不受影响。
    -->
    <script>
      import { navigate } from "astro:transitions/client";

      (window as any).__winuiNavigate = (href: string) => navigate(href);

      /**
       * 预取。
       *
       * 线上实测：站内跳转的耗时**全在取 HTML**（65–736ms），
       * 交换与渲染合起来不到 20ms。也就是说"慢"是网络往返，不是我们算得慢。
       *
       * HTML 的缓存头是 `public,max-age=0,must-revalidate` —— 浏览器每次都要
       * 回源验证，所以预取不能把往返完全消掉，但能让导航那次拿到的是
       * 缓存里的副本（304 即可），省掉重新下载正文的那一段。
       * 鼠标移上菜单项时就开始取，等真点下去通常已经就绪。
       */
      const prefetched = new Set<string>();
      (window as any).__winuiPrefetch = (href: string) => {
        if (!href || prefetched.has(href)) return;
        prefetched.add(href);
        fetch(href, { credentials: "same-origin", priority: "low" } as RequestInit).catch(() =>
          prefetched.delete(href)
        );
      };

      /**
       * 顶部加载条。
       *
       * 注意它**不能**用 Astro 的导航事件之外的时机来显示：
       * 首次进入页面时浏览器有自己的加载指示，我们只在站内跳转时显示，
       * 否则会变成"永远在转"的噪音。
       *
       * 至少显示 MIN_VISIBLE 毫秒：网络快的时候（实测最快 65ms）
       * 如果按真实耗时闪一下，反而像抽搐 —— 这是进度条类组件的常规做法。
       */
      const bar = document.getElementById("nav-progress");
      const MIN_VISIBLE = 420;
      /** 安全上限：导航万一卡住/被取消，别让进度条永远转下去 */
      const MAX_VISIBLE = 8000;
      let shownAt = 0;
      let hideTimer = 0;
      let failSafeTimer = 0;

      const show = () => {
        if (!bar) return;
        clearTimeout(hideTimer);
        clearTimeout(failSafeTimer);
        shownAt = performance.now();
        bar.dataset.state = "loading";
        failSafeTimer = window.setTimeout(() => {
          bar.dataset.state = "done";
        }, MAX_VISIBLE);
      };

      const hide = () => {
        if (!bar) return;
        clearTimeout(failSafeTimer);
        const elapsed = performance.now() - shownAt;
        // 网络快的时候（实测最快 65ms）按真实耗时闪一下反而像抽搐，
        // 所以给一个最短展示时间 —— 进度条类组件的常规做法。
        hideTimer = window.setTimeout(
          () => {
            bar.dataset.state = "done";
          },
          Math.max(0, MIN_VISIBLE - elapsed)
        );
      };

      document.addEventListener("astro:before-preparation", show);
      document.addEventListener("astro:page-load", hide);
    </script>

    <!--
      WinUI 3 应用壳（TitleBar + NavigationView）。
      用 client:load 而不是 client:only：子内容会被 Astro 渲染成
      astro-slot 注入 island，<slot /> 拿到之后正文就是服务端渲染的
      静态 HTML，SEO 与 RSS 都不受影响。
      （WinUI 控件本身在客户端动态加载，见 WinShell.vue 的说明。）

      transition:persist 让这个 island 在站内跳转时**不重建**：
      侧边栏、搜索框、滚动位置都保持，只有 <slot/> 里的正文被换掉。
      不写它的话，每次导航外壳都会先消失再重新挂载 —— 那一下闪烁
      正是"不像原生应用"的主要来源。
    -->
    <WinShell
      client:load
      path={path}
      items={navItems}
      footerItems={footerItems}
      siteTitle={SITE.title}
      searchIndex={searchIndex}
    >
      <main id="main" class="page-main" tabindex="-1" transition:animate={pageTransition}>
        <slot />
      </main>
      <Footer />
    </WinShell>
  </body>
</html>

<style is:global>
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 var(--s-lg);
  }

  /*
   * 这里原来有一条 .page-main { min-height: 60dvh }。
   *
   * 它的本意是「文章详情页的短文章别显得空」，但挂在**通用容器**上，
   * 所有页面都吃到了。首页只留 hero 之后问题就暴露了：
   * 实测 hero 高 225px、而 #main 被撑到 540px（900 视口 × 60%），
