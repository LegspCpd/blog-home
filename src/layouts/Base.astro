---
import { SITE, abs } from "../config/site";
import { designVars } from "../styles/design";
import NavBar from "../components/win/NavBar.astro";
import Footer from "../components/win/Footer.astro";
import "../styles/global.css";

/**
 * 设计令牌内联进 HTML。
 * 这套值是纯静态的（不随主题切换变化），但仍然必须内联：
 * 否则首屏在 CSS 加载完成前会是一片白闪，
 * 禁用 CSS 时则彻底失去配色。
 */
const vars = designVars();

interface Props {
  title?: string;
  description?: string;
  /** 页面路径，用于 canonical；默认取当前 URL */
  path?: string;
  ogImage?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
}

const {
  title,
  description = SITE.description,
  path = Astro.url.pathname,
  ogImage,
  type = "website",
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} — ${SITE.subtitle}`;
const canonical = abs(path);

// JSON-LD：统一从 SITE 派生，杜绝手写域名出错。
// 文章页额外给 BlogPosting —— 少了它就没有作者信息与文章富媒体摘要。
const graph = [
  {
    "@type": "WebSite",
    "@id": `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.title,
    description: SITE.description,
    inLanguage: SITE.lang,
  },
  {
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: pageTitle,
    description,
    isPartOf: { "@id": `${SITE.url}/#website` },
    inLanguage: SITE.lang,
  },
];

if (type === "article" && publishedTime) {
  graph.push({
    "@type": "BlogPosting",
    "@id": `${canonical}#article`,
    url: canonical,
    headline: title ?? pageTitle,
    description,
    datePublished: publishedTime,
    ...(modifiedTime ? { dateModified: modifiedTime } : {}),
    inLanguage: SITE.lang,
    author: {
      "@type": "Person",
      name: SITE.author,
      url: SITE.url,
    },
    publisher: { "@id": `${SITE.url}/#website` },
    isPartOf: { "@id": `${canonical}#webpage` },
    ...(ogImage ? { image: [ogImage] } : {}),
    ...(tags.length ? { keywords: tags.join(", ") } : {}),
  });
}

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <style set:html={`:root{${vars}}`}></style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--
      Inter 自托管：不引Google Fonts 有两个理由——
      国内访问 Google 域名不稳定，而首屏字体是最不能闪的东西；
      顺带避免第三方请求拖慢 LCP。
      只取需要的字重与子集，全量 Inter 有 2MB+。
    -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- RSS：博客必备 -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} RSS`}
      href={abs("/rss.xml")}
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <!--
      跳到主内容：键盘用户按一次 Tab 就能进入正文，
      不用逐个穿过导航里的每个链接（WCAG 2.4.1）。
      视觉上隐藏，聚焦时才显现。
    -->
    <a class="skip-link" href="#main">跳到主内容</a>

    <NavBar />
    <main id="main" class="page-main" tabindex="-1">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 var(--s-lg);
  }

  /* 文章页正文：窄栏 + 大行高，长文才读得下去。
     这是 Cursor 的「杂志感」在博客上的落地。 */
  .page-main {
    min-height: 60dvh;
  }

  .prose {
    max-width: 680px;
    margin: 0 auto;
    font-size: 16.5px;
    line-height: 1.85;
    color: var(--c-body);
  }

  .prose > * + * {
    margin-top: 1.25em;
  }

  .prose h2 {
    margin-top: 2.4em;
    font-size: 26px;
    letter-spacing: -0.8px;
  }

  .prose h3 {
    margin-top: 2em;
    font-size: 20px;
    letter-spacing: -0.4px;
  }

  .prose a {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--c-neon-volt) 45%, transparent);
    text-decoration-thickness: 1px;
  }

  .prose a:hover {
    text-decoration-color: var(--c-neon-volt);
  }

  /* 代码块：VoltAgent 的内嵌深色面板 + 发丝边框 */
  .prose pre {
    overflow-x: auto;
    padding: var(--s-md) var(--s-lg);
    border: 1px solid var(--line-base);
    border-radius: var(--r-md);
    background: var(--c-inset);
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.72;
    color: var(--c-body);
  }

  .prose :not(pre) > code {
    padding: 2px 6px;
    border: 1px solid var(--line-soft);
    border-radius: var(--r-xs);
    background: var(--c-inset);
    color: var(--c-neon-mint);
  }

  .prose blockquote {
    margin-left: 0;
    padding: 2px 0 2px var(--s-lg);
    border-left: 2px solid var(--c-neon-volt);
    color: var(--c-muted);
    font-style: normal;
  }

  .prose img {
    max-width: 100%;
    border-radius: var(--r-md);
    border: 1px solid var(--line-base);
  }

  .prose hr {
    height: 1px;
    margin: 3em 0;
    border: 0;
    background: var(--line-base);
  }

  .prose ul,
  .prose ol {
    padding-left: 1.4em;
  }

  .prose li + li {
    margin-top: 0.4em;
  }

  .prose li::marker {
    color: var(--c-neon-volt);
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .prose th,
  .prose td {
    padding: 9px 12px;
    border: 1px solid var(--line-base);
    text-align: left;
  }

  .prose th {
    background: var(--c-s1);
    color: var(--c-ink);
    font-weight: 600;
  }
</style>