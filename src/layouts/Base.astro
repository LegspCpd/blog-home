---
import { SITE, NAV, abs } from "../config/site";
import { designVars } from "../styles/design";
import { getSearchIndex } from "../lib/search";
import Footer from "../components/win/Footer.astro";
import WinShell from "../components/win/WinShell.vue";
import "../styles/global.css";

/**
 * 导航数据交给 Vue 外壳。
 *
 * 图标用 Segoe Fluent Icons 的字形码 —— 上游 NavigationView 直接吃字符串。
 * 注意：该字体**不可随网站分发**（上游 docs/icon-font.md 有说明），
 * 只能依赖 Windows 系统已安装的那一份。Windows 之外的平台字形会缺失，
 * 这是整个 WinUIonWeb 的既有约束，不是本项目引入的。
 */
const navItems = NAV.map((item, i) => ({
  Tag: item.href,
  Content: item.label,
  Icon: ["\uE80F", "\uE8F1", "\uE8EC"][i] ?? "\uE8A5",
}));

/** 页脚项：官方规范里 FooterMenuItems 显示在「设置」项之前 */
const footerItems = [
  { Tag: SITE.links.rss, Content: "RSS" },
  { Tag: SITE.links.github, Content: "GitHub" },
];

/** 构建期生成的站内搜索索引，供标题栏的 AutoSuggestBox 使用 */
const searchIndex = await getSearchIndex();

/**
 * 设计令牌内联进 HTML。
 * 这套值是纯静态的（不随主题切换变化），但仍然必须内联：
 * 否则首屏在 CSS 加载完成前会是一片白闪，
 * 禁用 CSS 时则彻底失去配色。
 */
const vars = designVars();

interface Props {
  title?: string;
  description?: string;
  /** 页面路径，用于 canonical；默认取当前 URL */
  path?: string;
  ogImage?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
}

const {
  title,
  description = SITE.description,
  path = Astro.url.pathname,
  ogImage,
  type = "website",
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} — ${SITE.subtitle}`;
const canonical = abs(path);

// JSON-LD：统一从 SITE 派生，杜绝手写域名出错。
// 文章页额外给 BlogPosting —— 少了它就没有作者信息与文章富媒体摘要。
// 显式标注元素类型：否则 TS 会按前两个字面量收窄，
// 后面 push 带 author/publisher 的 BlogPosting 会报 2353。
const graph: Record<string, unknown>[] = [
  {
    "@type": "WebSite",
    "@id": `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.title,
    description: SITE.description,
    inLanguage: SITE.lang,
  },
  {
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: pageTitle,
    description,
    isPartOf: { "@id": `${SITE.url}/#website` },
    inLanguage: SITE.lang,
  },
];

if (type === "article" && publishedTime) {
  graph.push({
    "@type": "BlogPosting",
    "@id": `${canonical}#article`,
    url: canonical,
    headline: title ?? pageTitle,
    description,
    datePublished: publishedTime,
    ...(modifiedTime ? { dateModified: modifiedTime } : {}),
    inLanguage: SITE.lang,
    author: {
      "@type": "Person",
      name: SITE.author,
      url: SITE.url,
    },
    publisher: { "@id": `${SITE.url}/#website` },
    isPartOf: { "@id": `${canonical}#webpage` },
    ...(ogImage ? { image: [ogImage] } : {}),
    ...(tags.length ? { keywords: tags.join(", ") } : {}),
  });
}

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<!--
  html 上必须显式带 theme-dark。
  WinUIonWeb 的 theme.css 把浅色令牌定义在 `:root`，深色定义在 `.theme-dark`。
  不声明主题类时是**混合状态**：--app-bg 有 `:root:not(.theme-light)` 的深色兜底，
  但 --text-primary / ControlStroke 等仍是浅色值 ——
  实测表现为窗格里的搜索框是黑字黑边，在深色底上完全看不清。
-->
<html lang={SITE.lang} class="theme-dark">
  <head>
    <meta charset="UTF-8" />
    <style set:html={`:root{${vars}}`}></style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--
      字体：**不再自托管任何 webfont**。
      --sans 换成 WinUI 的字体栈（Segoe UI Variable / Segoe UI）之后，
      Inter 已经没有任何地方在用，但这里原来仍每页 preload 一个 48KB 的 woff2
      —— 白付一次首屏往返，还拖慢 LCP。
      Segoe UI Variable 在 Windows 上是系统字体（零下载），
      其它平台按 --sans 的回落链走各自的系统 UI 字体；
      代码字体用 Cascadia Mono / Consolas，同样是系统字体。
    -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- RSS：博客必备 -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} RSS`}
      href={abs("/rss.xml")}
    />
    <!--
      图标。注意路径是 /favicon/favicon.ico ——
      这里原来写的是 /favicon.ico，全站 54 个页面每次访问都在请求一个不存在的文件。
      深浅两套分开声明，跟随系统主题。
    -->
    <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
    <link
      rel="icon"
      type="image/png"
      href="/favicon/favicon-light-32.png"
      sizes="32x32"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      href="/favicon/favicon-dark-32.png"
      sizes="32x32"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="apple-touch-icon" href="/favicon/favicon-dark-180.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <!--
      跳到主内容：键盘用户按一次 Tab 就能进入正文，
      不用逐个穿过导航里的每个链接（WCAG 2.4.1）。
      视觉上隐藏，聚焦时才显现。
    -->
    <a class="skip-link" href="#main">跳到主内容</a>

    <!--
      WinUI 3 应用壳（TitleBar + NavigationView）。
      用 client:load 而不是 client:only：子内容会被 Astro 渲染成
      astro-slot 注入 island，<slot /> 拿到之后正文就是服务端渲染的
      静态 HTML，SEO 与 RSS 都不受影响。
      （WinUI 控件本身在客户端动态加载，见 WinShell.vue 的说明。）
    -->
    <WinShell
      client:load
      path={path}
      items={navItems}
      footerItems={footerItems}
      siteTitle={SITE.title}
      searchIndex={searchIndex}
    >
      <main id="main" class="page-main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </WinShell>
  </body>
</html>

<style is:global>
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 var(--s-lg);
  }

  /* 文章页正文：窄栏 + 大行高，长文才读得下去。
     这是 Cursor 的「杂志感」在博客上的落地。 */
  .page-main {
    min-height: 60dvh;
  }

  .prose {
    max-width: 680px;
    margin: 0 auto;
    font-size: 16.5px;
    line-height: 1.85;
    color: var(--c-body);
  }

  .prose > * + * {
    margin-top: 1.25em;
  }

  .prose h2 {
    margin-top: 2.4em;
    font-size: 26px;
    letter-spacing: -0.8px;
  }

  .prose h3 {
    margin-top: 2em;
    font-size: 20px;
    letter-spacing: -0.4px;
  }

  .prose a {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--c-neon-volt) 45%, transparent);
    text-decoration-thickness: 1px;
  }

  .prose a:hover {
    text-decoration-color: var(--c-neon-volt);
  }

  /* 代码块：VoltAgent 的内嵌深色面板 + 发丝边框 */
  .prose pre {
    overflow-x: auto;
    padding: var(--s-md) var(--s-lg);
    border: 1px solid var(--line-base);
    border-radius: var(--r-md);
    background: var(--c-inset);
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.72;
    color: var(--c-body);
  }

  .prose :not(pre) > code {
    padding: 2px 6px;
    border: 1px solid var(--line-soft);
    border-radius: var(--r-xs);
    background: var(--c-inset);
    color: var(--c-neon-mint);
  }

  .prose blockquote {
    margin-left: 0;
    padding: 2px 0 2px var(--s-lg);
    border-left: 2px solid var(--c-neon-volt);
    color: var(--c-muted);
    font-style: normal;
  }

  .prose img {
    max-width: 100%;
    border-radius: var(--r-md);
    border: 1px solid var(--line-base);
  }

  .prose hr {
    height: 1px;
    margin: 3em 0;
    border: 0;
    background: var(--line-base);
  }

  .prose ul,
  .prose ol {
    padding-left: 1.4em;
  }

  .prose li + li {
    margin-top: 0.4em;
  }

  .prose li::marker {
    color: var(--c-neon-volt);
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .prose th,
  .prose td {
    padding: 9px 12px;
    border: 1px solid var(--line-base);
    text-align: left;
  }

  .prose th {
    background: var(--c-s1);
    color: var(--c-ink);
    font-weight: 600;
  }
</style>