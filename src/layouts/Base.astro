---
import { SITE, abs } from "../config/site";
import { DEFAULT_THEME, themes } from "../lib/theme/tokens";
import NavBar from "../components/win/NavBar.astro";
import Footer from "../components/win/Footer.astro";
import "../styles/global.css";

/**
 * 首屏令牌内联：把默认主题（暗色）直接吐进 HTML。
 *
 * 为什么必须这么做：令牌由 setTheme() 在客户端注入，如果只靠 JS，
 * 那么 SSR 出来的 HTML 里 --colorNeutralBackground1 等变量【不存在】——
 * 页面会闪一下白底，JS 失败或禁用 JS 时更是彻底失去配色。
 * 内联一份默认值，首屏即正确；运行时 setTheme() 接管同一套值，不会漂移
 * （两者同源于 tokens.ts，不存在「CSS 覆盖算法」的冲突）。
 */
const bootstrapTokens = Object.entries(themes[DEFAULT_THEME])
  .map(([k, v]) => `${k}:${v}`)
  .join(";");

interface Props {
  title?: string;
  description?: string;
  /** 页面路径，用于 canonical；默认取当前 URL */
  path?: string;
  ogImage?: string;
  type?: "website" | "article";
  publishedTime?: string;
}

const {
  title,
  description = SITE.description,
  path = Astro.url.pathname,
  ogImage,
  type = "website",
  publishedTime,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} — ${SITE.subtitle}`;
const canonical = abs(path);

// JSON-LD：WebSite + WebPage，统一从 SITE 派生，杜绝手写域名出错
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
      inLanguage: SITE.lang,
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: pageTitle,
      description,
      isPartOf: { "@id": `${SITE.url}/#website` },
      inLanguage: SITE.lang,
    },
  ],
};
---

<!doctype html>
<html lang={SITE.lang} data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="UTF-8" />
    <style set:html={`:root{${bootstrapTokens}}`}></style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- RSS：博客必备 -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} RSS`}
      href={abs("/rss.xml")}
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!--
      防闪烁：主题脚本在渲染前同步执行首屏取色。
      默认暗色优先 —— 没有本地偏好就直接暗色。
    -->
    <script is:inline define:vars={{ storageKey: "winui-theme", fallback: DEFAULT_THEME }}>
      (function () {
        try {
          var saved = localStorage.getItem(storageKey);
          var t =
            saved === "dark" || saved === "light"
              ? saved
              : fallback;
          document.documentElement.setAttribute("data-theme", t);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", fallback);
        }
      })();
    </script>
  </head>

  <body>
    <NavBar />
    <main class="page-main">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />

    <script>
      import "../lib/theme/theme";
    </script>
  </body>
</html>